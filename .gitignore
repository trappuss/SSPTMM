# Build output
bin/
# Scripts from before there were just the two (SSPTMM-build-and-run.bat, which runs from a copy of
# itself in %TEMP% so it can update the folder it is in, and SSPTMM-upload-to-github.bat), if any
# copy of them is still lying around. (steam-ui-*: their names before the app was SSPTMM.)
SSPTMM-update-and-run.bat
SSPTMM-push-to-github.bat
SSPTMM-github-setup.bat
steam-ui-rebuild-and-run.bat
steam-ui-push-to-github.bat
# Your own copy of a file an update brought in, kept when it differed
*.before-update
*.update-copy
# What the .bat files write about each run
logs/
# What Claude hands over (bundles, staged files), and shortcuts made beside the repo
Claude outputs/
*.bundle
# Claude's own working folders
.claude/
# Your own source art for the icon and mascot (the generated files are in build/branding and docs/images)
/branding/
*.lnk
# The upload script's working files (the release zip)
release/
# The .NET SDK SSPTMM-build-and-run.bat installs locally when a PC has none
.dotnet/
obj/
dist/
publish/
*_wpftmp.csproj
*design.md

# IDE / editor
.vs/
.idea/
.vscode/
*.user
*.suo
*.rsuser
*.sln.docstates
*.sln.DotSettings.user

# docs
release-notes*.md
*design.md
*followups*.md


# Test output
TestResults/
*.coverage
coverage*.json
coverage*.xml

# PowerShell tooling stays local - except the test checklist, which is part of releasing
*.ps1
!tools/ssptmm-test-checklist.ps1

# Machine-specific build config only
build/Directory.Build.local.props

# App runtime data written next to the exe when running from source
Data/
downloads/
*.log

# Holding area for dead files
_to_delete/

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# The pseudo-locale is generated on demand (-p:PseudoLocale=true), never committed
Strings.qps-ploc.resx
