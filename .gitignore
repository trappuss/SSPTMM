# Build output
bin/
# Update-and-run script Claude hands over beside the repo rather than in it: it moves the branch,
# and a script that git itself might replace mid-run would be cut off halfway. The push and
# release scripts live beside it. (steam-ui-*: their names before the app was SSPTMM.)
SSPTMM-update-and-run.bat
SSPTMM-push-to-github.bat
SSPTMM-release-to-github.bat
steam-ui-rebuild-and-run.bat
steam-ui-push-to-github.bat
# What the .bat files write about each run
logs/
# What Claude hands over (bundles, staged files), and shortcuts made beside the repo
Claude outputs/
*.lnk
# The release script's working files
release/
# The .NET SDK SSPTMM-build-and-run.bat installs locally when a PC has none
.dotnet/
obj/
dist/
publish/
*_wpftmp.csproj
*design.md

# IDE / editor
.vs/
.idea/
.vscode/
*.user
*.suo
*.rsuser
*.sln.docstates
*.sln.DotSettings.user

# docs
release-notes*.md
*design.md
*followups*.md


# Test output
TestResults/
*.coverage
coverage*.json
coverage*.xml

# PowerShell tooling stays local
*.ps1

# Machine-specific build config only
build/Directory.Build.local.props

# App runtime data written next to the exe when running from source
Data/
downloads/
*.log

# Holding area for dead files
_to_delete/

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# The pseudo-locale is generated on demand (-p:PseudoLocale=true), never committed
Strings.qps-ploc.resx
