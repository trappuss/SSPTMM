<Page
    x:Class="TCFModManager.App.Views.OptionsPage"
    Loaded="Page_Loaded"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:views="clr-namespace:TCFModManager.App.Views"
    Title="{loc:Str Nav_Options}">
    <!--
        Laid out like Windows Settings: a heading per section, one row per setting with its name and
        a one-line hint on the left and the control on the right. A setting with more than one part is
        a CardExpander whose header still carries the main control, so the page reads complete with
        every expander closed. The longer explanation of each setting is the row's tooltip.

        Fork (SSPTMM, UI tidy-up 3): every hint is one line, and a "?" at its end (InfoTip) holds
        the longer explanation - so it can be found without knowing to hover the row. Several
        fork-added rows had put the whole explanation in the hint; those now have a short one.
    -->
    <Page.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:InverseBooleanConverter x:Key="Inverse" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,20,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="SettingNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="SettingRow" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>

        <Style x:Key="SettingExpander" TargetType="ui:CardExpander" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- The switch sits at the left of a fixed-width box, so On and Off don't move it. -->
        <Style x:Key="RowSwitch" TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            <Setter Property="OnContent" Value="{loc:Str Common_On}" />
            <Setter Property="OffContent" Value="{loc:Str Common_Off}" />
        </Style>

        <!-- A part inside an expander: separated from the one above by a divider. -->
        <Style x:Key="SubSetting" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="0,12,0,12" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="24,8,24,16">

        <!-- ─── General ─── -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str Options_SectionGeneral}" Margin="2,4,0,8" />

        <ui:CardControl
            Style="{StaticResource SettingRow}"
            Icon="{ui:SymbolIcon Folder24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <StackPanel ToolTip="{loc:Str Options_InstallFolderDescription}" ToolTipService.ShowDuration="30000">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_InstallFolderHeader}" />
                        <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_InstallFolderHint}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_InstallFolderDescription}" /></InlineUIContainer></TextBlock>
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Grid.Column="0"
                            Text="{Binding InstallPathInput, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Content="{loc:Str Options_Browse}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Command="{Binding BrowseCommand}" />
                        <ui:Button
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Content="{loc:Str Common_Save}"
                            Command="{Binding SaveCommand}" />
                    </Grid>

                    <TextBlock
                        Style="{StaticResource SettingHint}"
                        Margin="0,6,0,0"
                        Text="{Binding SptEnvironment.StatusMessage}" />
                </StackPanel>
            </ui:CardControl.Header>
        </ui:CardControl>

        <ui:CardControl
            Style="{StaticResource SettingRow}"
            Icon="{ui:SymbolIcon LocalLanguage24}"
            ToolTip="{loc:Str Options_Language_Description}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_Language_Header}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_LanguageHint}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_Language_Description}" /></InlineUIContainer></TextBlock>
                    <!-- Collapsed while the credit is empty, which is English. -->
                    <TextBlock
                        Style="{StaticResource SettingNote}"
                        Margin="0,4,0,0"
                        Text="{Binding TranslationCredit}"
                        Visibility="{Binding TranslationCredit, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                DisplayMemberPath="Label"
                ItemsSource="{Binding LanguageOptions}"
                SelectedItem="{Binding SelectedLanguage}" />
        </ui:CardControl>

        <!-- Hidden in the Steam Workshop fork: Steam has one look, so there is no light theme to
             choose (see AppTheme.ApplyOnly). Left in place rather than deleted, so the setting it
             edits is untouched and the upstream app finds it where it was left. -->
        <ui:CardControl
            Style="{StaticResource SettingRow}"
            Icon="{ui:SymbolIcon DarkTheme24}"
            Visibility="Collapsed"
            ToolTip="{loc:Str Options_AppearanceDescription}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_AppearanceHeader}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_AppearanceHint}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_AppearanceDescription}" /></InlineUIContainer></TextBlock>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                ItemsSource="{Binding ThemeOptions}"
                SelectedItem="{Binding SelectedTheme}" />
        </ui:CardControl>

        <ui:CardControl
            Style="{StaticResource SettingRow}"
            Icon="{ui:SymbolIcon Window24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <StackPanel ToolTip="{loc:Str Options_WindowDescription}" ToolTipService.ShowDuration="30000">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_WindowHeader}" />
                        <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_WindowHint}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_WindowDescription}" /></InlineUIContainer></TextBlock>
                    </StackPanel>

                    <!-- Only for the one mode that reads them. -->
                    <WrapPanel
                        Margin="0,10,0,0"
                        Visibility="{Binding ShowCustomSize, Converter={StaticResource BoolToVisibility}}">
                        <ui:TextBox
                            MinWidth="110"
                            Margin="0,0,0,4"
                            PlaceholderText="{loc:Str Options_WidthPlaceholder}"
                            Text="{Binding CustomWidthInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="8,0,8,4"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{loc:Str Options_SizeBy}" />
                        <ui:TextBox
                            MinWidth="110"
                            Margin="0,0,0,4"
                            PlaceholderText="{loc:Str Options_HeightPlaceholder}"
                            Text="{Binding CustomHeightInput, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Margin="8,0,0,4"
                            Content="{loc:Str Options_ApplySize}"
                            Command="{Binding ApplyWindowSizeCommand}" />
                        <ui:Button
                            Margin="8,0,0,4"
                            Content="{loc:Str Options_UseCurrentSize}"
                            ToolTip="{loc:Str Options_UseCurrentSizeToolTip}"
                            Command="{Binding UseCurrentWindowSizeCommand}" />
                    </WrapPanel>

                    <TextBlock
                        Style="{StaticResource SettingNote}"
                        Margin="0,4,0,0"
                        Text="{Binding WindowSizeMessage}"
                        Visibility="{Binding WindowSizeMessage, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                VerticalAlignment="Top"
                ItemsSource="{Binding WindowStartupOptions}"
                SelectedItem="{Binding SelectedWindowStartup}" />
        </ui:CardControl>

        <!-- Fork: Start server can bring the launcher up after it, and keep its own window out of the way. -->
        <ui:CardExpander
            Style="{StaticResource SettingExpander}"
            Icon="{ui:SymbolIcon Play24}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_LaunchHeader}" />
                        <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_LaunchSummary}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_LaunchDescription}" /></InlineUIContainer></TextBlock>
                        <TextBlock
                            Style="{StaticResource SettingHint}"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{loc:Str Options_LaunchReplacedByDirect}"
                            Visibility="{Binding DirectLaunchReplacesLauncher, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ui:ToggleSwitch
                        Grid.Column="1"
                        Margin="14,0,12,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource RowSwitch}"
                        IsEnabled="{Binding DirectLaunchReplacesLauncher, Converter={StaticResource Inverse}}"
                        IsChecked="{Binding StartLauncherAfterServer}" />
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel>
                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    IsChecked="{Binding HideServerWindow}"
                    OnContent="{loc:Str Options_HideServerOn}"
                    OffContent="{loc:Str Options_HideServerOff}" />
                <TextBlock
                    Style="{StaticResource SettingNote}"
                    Margin="0,6,0,0"
                    Text="{loc:Str Options_HideServerNote}" />
            </StackPanel>
        </ui:CardExpander>

        <!-- Fork (experimental): Play starts the game itself instead of opening SPT's launcher
             (SptDirectLaunch). Warned about on the card, and off unless switched on. -->
        <ui:CardExpander
            Style="{StaticResource SettingExpander}"
            Icon="{ui:SymbolIcon Rocket24}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_DirectLaunchHeader}" />
                            <Border
                                Margin="8,0,0,0"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                CornerRadius="3"
                                Background="{DynamicResource SystemFillColorCautionBrush}"
                                ToolTip="{loc:Str Options_DirectLaunchExperimentalToolTip}">
                                <TextBlock Text="{loc:Str Common_Experimental}" FontSize="10" FontWeight="SemiBold" Foreground="#171A21" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_DirectLaunchSummary}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_DirectLaunchDescription}" /></InlineUIContainer></TextBlock>
                    </StackPanel>
                    <ui:ToggleSwitch
                        Grid.Column="1"
                        Margin="14,0,12,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource RowSwitch}"
                        IsChecked="{Binding DirectLaunch}" />
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel>
                <ui:InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Warning"
                    Title="{loc:Str Options_DirectLaunchWarningTitle}"
                    Message="{loc:Str Options_DirectLaunchWarning}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding DirectLaunchSupportText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SettingNote}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DirectLaunchSupportIsCaution}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ui:ToggleSwitch
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding DirectLaunch}"
                    IsChecked="{Binding MinimizeWhilePlaying}"
                    OnContent="{loc:Str Options_MinimizeWhilePlayingOn}"
                    OffContent="{loc:Str Options_MinimizeWhilePlayingOff}" />
            </StackPanel>
        </ui:CardExpander>

        <!-- Fork: the hub's own Subscribed items and Collections tabs, and a picture of your own
             behind the window in place of the Steam grid. -->
        <ui:CardExpander
            Style="{StaticResource SettingExpander}"
            Icon="{ui:SymbolIcon Image24}">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_TabsBackgroundHeader}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_TabsBackgroundSummary}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_TabsBackgroundDescription}" /></InlineUIContainer></TextBlock>
                </StackPanel>
            </ui:CardExpander.Header>

            <StackPanel>
                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    IsChecked="{Binding ShowSubscribedItemsTab}"
                    OnContent="{loc:Str Options_SubscribedTabOn}"
                    OffContent="{loc:Str Options_SubscribedTabOff}" />
                <ui:ToggleSwitch
                    Margin="0,8,0,12"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding ShowCollectionsTab}"
                    OnContent="{loc:Str Options_CollectionsTabOn}"
                    OffContent="{loc:Str Options_CollectionsTabOff}" />

                <Border Style="{StaticResource SubSetting}" Padding="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding ChooseBackgroundCommand}" Content="{loc:Str Options_BackgroundChoose}" />
                            <Button Margin="8,0,0,0" Command="{Binding UseGridBackgroundCommand}" Content="{loc:Str Options_BackgroundUseGrid}" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource SettingHint}"
                            Margin="0,8,0,0"
                            Text="{Binding BackgroundFileName, StringFormat={loc:Str Options_BackgroundCurrentFormat}}"
                            Visibility="{Binding BackgroundFileName, Converter={StaticResource NullToCollapsed}}" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock VerticalAlignment="Center" Text="{loc:Str Options_BackgroundDarkness}" />
                            <Slider
                                Width="220"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Maximum="0.9"
                                Minimum="0"
                                SmallChange="0.05"
                                LargeChange="0.1"
                                Value="{Binding BackgroundDarkness, Delay=250}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{Binding BackgroundStatus}"
                            Visibility="{Binding BackgroundStatus, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ui:CardExpander>

        <!-- Fork: whether the mouse wheel glides the page or jumps it. -->
        <ui:CardControl
            Style="{StaticResource SettingRow}"
            Icon="{ui:SymbolIcon ArrowSortDown24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_ScrollingHeader}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_ScrollingSummary}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_ScrollingDescription}" /></InlineUIContainer></TextBlock>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch Style="{StaticResource RowSwitch}" IsChecked="{Binding SmoothScrolling}" />
        </ui:CardControl>

        <!-- ─── Installing mods ─── -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str Options_SectionInstalling}" />

        <!--
            Monitor mode. The dropdown decides what every install button does; the small button
            beside each one does the other thing for a single mod. The download folder applies to any
            download-only save, whichever button started it, so it lives in here in either mode.
        -->
        <ui:CardExpander
            Style="{StaticResource SettingExpander}"
            Icon="{ui:SymbolIcon ArrowDownload24}">
            <ui:CardExpander.Header>
                <Grid ToolTip="{loc:Str Options_MonitorDescription}" ToolTipService.ShowDuration="30000">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_InstallModeHeader}" />
                        <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_InstallModeSummary}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_MonitorDescription}" /></InlineUIContainer></TextBlock>
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="200"
                        Margin="14,0,12,0"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding InstallModeOptions}"
                        SelectedItem="{Binding SelectedInstallMode}" />
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock
                        Style="{StaticResource SettingTitle}"
                        Text="{loc:Str Options_MonitorFolderHeader}"
                        ToolTip="{loc:Str Options_MonitorFolderDescription}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_MonitorFolderHint}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_MonitorFolderDescription}" /></InlineUIContainer></TextBlock>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Grid.Column="0"
                            PlaceholderText="{Binding DownloadFolderPlaceholder}"
                            Text="{Binding DownloadFolderInput, UpdateSourceTrigger=LostFocus}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Content="{loc:Str Options_Browse}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Command="{Binding BrowseDownloadFolderCommand}" />
                        <ui:Button
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Appearance="Transparent"
                            Content="{loc:Str Options_MonitorFolderReset}"
                            ToolTip="{loc:Str Options_MonitorFolderResetToolTip}"
                            Command="{Binding ResetDownloadFolderCommand}" />
                    </Grid>
                    <ui:ToggleSwitch
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        IsChecked="{Binding DownloadListSubfolders}"
                        OnContent="{loc:Str Options_MonitorListSubfoldersOn}"
                        OffContent="{loc:Str Options_MonitorListSubfoldersOff}" />
                </StackPanel>

                <Border Style="{StaticResource SubSetting}" Padding="0,12,0,0">
                    <Grid ToolTip="{loc:Str Options_MonitorConfirmDescription}" ToolTipService.ShowDuration="30000">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_MonitorConfirmHeader}" />
                            <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_MonitorConfirmHint}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_MonitorConfirmDescription}" /></InlineUIContainer></TextBlock>
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="200"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding DownloadConfirmationOptions}"
                            SelectedItem="{Binding SelectedDownloadConfirmation}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardControl
            Style="{StaticResource SettingRow}"
            Icon="{ui:SymbolIcon Open24}"
            ToolTip="{loc:Str Options_ModPagesDescription}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_ModPagesTitle}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_ModPagesHint}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_ModPagesDescription}" /></InlineUIContainer></TextBlock>
                </StackPanel>
            </ui:CardControl.Header>
            <!-- On = ask first, so it writes the opposite of SkipModPageConfirmation. -->
            <ui:ToggleSwitch
                Style="{StaticResource RowSwitch}"
                ToolTip="{Binding ModPageGate.SettingToolTip}"
                IsChecked="{Binding SkipModPageConfirmation, Converter={StaticResource Inverse}}" />
        </ui:CardControl>

        <!-- How long removed mods are kept in the install's holding folder (R11, D27). -->
        <ui:CardControl
            Style="{StaticResource SettingRow}"
            Icon="{ui:SymbolIcon Delete24}"
            ToolTip="{loc:Str Options_RemovedModsDescription}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_RemovedModsHeader}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_RemovedModsSummary}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_RemovedModsDescription}" /></InlineUIContainer></TextBlock>
                    <TextBlock
                        Style="{StaticResource SettingHint}"
                        Text="{Binding RemovedModsStatus}"
                        Visibility="{Binding RemovedModsStatus, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{Binding RemovedModsRetentionOptions}"
                    SelectedItem="{Binding SelectedRemovedModsRetention}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Content="{Binding ClearRemovedModsLabel}"
                    Command="{Binding ClearRemovedModsCommand}" />
            </StackPanel>
        </ui:CardControl>

        <!-- Fork: several downloads at once, and whether downloaded files are kept for next time. -->
        <ui:CardControl
            Style="{StaticResource SettingRow}"
            Icon="{ui:SymbolIcon Archive24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_DownloadsHeader}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_DownloadsSummary}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_DownloadsDescription}" /></InlineUIContainer></TextBlock>
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <ui:Button Content="{loc:Str Options_DownloadsClear}" Command="{Binding ClearKeptDownloadsCommand}" />
                        <TextBlock
                            Style="{StaticResource SettingNote}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding KeptDownloadsLabel}" />
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch
                Style="{StaticResource RowSwitch}"
                VerticalAlignment="Top"
                IsChecked="{Binding KeepDownloads}" />
        </ui:CardControl>

        <!-- Fork: whether removing an item asks first; the question's "Don't ask again" turns this off. -->
        <ui:CardControl
            Style="{StaticResource SettingRow}"
            Icon="{ui:SymbolIcon DismissCircle24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_UnsubscribeHeader}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_UnsubscribeSummary}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_UnsubscribeDescription}" /></InlineUIContainer></TextBlock>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch Style="{StaticResource RowSwitch}" IsChecked="{Binding ConfirmUnsubscribe}" />
        </ui:CardControl>

        <!-- ─── Updates ─── -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str Options_SectionUpdates}" />

        <!-- Apart from Monitor mode (R3): it works the same whichever mode the install buttons are in. -->
        <ui:CardExpander
            Style="{StaticResource SettingExpander}"
            Icon="{ui:SymbolIcon Alert24}">
            <ui:CardExpander.Header>
                <Grid ToolTip="{loc:Str Options_UpdateNotificationsDescription}" ToolTipService.ShowDuration="30000">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_UpdateNotificationsHeader}" />
                        <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_UpdateNotificationsHint}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_UpdateNotificationsDescription}" /></InlineUIContainer></TextBlock>
                    </StackPanel>
                    <ui:ToggleSwitch
                        Grid.Column="1"
                        Margin="14,0,12,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource RowSwitch}"
                        IsChecked="{Binding UpdateNotificationsEnabled}" />
                </Grid>
            </ui:CardExpander.Header>

            <!-- Greyed out rather than hidden while notifications are off (D8), so what switching them
                 on would do is readable first. -->
            <StackPanel>
                <ui:ToggleSwitch
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding UpdateNotificationsEnabled}"
                    ToolTip="{loc:Str Options_TrayToolTip}"
                    ToolTipService.ShowDuration="20000"
                    IsChecked="{Binding KeepRunningInTray}"
                    OnContent="{loc:Str Options_TrayOn}"
                    OffContent="{loc:Str Options_TrayOff}" />

                <Border Style="{StaticResource SubSetting}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Style="{StaticResource SettingTitle}"
                                VerticalAlignment="Center"
                                Text="{loc:Str Options_UpdateIntervalHeader}" />
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="160"
                                Margin="14,0,0,0"
                                IsEnabled="{Binding UpdateNotificationsEnabled}"
                                ItemsSource="{Binding UpdateIntervalOptions}"
                                SelectedItem="{Binding SelectedUpdateInterval}" />
                            <!-- Greyed while notifications are off, through the command's CanExecute. -->
                            <ui:Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Content="{loc:Str Options_UpdateCheckNow}"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                ToolTip="{loc:Str Options_UpdateCheckNowToolTip}"
                                ToolTipService.ShowDuration="20000"
                                Command="{Binding CheckUpdatesNowCommand}" />
                        </Grid>

                        <TextBlock
                            Style="{StaticResource SettingHint}"
                            Margin="0,8,0,0"
                            Text="{Binding UpdateCheckStatus}"
                            Visibility="{Binding UpdateCheckStatus, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Style="{StaticResource SettingNote}"
                    Text="{loc:Str Options_UpdateNotificationsNote}" />
            </StackPanel>
        </ui:CardExpander>

        <!-- ─── Pages ─── -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str Options_SectionPages}" />

        <ui:CardControl
            Style="{StaticResource SettingRow}"
            Icon="{ui:SymbolIcon DataUsage24}"
            ToolTip="{loc:Str Options_FootprintDescription}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_FootprintHeader}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_FootprintHint}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_FootprintDescription}" /></InlineUIContainer></TextBlock>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch
                Style="{StaticResource RowSwitch}"
                ToolTip="{Binding FootprintGate.SettingToolTip}"
                IsChecked="{Binding ShowModFootprintPage}" />
        </ui:CardControl>

        <ui:CardControl
            Style="{StaticResource SettingRow}"
            Icon="{ui:SymbolIcon Server24}"
            ToolTip="{loc:Str Options_ServerMapDescription}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_ServerMapHeader}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_ServerMapPageHint}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_ServerMapDescription}" /></InlineUIContainer></TextBlock>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch
                Style="{StaticResource RowSwitch}"
                ToolTip="{Binding ServerMap.SettingToolTip}"
                IsChecked="{Binding ServerMap.IsPageEnabled}" />
        </ui:CardControl>

        <ui:CardExpander
            Style="{StaticResource SettingExpander}"
            Icon="{ui:SymbolIcon Filter24}">
            <ui:CardExpander.Header>
                <StackPanel ToolTip="{loc:Str Options_PageDefaultsDescription}" ToolTipService.ShowDuration="30000">
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_PageDefaultsHeader}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_PageDefaultsHint}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_PageDefaultsDescription}" /></InlineUIContainer></TextBlock>
                </StackPanel>
            </ui:CardExpander.Header>

            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource SettingHint}"
                        VerticalAlignment="Center"
                        Text="{Binding InstalledDefaultsDescription}" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="14,0,0,0"
                        Content="{loc:Str Options_ClearInstalledDefault}"
                        Command="{Binding ResetInstalledDefaultsCommand}" />
                </Grid>
                <Border Style="{StaticResource SubSetting}" Padding="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource SettingHint}"
                            VerticalAlignment="Center"
                            Text="{Binding BrowseDefaultsDescription}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            Content="{loc:Str Options_ClearBrowseDefault}"
                            Command="{Binding ResetBrowseDefaultsCommand}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ui:CardExpander>

        <!-- ─── Fika and servers ─── -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str Options_SectionMultiplayer}" />

        <!--
            Always shown, not gated on finding a launcher: someone who answered "ask me later", or
            whose headless is started some other way, needs somewhere to say so. The collapsed row
            names the current answer, so nobody has to open it to check.
        -->
        <ui:CardExpander
            Style="{StaticResource SettingExpander}"
            Icon="{ui:SymbolIcon Desktop24}">
            <ui:CardExpander.Header>
                <StackPanel ToolTip="{loc:Str Options_MachineRoleDescription}" ToolTipService.ShowDuration="30000">
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_MachineRoleHeader}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{Binding InstallRoleSummary, Mode=OneWay}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_MachineRoleDescription}" /></InlineUIContainer></TextBlock>
                </StackPanel>
            </ui:CardExpander.Header>

            <StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <ui:ToggleSwitch
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"
                        ToolTip="{loc:Str Options_PlaysHereToolTip}"
                        ToolTipService.ShowDuration="20000"
                        IsChecked="{Binding PlaysHere}"
                        OnContent="{loc:Str Options_PlaysHereOn}"
                        OffContent="{loc:Str Options_PlaysHereOff}" />
                    <ui:ToggleSwitch
                        HorizontalAlignment="Left"
                        ToolTip="{loc:Str Options_HeadlessToolTip}"
                        ToolTipService.ShowDuration="20000"
                        IsChecked="{Binding RunsHeadlessClient}"
                        OnContent="{loc:Str Options_HeadlessOn}"
                        OffContent="{loc:Str Options_HeadlessOff}" />
                    <TextBlock
                        Style="{StaticResource SettingHint}"
                        Margin="0,10,0,0"
                        Text="{Binding InstallRoleDescription}" />
                </StackPanel>

                <!--
                    The way out of detection, which only ever looks at the top of the install folder
                    (see SptLaunchService), so a manager kept beside the SPT folder has to be named.
                -->
                <Border Style="{StaticResource SubSetting}" Padding="0,12,0,0">
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource SettingTitle}"
                            Text="{loc:Str Options_HeadlessLauncherHeader}"
                            ToolTip="{loc:Str Options_HeadlessLauncherDescription}"
                            ToolTipService.ShowDuration="30000" />
                        <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_HeadlessLauncherHint}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_HeadlessLauncherDescription}" /></InlineUIContainer></TextBlock>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Grid.Column="0"
                                PlaceholderText="{loc:Str Options_HeadlessLauncherPlaceholder}"
                                Text="{Binding HeadlessLauncherPath, UpdateSourceTrigger=LostFocus}" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Content="{loc:Str Options_Browse}"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                Command="{Binding BrowseHeadlessLauncherCommand}" />
                            <ui:Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Appearance="Transparent"
                                Content="{loc:Str Options_ClearHeadlessLauncher}"
                                ToolTip="{loc:Str Options_ClearHeadlessLauncherToolTip}"
                                Command="{Binding ClearHeadlessLauncherCommand}" />
                        </Grid>
                        <!-- Worth mentioning, never preventing - there are plenty of ways to start one. -->
                        <TextBlock
                            Style="{StaticResource SettingNote}"
                            Margin="0,8,0,0"
                            Text="{loc:Str Options_NoHeadlessLauncherNotice}"
                            Visibility="{Binding HasHeadlessLauncher, Converter={StaticResource FalseToVisible}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ui:CardExpander>

        <!--
            The Server map page's connection, only while that page is switched on. Set up here
            because it is a one-off and the page itself is for reading.

            The address is asked for rather than derived from the install folder: on any Fika setup
            http.json is stale (Fika overrides the binding from fika.jsonc, with a bind address no
            client can dial), and the address typed into the SPT launcher is the honest source.
        -->
        <ui:CardExpander
            Style="{StaticResource SettingExpander}"
            Icon="{ui:SymbolIcon PlugConnected24}"
            Visibility="{Binding ServerMap.IsPageEnabled, Converter={StaticResource BoolToVisibility}}">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_ServerMapConnectionHeader}" />
                    <TextBlock Style="{StaticResource SettingHint}" Text="{loc:Str Options_ServerMapConnectionHint}" />
                </StackPanel>
            </ui:CardExpander.Header>

            <StackPanel DataContext="{Binding ServerMap}">
                <!-- Hidden until the addon page URL is set, so a build without one never shows a dead link. -->
                <StackPanel
                    Margin="0,0,0,12"
                    Visibility="{Binding HasAddonPage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Style="{StaticResource SettingHint}"
                        Margin="0,0,0,8"
                        Text="{loc:Str Options_ServerMapModNotice}" />
                    <ui:Button
                        HorizontalAlignment="Left"
                        Content="{loc:Str Options_GetServerMapMod}"
                        Icon="{ui:SymbolIcon Open24}"
                        ToolTip="{loc:Str Options_GetServerMapModToolTip}"
                        Command="{Binding OpenAddonPageCommand}" />
                </StackPanel>

                <!-- The placeholder is a hint, not a default: Fika's own 127.0.0.1 is quietly wrong
                     for anyone connecting to someone else's server. -->
                <WrapPanel Margin="0,0,0,4">
                    <ui:TextBox
                        MinWidth="260"
                        Margin="0,0,8,4"
                        PlaceholderText="{loc:Str Options_ServerAddressPlaceholder}"
                        Text="{Binding HostInput, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox
                        MinWidth="90"
                        Margin="0,0,8,4"
                        PlaceholderText="{loc:Str Options_PortPlaceholder}"
                        Text="{Binding PortInput, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="0,0,0,4"
                        Content="{loc:Str Options_Connect}"
                        Icon="{ui:SymbolIcon Connected20}"
                        Command="{Binding ConnectCommand}" />
                    <ProgressBar
                        Width="80"
                        Height="4"
                        Margin="12,0,0,4"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>

                <!-- A plain TextBox, not a PasswordBox: it gets copied between machines and pasted
                     into chat, and hiding it only makes it harder to check. -->
                <ui:TextBox
                    MinWidth="260"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    PlaceholderText="{loc:Str Options_SharedKeyPlaceholder}"
                    Text="{Binding KeyInput, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Style="{StaticResource SettingNote}"
                    Margin="0,0,0,8"
                    Text="{Binding KeyDescription}" />

                <!-- Only on the machine running a server. Shown in full: it is there to be copied out. -->
                <Border
                    Style="{StaticResource SubSetting}"
                    Visibility="{Binding IsServerOwner, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource SettingHint}"
                            Margin="0"
                            Text="{Binding LocalKeyDescription}" />
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button
                                Margin="0,0,8,0"
                                Content="{loc:Str Options_UseMachineKey}"
                                Icon="{ui:SymbolIcon Key24}"
                                Command="{Binding UseLocalKeyCommand}" />
                            <!-- Deliberate and destructive, so a button and never automatic. -->
                            <ui:Button
                                Content="{loc:Str Options_GenerateKey}"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                ToolTip="{loc:Str Options_GenerateKeyToolTip}"
                                Command="{Binding NewLocalKeyCommand}" />
                        </WrapPanel>
                        <!-- LAN-only, for this machine's own server. Beside the key because it is the
                             other thing only the operator decides, and only here is there a server. -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_ServerMapLanOnly}" />
                                <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_ServerMapLanOnlySummary}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_ServerMapLanOnlyHint}" /></InlineUIContainer></TextBlock>
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource RowSwitch}"
                                IsChecked="{Binding ServerLanOnly, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock
                            Style="{StaticResource SettingHint}"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasKeyNotice, Converter={StaticResource BoolToVisibility}}"
                            Text="{Binding KeyNotice}" />
                    </StackPanel>
                </Border>

                <!-- ErrorText turns this red only when the last attempt actually failed. -->
                <TextBlock
                    TextWrapping="Wrap"
                    Style="{StaticResource ErrorText}"
                    Text="{Binding StatusMessage}" />

                <!-- The one failure the user has to judge rather than just read. -->
                <ui:Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Appearance="Caution"
                    Content="{loc:Str Options_TrustCertificate}"
                    Icon="{ui:SymbolIcon Certificate24}"
                    Command="{Binding TrustNewCertificateCommand}"
                    Visibility="{Binding HasCertificateChanged, Converter={StaticResource BoolToVisibility}}" />

                <Border Style="{StaticResource SubSetting}" Margin="0,12,0,0" Padding="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource SettingNote}"
                            VerticalAlignment="Center"
                            Text="{Binding PinDescription}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            Content="{loc:Str Options_ForgetCertificate}"
                            Icon="{ui:SymbolIcon Delete24}"
                            ToolTip="{loc:Str Options_ForgetCertificateToolTip}"
                            Command="{Binding ForgetPinCommand}" />
                    </Grid>
                </Border>

                <!--
                    Whether this machine reports to the server's map, and under what name. The same
                    answer the question on the Server map page records (D9, once per server) - so
                    switching it off here takes the machine off the map. Disabled until this machine
                    has connected once, because the answer is keyed on the certificate that
                    connection records.
                -->
                <Border Style="{StaticResource SubSetting}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_ServerMapReport}" />
                                <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_ServerMapReportSummary}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_ServerMapReportHint}" /></InlineUIContainer></TextBlock>
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource RowSwitch}"
                                IsEnabled="{Binding CanChooseReporting}"
                                IsChecked="{Binding ReportsToServer, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock
                            Style="{StaticResource SettingTitle}"
                            Margin="0,12,0,0"
                            Text="{loc:Str Options_ServerMapDisplayName}" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="{loc:Str Options_ServerMapDisplayNameHint}" />
                        <!-- Saved when the box loses focus, not on every keystroke. -->
                        <ui:TextBox
                            MinWidth="260"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0"
                            PlaceholderText="{Binding DisplayNamePlaceholder}"
                            Text="{Binding DisplayNameInput, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock
                            Style="{StaticResource SettingNote}"
                            Margin="0,8,0,0"
                            Text="{Binding ReportingStatus}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ui:CardExpander>

        <!-- ─── Advanced ─── -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str Options_SectionAdvanced}" />

        <!-- Fork: copies of the SPT profiles, taken before the app changes the install (ProfileBackups). -->
        <ui:CardExpander
            Style="{StaticResource SettingExpander}"
            Icon="{ui:SymbolIcon History24}">
            <ui:CardExpander.Header>
                <StackPanel DataContext="{Binding Profiles}">
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Profiles_Header}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{Binding KeepSummary, Mode=OneWay}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{Binding KeepText}" /></InlineUIContainer></TextBlock>
                </StackPanel>
            </ui:CardExpander.Header>

            <StackPanel DataContext="{Binding Profiles}">
                <TextBlock
                    Style="{StaticResource SettingNote}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Profiles_Empty}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Backups}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{Binding When}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Why}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Detail}" />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Content="{loc:Str Profiles_Restore}"
                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Content="{loc:Str Profiles_BackUpNow}"
                        Command="{Binding BackUpNowCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="{loc:Str Profiles_OpenFolder}"
                        Command="{Binding OpenFolderCommand}" />
                </StackPanel>

                <TextBlock
                    Style="{StaticResource SettingHint}"
                    Margin="0,8,0,0"
                    Text="{Binding StatusMessage}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </ui:CardExpander>

        <ui:CardControl
            Style="{StaticResource SettingRow}"
            Icon="{ui:SymbolIcon DocumentData24}"
            ToolTip="{loc:Str Options_DataFilesDescription}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Str Options_DataFilesHeader}" />
                    <TextBlock Style="{StaticResource SettingHint}"><Run Text="{loc:Str Options_DataFilesHint}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Options_DataFilesDescription}" /></InlineUIContainer></TextBlock>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button
                Content="{loc:Str Options_DataFiles}"
                Click="DataFiles_Click" />
        </ui:CardControl>
    </StackPanel>
</Page>
