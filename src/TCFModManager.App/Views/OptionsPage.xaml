<Page
    x:Class="TCFModManager.App.Views.OptionsPage"
    Loaded="Page_Loaded"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Title="{loc:Str Nav_Options}">
    <Page.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
    </Page.Resources>
    <StackPanel Margin="24,16,24,16">
        <ui:Card Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Options_InstallFolderHeader}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_InstallFolderDescription}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:TextBox
                        MinWidth="440"
                        Text="{Binding InstallPathInput, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="{loc:Str Options_BrowseEllipsis}"
                        Command="{Binding BrowseCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="{loc:Str Common_Save}"
                        Command="{Binding SaveCommand}" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding SptEnvironment.StatusMessage}" />
            </StackPanel>
        </ui:Card>

        <!--
            Sits directly under the install folder because it is a fact about that folder's machine,
            and because setting the folder is what puts the question in the first place - this app
            has no first-run wizard, so that is its setup step.

            Always shown, not gated on finding a launcher. Someone who answered "ask me later", or
            whose headless is started some other way, needs somewhere to say so, and a card that
            appears and disappears is one nobody can rely on finding.
        -->
        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Options_MachineRoleHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_MachineRoleDescription}" />

                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    ToolTip="{loc:Str Options_PlaysHereToolTip}"
                    ToolTipService.ShowDuration="20000"
                    IsChecked="{Binding PlaysHere}"
                    OnContent="{loc:Str Options_PlaysHereOn}"
                    OffContent="{loc:Str Options_PlaysHereOff}" />

                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    ToolTip="{loc:Str Options_HeadlessToolTip}"
                    ToolTipService.ShowDuration="20000"
                    IsChecked="{Binding RunsHeadlessClient}"
                    OnContent="{loc:Str Options_HeadlessOn}"
                    OffContent="{loc:Str Options_HeadlessOff}" />

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,4,0,0"
                    Text="{Binding InstallRoleDescription}" />

                <!--
                    Only worth saying when the two disagree with the folder. A machine claiming to
                    run a headless with no launcher in sight is worth mentioning, never preventing -
                    plenty of ways exist to start one.
                -->
                <TextBlock
                    FontSize="11"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,8,0,0"
                    Text="{loc:Str Options_NoHeadlessLauncherNotice}"
                    Visibility="{Binding HasHeadlessLauncher, Converter={StaticResource FalseToVisible}}" />

                <!--
                    The way out of detection. It only ever looks at the top of the install folder,
                    and deliberately so - see SptLaunchService - so a manager kept beside the SPT
                    folder rather than in it has to be named rather than found.
                -->
                <TextBlock
                    Text="{loc:Str Options_HeadlessLauncherHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,16,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_HeadlessLauncherDescription}" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox
                        Grid.Column="0"
                        PlaceholderText="{loc:Str Options_HeadlessLauncherPlaceholder}"
                        Text="{Binding HeadlessLauncherPath, UpdateSourceTrigger=LostFocus}" />

                    <ui:Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="{loc:Str Options_Browse}"
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        Command="{Binding BrowseHeadlessLauncherCommand}" />

                    <ui:Button
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Appearance="Transparent"
                        Content="{loc:Str Options_ClearHeadlessLauncher}"
                        ToolTip="{loc:Str Options_ClearHeadlessLauncherToolTip}"
                        Command="{Binding ClearHeadlessLauncherCommand}" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <!-- Start server can bring the launcher up after it. -->
        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Options_LaunchHeader}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_LaunchDescription}" />
                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    IsChecked="{Binding StartLauncherAfterServer}"
                    OnContent="{loc:Str Options_LaunchSwitchOn}"
                    OffContent="{loc:Str Options_LaunchSwitchOff}" />
            </StackPanel>
        </ui:Card>

        <!-- Hidden in the Steam Workshop fork: Steam has one look, so there is no light theme to
             choose (see AppTheme.ApplyOnly). Left in place rather than deleted, so the setting it
             edits is untouched and the upstream app finds it where it was left. -->
        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Options_AppearanceHeader}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_AppearanceDescription}" />
                <ComboBox
                    MinWidth="200"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding SelectedTheme}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Options_Language_Header}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_Language_Description}" />

                <!-- MinWidth rather than Width: a language name is as long as it is, and a box
                     sized to English is the clipping this whole feature has to stop causing. -->
                <ComboBox
                    MinWidth="200"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding LanguageOptions}"
                    SelectedItem="{Binding SelectedLanguage}" />

                <!-- Collapsed while the credit is empty, which is every build that ships English
                     alone - so this row appears the first time a translation carries a name. -->
                <TextBlock
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding TranslationCredit}"
                    Visibility="{Binding TranslationCredit, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Options_WindowHeader}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_WindowDescription}" />
                <ComboBox
                    MinWidth="320"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding WindowStartupOptions}"
                    SelectedItem="{Binding SelectedWindowStartup}" />

                <!-- Only shown for the one mode that reads them - two size boxes sitting under
                     "Always start maximised" would look like they still did something. -->
                <StackPanel
                    Margin="0,12,0,0"
                    Visibility="{Binding ShowCustomSize, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox
                            MinWidth="110"
                            PlaceholderText="{loc:Str Options_WidthPlaceholder}"
                            Text="{Binding CustomWidthInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="8,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{loc:Str Options_SizeBy}" />
                        <ui:TextBox
                            MinWidth="110"
                            PlaceholderText="{loc:Str Options_HeightPlaceholder}"
                            Text="{Binding CustomHeightInput, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Content="{loc:Str Options_ApplySize}"
                            Command="{Binding ApplyWindowSizeCommand}" />

                        <!-- Dragging the window to the size you want and pressing one button beats
                             guessing two numbers. -->
                        <ui:Button
                            Margin="8,0,0,0"
                            Content="{loc:Str Options_UseCurrentSize}"
                            ToolTip="{loc:Str Options_UseCurrentSizeToolTip}"
                            Command="{Binding UseCurrentWindowSizeCommand}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding WindowSizeMessage}" />
            </StackPanel>
        </ui:Card>

        <!-- Whether the mouse wheel glides the page or jumps it. -->
        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Options_ScrollingHeader}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_ScrollingDescription}" />
                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    IsChecked="{Binding SmoothScrolling}"
                    OnContent="{loc:Str Options_ScrollingSwitchOn}"
                    OffContent="{loc:Str Options_ScrollingSwitchOff}" />
            </StackPanel>
        </ui:Card>

        <!-- Whether removing an item asks first; the question's "Don't ask again" turns this off. -->
        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Options_UnsubscribeHeader}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_UnsubscribeDescription}" />
                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    IsChecked="{Binding ConfirmUnsubscribe}"
                    OnContent="{loc:Str Options_UnsubscribeSwitchOn}"
                    OffContent="{loc:Str Options_UnsubscribeSwitchOff}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Options_PageDefaultsHeader}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_PageDefaultsDescription}" />

                <TextBlock
                    TextWrapping="Wrap"
                    Margin="0,0,0,4"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding InstalledDefaultsDescription}" />
                <TextBlock
                    TextWrapping="Wrap"
                    Margin="0,0,0,8"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding BrowseDefaultsDescription}" />

                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Content="{loc:Str Options_ClearInstalledDefault}"
                        Command="{Binding ResetInstalledDefaultsCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="{loc:Str Options_ClearBrowseDefault}"
                        Command="{Binding ResetBrowseDefaultsCommand}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Options_ModPagesHeader}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_ModPagesDescription}" />
                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    ToolTip="{Binding ModPageGate.SettingToolTip}"
                    ToolTipService.ShowDuration="20000"
                    IsChecked="{Binding SkipModPageConfirmation}"
                    OnContent="{loc:Str Options_ModPagesSwitchOn}"
                    OffContent="{loc:Str Options_ModPagesSwitchOff}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Options_FootprintHeader}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_FootprintDescription}" />
                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    ToolTip="{Binding FootprintGate.SettingToolTip}"
                    ToolTipService.ShowDuration="20000"
                    IsChecked="{Binding ShowModFootprintPage}"
                    OnContent="{loc:Str Options_SidebarOn}"
                    OffContent="{loc:Str Options_SidebarOff}" />
            </StackPanel>
        </ui:Card>

        <!--
            Server Map. The switch shows or hides the page, the same as Mod footprint above; the
            rest of the section is the connection the page uses, kept here because setting the
            address up is a one-off and the page itself is for reading.

            The address is asked for rather than derived from the install folder. On any Fika setup
            the install's own http.json is stale - Fika overrides the binding at runtime from
            fika.jsonc, and writes 0.0.0.0 there, which is a bind address and not one a client can
            dial. The address the user already types into the SPT launcher is the honest source.
        -->
        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel DataContext="{Binding ServerMap}">
                <TextBlock
                    Text="{loc:Str Options_ServerMapHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_ServerMapDescription}" />

                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    Margin="0,0,0,12"
                    ToolTip="{Binding SettingToolTip}"
                    ToolTipService.ShowDuration="20000"
                    IsChecked="{Binding IsPageEnabled}"
                    OnContent="{loc:Str Options_SidebarOn}"
                    OffContent="{loc:Str Options_SidebarOff}" />

                <!-- The server half is an addon rather than something bundled here: it is installed
                     on a different machine, by whoever runs the server. Hidden until the page URL
                     is set, so a build without one never shows a dead link. -->
                <StackPanel
                    Margin="0,0,0,12"
                    Visibility="{Binding HasAddonPage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:Str Options_ServerMapModNotice}" />
                    <ui:Button
                        HorizontalAlignment="Left"
                        Content="{loc:Str Options_GetServerMapMod}"
                        Icon="{ui:SymbolIcon Open24}"
                        ToolTip="{loc:Str Options_GetServerMapModToolTip}"
                        Command="{Binding OpenAddonPageCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <!-- The placeholder is a hint, not a default. Fika's own default is 127.0.0.1,
                         which is right for a server on this machine and quietly wrong for anyone
                         connecting to someone else's - so it is shown rather than filled in. -->
                    <ui:TextBox
                        MinWidth="300"
                        PlaceholderText="{loc:Str Options_ServerAddressPlaceholder}"
                        Text="{Binding HostInput, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox
                        MinWidth="90"
                        Margin="8,0,0,0"
                        PlaceholderText="{loc:Str Options_PortPlaceholder}"
                        Text="{Binding PortInput, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="{loc:Str Options_Connect}"
                        Icon="{ui:SymbolIcon Connected20}"
                        Command="{Binding ConnectCommand}" />
                    <ProgressBar
                        Width="80"
                        Height="4"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- The key the operator hands out with the address. A plain TextBox, not a
                     PasswordBox: it is not a secret about the person holding it, it gets copied
                     between machines and pasted into chat, and hiding it would only make it harder
                     to check against what you were sent. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:TextBox
                        MinWidth="300"
                        PlaceholderText="{loc:Str Options_SharedKeyPlaceholder}"
                        Text="{Binding KeyInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Margin="0,0,0,8"
                    Text="{Binding KeyDescription}" />

                <!-- Only on the machine actually running a server. Shown in full rather than
                     shortened: the whole purpose is to be copied out and sent to somebody, and
                     anyone who can see this window can already open the file it came from. -->
                <StackPanel
                    Margin="0,0,0,8"
                    Visibility="{Binding IsServerOwner, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        IsHitTestVisible="True"
                        Text="{Binding LocalKeyDescription}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button
                            HorizontalAlignment="Left"
                            Content="{loc:Str Options_UseMachineKey}"
                            Icon="{ui:SymbolIcon Key24}"
                            Command="{Binding UseLocalKeyCommand}" />

                        <!-- Deliberate and destructive, so it is a button and never automatic:
                             every copy of the old key stops working the moment this is pressed. -->
                        <ui:Button
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            Content="{loc:Str Options_GenerateKey}"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            ToolTip="{loc:Str Options_GenerateKeyToolTip}"
                            Command="{Binding NewLocalKeyCommand}" />
                    </StackPanel>

                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Visibility="{Binding HasKeyNotice, Converter={StaticResource BoolToVisibility}}"
                        Text="{Binding KeyNotice}" />
                </StackPanel>

                <!-- Named to match the shared ErrorText style, which turns this red only when the
                     last attempt actually failed. -->
                <TextBlock
                    TextWrapping="Wrap"
                    Style="{StaticResource ErrorText}"
                    Text="{Binding StatusMessage}" />

                <!-- The one failure the user has to judge rather than just read. Both fingerprints
                     are in the message above; this is the answer to it, and it is not offered for
                     any other kind of failure. -->
                <ui:Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Appearance="Caution"
                    Content="{loc:Str Options_TrustCertificate}"
                    Icon="{ui:SymbolIcon Certificate24}"
                    Command="{Binding TrustNewCertificateCommand}"
                    Visibility="{Binding HasCertificateChanged, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock
                    Margin="0,12,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding PinDescription}" />

                <ui:Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Content="{loc:Str Options_ForgetCertificate}"
                    Icon="{ui:SymbolIcon Delete24}"
                    ToolTip="{loc:Str Options_ForgetCertificateToolTip}"
                    Command="{Binding ForgetPinCommand}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Options_DataFilesHeader}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Options_DataFilesDescription}" />
                <ui:Button
                    HorizontalAlignment="Left"
                    Content="{loc:Str Options_DataFiles}"
                    Click="DataFiles_Click" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
