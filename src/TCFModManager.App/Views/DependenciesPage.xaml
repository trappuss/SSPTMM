<!-- ScrollViewer.CanContentScroll="False" - see the matching comment in InstalledPage.xaml for the
     full explanation. Short version: WPF-UI's NavigationView auto-wraps every Page's content in
     its own outer DynamicScrollViewer by default, which was interfering with TreesScrollViewer
     below in a way that made only the outer wrapper's own scrollbar actually work. This opts this
     page out of that wrapping. -->
<Page
    x:Class="TCFModManager.App.Views.DependenciesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:app="clr-namespace:TCFModManager.App"
    Title="{loc:Str Nav_Dependencies}"
    Loaded="DependenciesPage_Loaded"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:CountToVisibilityConverter x:Key="HasItems" />
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
    </Page.Resources>
    <!-- Scroll-anywhere is wired up in code-behind (see the constructor and
         Page_PreviewMouseWheel in DependenciesPage.xaml.cs) as a PreviewMouseWheel handler
         registered directly on the Page, not a XAML MouseWheel attribute on this Grid - a plain
         bubble MouseWheel handler isn't reliable, since several controls (ui:TextBox, ComboBox,
         ...) have an internal ScrollViewer part that swallows the bubbling event and marks it
         handled even when there's nothing for *them* to scroll. Same fix as InstalledPage's group
         view.
         Background="Transparent" is still required: a Grid with no Background isn't hit-testable
         in its empty space, so without it most of the "empty" space in the Refresh/status rows
         would resolve the hit test to whatever's behind this whole page instead of to anything
         inside it, meaning the event's route would never pass through the Page at all. -->
    <Grid
        x:Name="RootGrid"
        Margin="24,16,24,16"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <ui:Button
                DockPanel.Dock="Right"
                Content="{loc:Str Dependencies_Refresh}"
                Icon="{ui:SymbolIcon ArrowSync24}"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsNotBusy}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Text="{loc:Str Dependencies_Description}" />
        </DockPanel>

        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,12"
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding StatusMessage}" />

        <ScrollViewer
            x:Name="TreesScrollViewer"
            FocusVisualStyle="{x:Null}"
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <!-- Conflicts first (OPEN-11): a mod that won't load matters more than one that's behind. -->
            <TextBlock
                Margin="0,0,0,8"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{loc:Str Conflicts_Header}"
                Visibility="{Binding ConflictsChecked, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
                Margin="0,0,0,16"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{loc:Str Conflicts_None}"
                Visibility="{Binding ShowNoConflicts, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl Focusable="False" Margin="0,0,0,16" ItemsSource="{Binding Conflicts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,8" Padding="16,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Symbol="ErrorCircle24"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="28,4,0,8"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Explanation}" />
                                <ItemsControl Focusable="False" Margin="28,0,0,0" ItemsSource="{Binding Members}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource HoverRow}">
                                                <Grid MinHeight="34">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding ModName, Mode=OneWay}" />
                                                            <Run Text="{Binding Location, StringFormat=' - {0}', Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </TextBlock>
                                                        <TextBlock
                                                            FontSize="11"
                                                            TextTrimming="CharacterEllipsis"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Text="{Binding Detail}"
                                                            Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button
                                                        Margin="0,0,4,0"
                                                        Padding="10,2"
                                                        VerticalAlignment="Center"
                                                        Appearance="Secondary"
                                                        Content="{loc:Str Conflicts_KeepThis}"
                                                        ToolTip="{Binding KeepToolTip}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Command="{Binding DataContext.KeepConflictCopyCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanKeep}"
                                                        Visibility="{Binding IsKeepable, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:Button
                                                        Padding="4"
                                                        VerticalAlignment="Center"
                                                        Appearance="Transparent"
                                                        Icon="{ui:SymbolIcon FolderOpen20}"
                                                        ToolTip="{loc:Str Conflicts_OpenFolderToolTip}"
                                                        Command="{Binding DataContext.OpenConflictFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                        CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Margin="0,0,0,8"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{loc:Str Dependencies_Header}"
                Visibility="{Binding HasLoaded, Converter={StaticResource BoolToVisibility}}" />
            <!-- Shown once a scan has finished and found no dependencies to report. -->
            <TextBlock
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{loc:Str Dependencies_Empty}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl Focusable="False" ItemsSource="{Binding Trees}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- One expander per installed mod, holding its flattened dependency rows. -->
                        <ui:CardExpander Style="{StaticResource HoverCardExpander}" Margin="0,0,0,8" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                            <ui:CardExpander.Header>
                                <Grid Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Symbol="{Binding Glyph}"
                                        Style="{StaticResource WorstStatusIcon}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ModName, Mode=OneWay}" />
                                            <Run Text="{Binding ModVersion, StringFormat=' {0}', Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Summary}" />
                                    </StackPanel>
                                </Grid>
                            </ui:CardExpander.Header>

                            <ItemsControl Focusable="False" ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Indent reflects depth in the tree; a nested dependency sits under its parent. -->
                                        <Border Style="{StaticResource HoverRow}" Margin="{Binding Indent}">
                                            <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:SymbolIcon
                                                Grid.Column="0"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Symbol="{Binding Glyph}"
                                                Style="{StaticResource StatusIcon}" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding StatusText, StringFormat=' - {0}', Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>

                                            <!-- Only rows that are actually missing or outdated get an action. The
                                                 small button does the opposite of Monitor mode's setting. -->
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}">
                                                <ui:Button
                                                    Margin="0,0,4,0"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    Appearance="Transparent"
                                                    Command="{Binding DataContext.InstallAlternateCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsNotQueued}"
                                                    ToolTip="{Binding AlternateToolTip, Source={x:Static app:AppServices.ModPageGate}}">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon
                                                            FontSize="14"
                                                            Symbol="{Binding AlternateSymbol, Source={x:Static app:AppServices.ModPageGate}}" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                                <ui:Button
                                                    Padding="10,2"
                                                    VerticalAlignment="Center"
                                                    Appearance="Secondary"
                                                    Content="{Binding InstallButtonText}"
                                                    Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsNotQueued}"
                                                    ToolTip="{Binding InstallToolTip}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTipService.ShowDuration="20000" />
                                            </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
