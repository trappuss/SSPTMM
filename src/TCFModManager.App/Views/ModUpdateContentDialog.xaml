<ui:ContentDialog
    x:Class="TCFModManager.App.Views.ModUpdateContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:app="clr-namespace:TCFModManager.App"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:views="clr-namespace:TCFModManager.App.Views"
    Style="{DynamicResource {x:Type ui:ContentDialog}}"
    IsFooterVisible="False">
    <!--
        Shows every published version of a mod with its own changelog, letting the user pick one
        to install or update to. DataContext is a ModUpdateDialogViewModel set in code-behind.
    -->
    <ui:ContentDialog.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:UpdateAvailableToVisibilityConverter x:Key="TrueToVisible" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
    </ui:ContentDialog.Resources>

    <ui:ContentDialog.TitleTemplate>
        <DataTemplate>
            <!-- DataContext here is the Title object (the mod's display title). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding}"
                    TextWrapping="WrapWithOverflow" />

                <ui:Button
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Appearance="Transparent"
                    Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ui:ContentDialog}}, Path=TemplateButtonCommand}"
                    CommandParameter="{x:Static ui:ContentDialogButton.Close}"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    IsCancel="True"
                    ToolTip="{loc:Str Common_Close}" />
            </Grid>
        </DataTemplate>
    </ui:ContentDialog.TitleTemplate>

    <!-- Background is Transparent, not unset: a Panel with no Background only takes part in hit
         testing where a child actually paints, so the gaps between rows would be invisible to the
         wheel handler in the code-behind. -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding InstalledVersionText, StringFormat={loc:Str ModUpdate_CurrentlyInstalledFormat}, TargetNullValue={loc:Str Common_Unknown}}" />
            <TextBlock
                Margin="0,4,0,0"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusMessage}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />

            <!-- Explains why Update/Redownload aren't offered while the mod is disabled. -->
            <TextBlock
                Margin="0,4,0,0"
                TextWrapping="Wrap"
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                Text="{Binding DisabledNotice}"
                Visibility="{Binding IsModDisabled, Converter={StaticResource TrueToVisible}}" />
        </StackPanel>

        <!-- "View mod page" shows when a catalog match exists. Which of Update / Downgrade /
             Redownload appears is decided by the version SELECTED below against the one installed,
             so the button always names what pressing it would actually do. "Mark up to date" and
             "Confirm as installed" only record a version - they never touch any files. -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <ui:Button
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                Content="{loc:Str ModUpdate_Update}"
                Icon="{ui:SymbolIcon ArrowSync24}"
                ToolTip="{Binding UpdateToolTip, Source={x:Static app:AppServices.ModPageGate}}"
                Command="{Binding UpdateCommand}"
                Visibility="{Binding ShowUpdateButton, Converter={StaticResource TrueToVisible}}" />
            <ui:Button
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                Content="{loc:Str ModUpdate_Downgrade}"
                Icon="{ui:SymbolIcon ArrowDown24}"
                Command="{Binding DowngradeCommand}"
                ToolTip="{loc:Str ModUpdate_DowngradeToolTip}"
                Visibility="{Binding ShowDowngradeButton, Converter={StaticResource TrueToVisible}}" />
            <ui:Button
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                Content="{loc:Str ModUpdate_Redownload}"
                Icon="{ui:SymbolIcon ArrowDownload24}"
                Command="{Binding RedownloadCommand}"
                ToolTip="{Binding RedownloadToolTip, Source={x:Static app:AppServices.ModPageGate}}"
                Visibility="{Binding ShowRedownloadButton, Converter={StaticResource TrueToVisible}}" />
            <!-- Does the showing action the other way round from Monitor mode's setting, for this
                 one mod: download only when the app installs, install when it only downloads. -->
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,4,0"
                Padding="6"
                Appearance="Transparent"
                Command="{Binding AlternateCommand}"
                ToolTip="{Binding AlternateToolTip, Source={x:Static app:AppServices.ModPageGate}}"
                Visibility="{Binding ShowAlternateButton, Converter={StaticResource TrueToVisible}}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="{Binding AlternateSymbol, Source={x:Static app:AppServices.ModPageGate}}" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Content="{loc:Str ModUpdate_MarkUpToDate}"
                Command="{Binding MarkUpToDateCommand}"
                ToolTip="{loc:Str ModUpdate_MarkUpToDateToolTip}"
                Visibility="{Binding CanManageVersion, Converter={StaticResource TrueToVisible}}" />
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Content="{loc:Str ModUpdate_ConfirmAsInstalled}"
                Command="{Binding ConfirmSelectedAsInstalledCommand}"
                ToolTip="{loc:Str ModUpdate_ConfirmAsInstalledToolTip}"
                Visibility="{Binding CanManageVersion, Converter={StaticResource TrueToVisible}}" />
            <ui:Button
                Content="{loc:Str Common_ViewModPage}"
                Icon="{ui:SymbolIcon Open24}"
                Command="{Binding OpenModPageCommand}"
                Visibility="{Binding ModPageUrl, Converter={StaticResource NullToCollapsed}}" />
        </DockPanel>

        <!-- What an update would do with this mod's own configs. Read-only here - it is set on the
             Configs page - and shown next to Update because that is the moment it matters. -->
        <TextBlock
            Grid.Row="2"
            Margin="0,0,0,8"
            TextWrapping="Wrap"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="{Binding ConfigPolicyNote}"
            Visibility="{Binding ConfigPolicyNote, Converter={StaticResource NullToCollapsed}}" />

        <!-- Free-typed version override, for a version that isn't in the cached list below. -->
        <DockPanel Grid.Row="3" Margin="0,0,0,8" Visibility="{Binding CanManageVersion, Converter={StaticResource TrueToVisible}}">
            <ui:Button
                DockPanel.Dock="Right"
                Content="{loc:Str ModUpdate_ClearOverride}"
                Command="{Binding ClearOverrideCommand}"
                ToolTip="{loc:Str ModUpdate_ClearOverrideToolTip}"
                Visibility="{Binding IsManualOverride, Converter={StaticResource TrueToVisible}}" />
            <ui:Button
                DockPanel.Dock="Right"
                Margin="8,0,0,0"
                Content="{loc:Str ModUpdate_Set}"
                Command="{Binding SetCustomVersionCommand}" />
            <ui:TextBox
                PlaceholderText="{loc:Str ModUpdate_ManualVersionPlaceholder}"
                Text="{Binding CustomVersionText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <Grid Grid.Row="4">
            <!-- Loading state shown while versions are being fetched. -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsLoading, Converter={StaticResource TrueToVisible}}">
                <ProgressBar Width="220" Height="4" IsIndeterminate="True" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Str ModUpdate_LoadingVersions}" />
            </StackPanel>

            <!-- Inert, and left alone only because it predates this: ContentDialog's own template
                 wraps everything here in a PART_ContentScroll PassiveScrollViewer, which measures
                 this with unbounded height, so this one never has anything to scroll. The dialog's
                 visible scrollbar is that template part, and that is what the wheel has to drive -
                 see Dialog_PreviewMouseWheel. -->
            <ScrollViewer
                FocusVisualStyle="{x:Null}"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding IsLoading, Converter={StaticResource FalseToVisible}}">
              <StackPanel>
                <!-- Says how many versions are out of sight and why, so a shortened list is never
                     mistaken for the whole history. -->
                <DockPanel
                    Margin="0,0,0,8"
                    Visibility="{Binding ShowVersionFilterNotice, Converter={StaticResource TrueToVisible}}">
                    <CheckBox
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Content="{loc:Str ModUpdate_ShowAll}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        ToolTip="{loc:Str ModUpdate_ShowAllToolTip}"
                        IsChecked="{Binding ShowIncompatibleVersions}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding HiddenVersionsNotice}" />
                </DockPanel>

                <ListBox
                    BorderThickness="0"
                    Background="Transparent"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ItemsSource="{Binding Versions}"
                    SelectedItem="{Binding SelectedVersion}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                            <!-- Replaced outright, not just zeroed: the stock template paints its
                                 own accent fill for a selected row whatever Background says, and
                                 the card below now draws that state itself. See trap 8 in the
                                 theme notes. -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Each version is its own collapsible CardExpander; only the latest
                                 starts expanded. The selected one carries an accent edge and tint:
                                 which version is picked decides what Update or Redownload fetches,
                                 and the only thing saying so used to be the container's own
                                 highlight behind the card. -->
                            <ui:CardExpander
                                Style="{StaticResource SelectableCardExpander}"
                                IsExpanded="{Binding IsLatest, Mode=OneWay}">
                                <ui:CardExpander.Header>
                                    <!-- Clicking the header picks the version as well as expanding
                                         it. Background="Transparent" so the empty space between
                                         the title and the badges is hit-testable too, rather than
                                         only the text itself. -->
                                    <Grid
                                        Background="Transparent"
                                        PreviewMouseLeftButtonDown="VersionHeader_PreviewMouseLeftButtonDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding VersionText}" />
                                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                <Run Text="{Binding PublishedAt, Mode=OneWay, StringFormat={loc:Str ModUpdate_PublishedFormat}, TargetNullValue={loc:Str Common_Unknown}}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Badge
                                                Margin="6,0,0,0"
                                                Appearance="Info"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Content="{loc:Str ModUpdate_BadgeLatest}"
                                                Visibility="{Binding IsLatest, Converter={StaticResource TrueToVisible}}" />
                                            <ui:Badge
                                                Margin="6,0,0,0"
                                                Appearance="Caution"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Content="{loc:Str ModUpdate_BadgeInstalled}"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource TrueToVisible}}" />
                                        </StackPanel>
                                    </Grid>
                                </ui:CardExpander.Header>

                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Visibility="{Binding SptVersionConstraint, Converter={StaticResource NullToCollapsed}}">
                                        <Run Text="{Binding SptVersionConstraint, Mode=OneWay, StringFormat={loc:Str ModUpdate_TargetsSptFormat}}" />
                                    </TextBlock>

                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding CompatibilityLabel}"
                                        Visibility="{Binding CompatibilityLabel, Converter={StaticResource NullToCollapsed}}" />

                                    <!-- Renders the HTML changelog as formatted text. -->
                                    <RichTextBox
                                        Margin="0,6,0,0"
                                        Padding="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        IsReadOnly="True"
                                        IsDocumentEnabled="True"
                                        Focusable="False"
                                        VerticalScrollBarVisibility="Disabled"
                                        HorizontalScrollBarVisibility="Disabled"
                                        behaviors:HtmlText.Html="{Binding Changelog}"
                                        Visibility="{Binding Changelog, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Collapses itself when this mod has no addons, so it costs nothing here. -->
                <views:AddonsSection Margin="0,16,0,0" DataContext="{Binding Addons}" />
              </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:ContentDialog>
