<!--
    The authors followed from the Workshop pages, from Your Items. Steam keeps that list on your
    profile rather than in the Workshop, so there is no Steam page to copy; it is drawn with the
    Workshop's own pieces: the collection page's rows (rgba(84,133,183,.2), a brighter
    rgba(117,186,255,.3) under the pointer), CREATED BY's avatar frame, Follow, and a general button
    for the author's items.
-->
<Page
    x:Class="TCFModManager.App.Views.FollowedAuthorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Title="{loc:Str FollowedAuthors_Title}"
    FontFamily="{StaticResource SteamFont}"
    Loaded="Page_Loaded">
    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:UpdateAvailableToVisibilityConverter x:Key="TrueToVisible" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
    </Page.Resources>

    <StackPanel MaxWidth="950" Margin="24,20,24,40">
        <DockPanel>
            <Button
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Style="{StaticResource SteamOutlineButton}"
                Command="{Binding ViewAllItemsCommand}"
                Visibility="{Binding IsEmpty, Converter={StaticResource FalseToVisible}}">
                <TextBlock Text="{loc:Str FollowedAuthors_ViewAllItems}" />
            </Button>
            <TextBlock VerticalAlignment="Center" FontSize="11">
                <Run Foreground="#61696D" Text="{loc:Str FollowedAuthors_Header}" />
                <Run Foreground="#939393" Text="{Binding CountText, Mode=OneWay}" />
            </TextBlock>
        </DockPanel>

        <TextBlock
            Margin="0,16,0,0"
            FontSize="14"
            Foreground="{StaticResource SteamText}"
            TextWrapping="Wrap"
            Text="{loc:Str FollowedAuthors_Empty}"
            Visibility="{Binding IsEmpty, Converter={StaticResource TrueToVisible}}" />

        <ItemsControl Focusable="False" Margin="0,8,0,0" ItemsSource="{Binding Authors}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Row" Margin="0,0,0,2" Padding="10" Background="#335485B7">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button Margin="0,0,10,0" Style="{StaticResource SteamGeneralButton}" Command="{Binding OpenItemsCommand}">
                                    <TextBlock Text="{loc:Str FollowedAuthors_TheirItems}" />
                                </Button>
                                <Button
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SteamFollowButton}"
                                    ToolTip="{Binding FollowToolTip}"
                                    Command="{Binding ToggleFollowCommand}" />
                            </StackPanel>
                            <Border Width="48" Height="48" Margin="0,0,12,0" Background="#3D4450" BorderBrush="#57CBDE" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <ui:SymbolIcon FontSize="24" Foreground="{StaticResource SteamText}" Symbol="Person16" />
                                    <Image Stretch="UniformToFill" behaviors:ThumbnailLoader.DecodeWidth="48" behaviors:ThumbnailLoader.Source="{Binding Photo}" />
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource SteamFontLight}" FontWeight="Light" FontSize="16" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#969696">
                                    <Run Text="{Binding ItemsText, Mode=OneWay}" />
                                    <Run Text="{Binding NewestText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#4D75BAFF" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
