<!--
    Browse, laid out as Steam's Workshop browse page (steamcommunity.com/workshop/browse): the banner
    and the Workshop strip, "Browsing: ..." with the match count, the search box and gear on the left
    and the sort order on the right, a 300px filter sidebar beside a grid of 245px cards, and the
    per-page choice and numbered pager under it. Every size and colour is from the live page - see
    docs/steam-workshop-ui.md.

    The whole page scrolls as one, the way a Steam page does, so the page opts out of the outer
    DynamicScrollViewer NavigationView wraps pages in (ScrollViewer.CanContentScroll="False") and
    carries its own. That wrapper measures a page with unbounded height, which is what used to let
    the pager ride up and down; with one ScrollViewer here and the pager at the end of the content,
    there is nothing for it to ride on.

    What Steam's page has and this one leaves out: the Discussions and About links in the strip, the
    time frame half of the sort panel (the catalog records no per-period popularity), and star
    ratings - sp-mod.com publishes endorsements, favourites and downloads instead, so those are what
    sit where the stars would.
-->
<Page
    x:Class="TCFModManager.App.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:app="clr-namespace:TCFModManager.App"
    xmlns:views="clr-namespace:TCFModManager.App.Views"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    ScrollViewer.CanContentScroll="False"
    Title="{loc:Str Nav_Browse}"
    Loaded="BrowsePage_Loaded">
    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:LocalTimeConverter x:Key="LocalTime" />
        <converters:UpdateAvailableToVisibilityConverter x:Key="TrueToVisible" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <converters:CountToVisibilityConverter x:Key="HasCount" />
        <converters:EqualityConverter x:Key="IsSame" />
        <converters:PageSizeLabelConverter x:Key="PageSizeLabel" />

        <!-- The sort order's face: rgba(0,0,0,.37), 283x42, 15px #C4C4C4. -->
        <Style x:Key="SortFace" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#C4C4C4" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Padding="10,0" Background="{StaticResource SteamSortBox}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- A page number in the pager: 15px white, the current one #ACB2B8 and not a link. -->
        <Style x:Key="PageNumber" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SteamBlue}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SteamText}" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SteamText}" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The pager's arrows: #1A9FFF 41x24, radius 2; #21537A with a grey arrow when there is
             nowhere to go. -->
        <Style x:Key="PagerArrow" TargetType="Button" BasedOn="{StaticResource SteamBlueButton}">
            <Setter Property="Width" Value="41" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SteamBlueHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#21537A" />
                                <Setter Property="Foreground" Value="#71757A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer
        x:Name="PageScroll"
        FocusVisualStyle="{x:Null}"
        ScrollChanged="PageScroll_ScrollChanged"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24">
            <views:WorkshopBanner />
            <views:WorkshopSubNav />

            <!-- "Browsing: Mods (Subscribe to add to your game)" - 18px, the hint in the light face. -->
            <TextBlock Margin="0,24,0,0" FontSize="18" Foreground="{StaticResource SteamTextBright}" TextWrapping="Wrap">
                <Run Text="{loc:Str Workshop_BrowsingTitle}" />
                <Run FontFamily="{StaticResource SteamFontLight}" FontWeight="Light" Text="{loc:Str Workshop_BrowsingHint}" />
            </TextBlock>
            <!-- The count, then Steam's chips: one per filter in force, 5px apart, each removing its
                 filter when clicked. Measured: 24px tall, rgba(0,0,0,.3), radius 2, 12px white, a
                 16px #D9D9D9 x 10px after the text, #67707B under the pointer; a tag's chip starts
                 with its 20px [+] or [-] box. -->
            <WrapPanel Margin="0,4,0,0">
                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{StaticResource SteamText}"
                    TextWrapping="Wrap"
                    Text="{Binding EntriesText}" />
                <ItemsControl Focusable="False" VerticalAlignment="Center" ItemsSource="{Binding FilterChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0,2,5,2"
                                Command="{Binding DataContext.RemoveFilterChipCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                ToolTip="{loc:Str Browse_ChipRemoveToolTip}">
                                <!-- Steam's padding: 1 12 for text, 1 4 1 2 around a tag's box. -->
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SteamFilterChip}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInclude}" Value="True">
                                                <Setter Property="Padding" Value="2,0,4,0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsExclude}" Value="True">
                                                <Setter Property="Padding" Value="2,0,4,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" Margin="0,0,6,0" Background="#5DB7C7" CornerRadius="2" Visibility="{Binding IsInclude, Converter={StaticResource TrueToVisible}}">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="Black" Text="+" />
                                    </Border>
                                    <Border Width="20" Height="20" Margin="0,0,6,0" Background="#D3AC42" CornerRadius="2" Visibility="{Binding IsExclude, Converter={StaticResource TrueToVisible}}">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="Black" Text="-" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Text}" />
                                    <ui:SymbolIcon Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" Foreground="#D9D9D9" Symbol="Dismiss16" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>

            <!-- Anything the page has to say that isn't the count: queued, saved, failed. Steam has
                 nowhere for this; it sits under the count so it is still read. -->
            <TextBlock
                Margin="0,4,0,0"
                FontSize="13"
                Foreground="{StaticResource SteamLegacyBlue}"
                TextWrapping="Wrap"
                Text="{Binding StatusMessage}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />

            <!-- Search on the left, sort order on the right. -->
            <DockPanel Margin="0,10,0,12">
                <ToggleButton
                    x:Name="SortToggle"
                    DockPanel.Dock="Right"
                    Width="283"
                    Height="42"
                    Style="{StaticResource SortFace}"
                    ToolTip="{loc:Str Common_SortToolTip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Steam's sort glyph: three shortening lines and a down arrow. -->
                        <Path
                            Grid.Column="0"
                            Width="24"
                            Height="16"
                            Margin="0,0,21,0"
                            Data="M0,1 L14,1 M0,7 L11,7 M0,13 L8,13 M19,0 L19,14 M15,10 L19,14 L23,10"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                            StrokeThickness="2" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Text="{Binding SelectedSortOption.Label}" />
                        <Path
                            Grid.Column="2"
                            Width="14"
                            Height="10"
                            Margin="10,0,4,0"
                            Data="M0,0 L14,0 L7,10 Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                            Stretch="Fill" />
                    </Grid>
                </ToggleButton>
                <Popup
                    x:Name="SortPopup"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=SortToggle, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=SortToggle}"
                    StaysOpen="False">
                    <Border Margin="0,0,12,12" MinWidth="283" Style="{StaticResource SteamMenuPanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SteamMenuHeader}" Text="{loc:Str Workshop_SortOrderHeader}" />
                            <ItemsControl Focusable="False" ItemsSource="{Binding SortOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton
                                            Style="{StaticResource SteamRadio}"
                                            Command="{Binding DataContext.SelectSortCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Click="SortChoice_Click">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource IsSame}" Mode="OneWay">
                                                    <Binding />
                                                    <Binding Path="DataContext.SelectedSortOption" RelativeSource="{RelativeSource AncestorType=Page}" />
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                            <TextBlock Text="{Binding Label}" />
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>

                <StackPanel Orientation="Horizontal">
                    <Border Width="260" Height="42" Padding="8" Background="{StaticResource SteamGray}">
                        <TextBox
                            Style="{StaticResource SteamSearchField}"
                            Tag="{loc:Str Common_SearchPlaceholder}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <!-- Steam's gear: the search options panel below. -->
                    <Button
                        x:Name="GearButton"
                        Width="36"
                        Height="42"
                        Margin="4,0,0,0"
                        Padding="0"
                        Style="{StaticResource SteamButton}"
                        ToolTip="{loc:Str Workshop_SearchOptionsToolTip}"
                        Click="GearButton_Click">
                        <ui:SymbolIcon FontSize="22" Foreground="{StaticResource SteamText}" Filled="True" Symbol="Settings24" />
                    </Button>

                    <!-- Steam's search options, under the gear: which fields the search looks in.
                         Then this page's own two: refresh the catalog, and keep these filters as
                         how the page opens. -->
                    <Popup
                        x:Name="SearchOptions"
                        AllowsTransparency="True"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=GearButton}"
                        StaysOpen="False"
                        VerticalOffset="2"
                        Closed="SearchOptions_Closed">
                        <Border Margin="0,0,12,12" Width="500" Padding="20" Background="{StaticResource SteamOptionsPanelBackground}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Direction="315" Opacity="1" ShadowDepth="1.4" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock FontSize="15" Foreground="#ACB2B8" LineHeight="20" TextWrapping="Wrap" Text="{loc:Str Browse_SearchFieldsPrompt}" />
                                <StackPanel Margin="0,4,0,0">
                                    <RadioButton GroupName="SearchScope" Style="{StaticResource SteamOptionRadio}" IsChecked="{Binding IsTitleAndDescription, Mode=TwoWay}" Content="{loc:Str Browse_SearchTitleAndDescription}" />
                                    <RadioButton GroupName="SearchScope" Style="{StaticResource SteamOptionRadio}" IsChecked="{Binding IsTitleOnly, Mode=TwoWay}" Content="{loc:Str Browse_SearchTitleOnly}" />
                                    <RadioButton GroupName="SearchScope" Style="{StaticResource SteamOptionRadio}" IsChecked="{Binding IsDescriptionOnly, Mode=TwoWay}" Content="{loc:Str Browse_SearchDescriptionOnly}" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="15" Foreground="#ACB2B8" LineHeight="20" TextWrapping="Wrap" Text="{loc:Str Browse_SearchAuthorHint}" />
                                <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="{StaticResource SteamTextDim}" TextWrapping="Wrap" Text="{loc:Str Browse_SearchDescriptionNote}" />
                                <Rectangle Height="1" Margin="0,16,0,12" Fill="{StaticResource SteamDivider}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Margin="0,0,8,0" Style="{StaticResource SteamButton}" Command="{Binding RefreshCacheCommand}" Click="SearchOption_Click">
                                        <TextBlock Text="{loc:Str Browse_RefreshCache}" />
                                    </Button>
                                    <Button Style="{StaticResource SteamButton}" Command="{Binding SaveAsDefaultCommand}" ToolTip="{loc:Str Browse_SaveAsDefaultToolTip}" Click="SearchOption_Click">
                                        <TextBlock Text="{loc:Str Common_SaveAsDefault}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </DockPanel>

            <!-- Filter sidebar and the results grid. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="10"
                    VerticalAlignment="Top"
                    Background="{StaticResource SteamSidebarBackground}">
                    <StackPanel>
                        <!-- Steam's "SPECIAL FILTERS" dropdown - here, whether featured mods are in. -->
                        <TextBlock Style="{StaticResource SteamSidebarHeader}" Text="{loc:Str Workshop_SpecialFilters}" />
                        <ComboBox
                            MinHeight="36"
                            FontSize="13"
                            ToolTip="{loc:Str Browse_FeaturedFilterToolTip}"
                            ItemsSource="{Binding FeaturedFilterOptions}"
                            SelectedItem="{Binding SelectedFeaturedFilter}" />

                        <TextBlock Margin="0,20,0,5" Style="{StaticResource SteamSidebarHeader}" Text="{loc:Str Workshop_ContentType}" />
                        <ComboBox
                            MinHeight="36"
                            FontSize="13"
                            ToolTip="{loc:Str Browse_CategoryFilterToolTip}"
                            ItemsSource="{Binding CategoryOptions}"
                            SelectedItem="{Binding SelectedCategory}" />

                        <!-- SPT release lines, as tag rows. Only [+] means anything here: ticked lines
                             narrow the results to mods with a release for them. -->
                        <TextBlock Margin="0,20,0,5" Style="{StaticResource SteamSidebarHeader}" Text="{loc:Str Workshop_SptVersionHeader}" ToolTip="{loc:Str Browse_SptVersionFilterToolTip}" />
                        <ItemsControl Focusable="False" ItemsSource="{Binding SptVersionOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,5" Background="Transparent" Orientation="Horizontal">
                                        <CheckBox Style="{StaticResource SteamTagIncludeBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        <CheckBox Style="{StaticResource SteamTagExcludeBox}" IsEnabled="False" />
                                        <TextBlock Style="{StaticResource SteamTagLabel}" Text="{Binding Label, StringFormat={loc:Str Browse_SptVersionItemFormat}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,20,0,5" Style="{StaticResource SteamSidebarHeader}" Text="{loc:Str Workshop_ModTags}" ToolTip="{loc:Str Common_AttributeFilterToolTip}" />
                        <ItemsControl Focusable="False" ItemsSource="{Binding TagRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,5" Background="Transparent" Orientation="Horizontal">
                                        <CheckBox
                                            Style="{StaticResource SteamTagIncludeBox}"
                                            IsChecked="{Binding IncludeOn, Mode=TwoWay}"
                                            IsEnabled="{Binding CanInclude}"
                                            ToolTip="{Binding IncludeToolTip}" />
                                        <CheckBox
                                            Style="{StaticResource SteamTagExcludeBox}"
                                            IsChecked="{Binding ExcludeOn, Mode=TwoWay}"
                                            IsEnabled="{Binding CanExclude}"
                                            ToolTip="{Binding ExcludeToolTip}" />
                                        <TextBlock Style="{StaticResource SteamTagLabel}" Text="{Binding Label}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Steam's "Filter by Date", and beside it Clear filters. -->
                        <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                            <Button Style="{StaticResource SteamButton}" Command="{Binding ToggleDateFilterCommand}">
                                <TextBlock Text="{loc:Str Browse_FilterByDate}" />
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                Style="{StaticResource SteamButton}"
                                ToolTip="{loc:Str Common_ClearFiltersToolTip}"
                                Command="{Binding ClearFiltersCommand}">
                                <TextBlock Text="{loc:Str Common_ClearFilters}" />
                            </Button>
                        </StackPanel>

                        <!-- Steam's date panel: headings 13px white upper case, "Between" and "And"
                             13px #ACB2B8, the fields 196x36 on #3D4450 with a calendar. -->
                        <StackPanel Visibility="{Binding IsDateFilterOpen, Converter={StaticResource TrueToVisible}}">
                            <StackPanel.Resources>
                                <Style x:Key="DateHeading" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Margin" Value="0,14,0,6" />
                                </Style>
                                <Style x:Key="DateLabel" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Foreground" Value="#ACB2B8" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                </Style>
                                <Style x:Key="DateField" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
                                    <Setter Property="Height" Value="36" />
                                    <Setter Property="Background" Value="#3D4450" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="SelectedDateFormat" Value="Short" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Style="{StaticResource DateHeading}" Text="{loc:Str Browse_PostedDate}" />
                            <TextBlock Style="{StaticResource DateLabel}" Text="{loc:Str Browse_DateBetween}" />
                            <Border Width="196" Margin="0,0,0,10" HorizontalAlignment="Left"><DatePicker Style="{StaticResource DateField}" SelectedDate="{Binding PostedAfter, Mode=TwoWay}" /></Border>
                            <TextBlock Style="{StaticResource DateLabel}" Text="{loc:Str Browse_DateAnd}" />
                            <Border Width="196" Margin="0,0,0,10" HorizontalAlignment="Left"><DatePicker Style="{StaticResource DateField}" SelectedDate="{Binding PostedBefore, Mode=TwoWay}" /></Border>
                            <TextBlock Style="{StaticResource DateHeading}" Text="{loc:Str Browse_DateLastUpdated}" />
                            <TextBlock Style="{StaticResource DateLabel}" Text="{loc:Str Browse_DateBetween}" />
                            <Border Width="196" Margin="0,0,0,10" HorizontalAlignment="Left"><DatePicker Style="{StaticResource DateField}" SelectedDate="{Binding UpdatedAfter, Mode=TwoWay}" /></Border>
                            <TextBlock Style="{StaticResource DateLabel}" Text="{loc:Str Browse_DateAnd}" />
                            <Border Width="196" Margin="0,0,0,10" HorizontalAlignment="Left"><DatePicker Style="{StaticResource DateField}" SelectedDate="{Binding UpdatedBefore, Mode=TwoWay}" /></Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="2" MinHeight="400">
                    <!-- The card grid. Columns come from the width - as many 245px cards as fit, 16px
                         apart - and the right margin takes back the last column's gap. Not focusable
                         (nor is any list of items in the app): a card's Subscribe goes disabled while
                         it works, keyboard focus then fell back to the grid, and a focused element is
                         scrolled into view - the page jumped to the grid's top. -->
                    <ItemsControl
                        x:Name="ResultsGrid"
                        Focusable="False"
                        Margin="0,0,-16,0"
                        VerticalAlignment="Top"
                        ItemsSource="{Binding Results}"
                        SizeChanged="ResultsGrid_SizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid VerticalAlignment="Top" Columns="{Binding Columns}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- One card, plus the shadow behind it as its own layer: an Effect on
                                     the card itself would render its text without ClearType. -->
                                <Grid
                                    x:Name="CardRoot"
                                    behaviors:ModContextMenu.Mod="{Binding Mod}"
                                    Margin="0,0,16,16"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                    behaviors:CardHover.Enabled="True">
                                    <Grid.RenderTransform>
                                        <TranslateTransform Y="0" />
                                    </Grid.RenderTransform>


                                    <!-- Starts this card's dependency lookup once the card is near the
                                         view, as upstream's badge on the card did. The badge in the
                                         popup above cannot: a ToolTip's content gets no DataContext
                                         until it opens, and the "Has dependencies" filter only knows
                                         the mods that have been looked up. Near the view only, so a
                                         long scroll does not ask sp-mod.com about every card it
                                         passes - see DependencyBadgeLoader's pacing. Zero size. -->
                                    <FrameworkElement
                                        Width="0"
                                        Height="0"
                                        IsHitTestVisible="False"
                                        behaviors:DependencyBadgeLoader.Mod="{Binding NearViewMod}" />

                                    <!-- Two shadow layers, swapped by the hover trigger: a trigger
                                         cannot reach into an Effect by name. -->
                                    <Border x:Name="Shadow" Background="#1B1D21">
                                        <Border.CacheMode>
                                            <BitmapCache />
                                        </Border.CacheMode>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" Direction="315" Opacity="0.58" ShadowDepth="1.4" Color="Black" />
                                        </Border.Effect>
                                    </Border>
                                    <Border x:Name="Glow" Background="#1B1D21" Visibility="Hidden">
                                        <Border.CacheMode>
                                            <BitmapCache />
                                        </Border.CacheMode>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" Direction="315" Opacity="0.25" ShadowDepth="1.4" Color="White" />
                                        </Border.Effect>
                                    </Border>

                                    <!-- Drawn once into a bitmap and reused while the page scrolls; ClearType
                                         kept, which the card's opaque background allows. -->
                                    <Border Background="{StaticResource SteamCardBackground}">
                                        <Border.CacheMode>
                                            <BitmapCache EnableClearType="True" SnapsToDevicePixels="True" />
                                        </Border.CacheMode>
                                        <StackPanel>
                                            <!-- The square preview, #070707 behind the image. -->
                                            <Grid
                                                Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                                                Background="{StaticResource SteamPreviewBackground}"
                                                ClipToBounds="True">
                                                <Image Stretch="UniformToFill" behaviors:ThumbnailLoader.DecodeWidth="245" behaviors:ThumbnailLoader.Source="{Binding ShownThumbnail}" />

                                                <!-- Installed / update / disabled, and the pin, over the
                                                     preview's corner. Not Steam's - Steam's page knows
                                                     nothing about what is on this disk - but it is the
                                                     one thing a mod manager's grid must still say. -->
                                                <Border
                                                    Margin="6"
                                                    Padding="4,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="#CC000000"
                                                    CornerRadius="2"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource TrueToVisible}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon
                                                            FontSize="16"
                                                            Symbol="{Binding StatusGlyph}"
                                                            Style="{StaticResource StatusIcon}"
                                                            ToolTip="{Binding StatusTooltip}" />
                                                        <ui:SymbolIcon
                                                            Margin="4,0,0,0"
                                                            FontSize="14"
                                                            Foreground="{StaticResource SteamLegacyBlue}"
                                                            Symbol="Pin24"
                                                            ToolTip="{loc:Str Common_PinnedToolTip}"
                                                            Visibility="{Binding IsPinned, Converter={StaticResource TrueToVisible}}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <Grid Height="78" Margin="10,0">
                                                <StackPanel>
                                                    <!-- Where Steam's stars sit: what sp-mod.com counts. -->
                                                    <StackPanel Height="16" Margin="0,10,0,0" Orientation="Horizontal" TextElement.Foreground="{StaticResource SteamBlue}">
                                                        <StackPanel
                                                            Margin="0,0,10,0"
                                                            Orientation="Horizontal"
                                                            Visibility="{Binding Endorsements, Converter={StaticResource NullToCollapsed}}">
                                                            <StackPanel.ToolTip>
                                                                <ToolTip>
                                                                    <TextBlock Text="{Binding EndorsementsText}" />
                                                                </ToolTip>
                                                            </StackPanel.ToolTip>
                                                            <ui:SymbolIcon FontSize="15" Filled="True" Foreground="{StaticResource SteamBlue}" Symbol="ThumbLike16" />
                                                            <TextBlock Margin="3,0,0,0" FontSize="12" Foreground="{StaticResource SteamBlue}" Text="{Binding Endorsements, StringFormat=N0}" />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Margin="0,0,10,0"
                                                            Orientation="Horizontal"
                                                            Visibility="{Binding Favourites, Converter={StaticResource NullToCollapsed}}">
                                                            <StackPanel.ToolTip>
                                                                <ToolTip>
                                                                    <TextBlock Text="{Binding Favourites, StringFormat={loc:Str Workshop_FavouritesFormat}}" />
                                                                </ToolTip>
                                                            </StackPanel.ToolTip>
                                                            <ui:SymbolIcon FontSize="15" Filled="True" Foreground="{StaticResource SteamBlue}" Symbol="Star16" />
                                                            <TextBlock Margin="3,0,0,0" FontSize="12" Foreground="{StaticResource SteamBlue}" Text="{Binding Favourites, StringFormat=N0}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.ToolTip>
                                                                <ToolTip>
                                                                    <TextBlock Text="{Binding Downloads, StringFormat={loc:Str Common_DownloadsFormat}}" />
                                                                </ToolTip>
                                                            </StackPanel.ToolTip>
                                                            <ui:SymbolIcon FontSize="15" Foreground="{StaticResource SteamBlue}" Symbol="ArrowDownload16" />
                                                            <TextBlock Margin="3,0,0,0" FontSize="12" Foreground="{StaticResource SteamBlue}" Text="{Binding Downloads, StringFormat=N0}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="17"
                                                        Foreground="{StaticResource SteamWhite}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="12"
                                                        Foreground="{StaticResource SteamAuthorText}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Text="{Binding Author, StringFormat={loc:Str Browse_ByAuthorFormat}}"
                                                        Visibility="{Binding Author, Converter={StaticResource NullToCollapsed}}" />
                                                </StackPanel>

                                                <!-- Steam's Quick View magnifier, and beside it the
                                                     app's quick Subscribe - see SteamStyles. -->
                                                <Button
                                                    x:Name="QuickViewButton"
                                                    Margin="0,0,-4,5"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Style="{StaticResource SteamQuickViewButton}"
                                                    Click="QuickView_Click" />
                                                <Button
                                                    x:Name="QuickSubscribe"
                                                    Margin="0,0,32,8"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Style="{StaticResource SteamQuickSubscribeButton}"
                                                    Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding InstallToolTip, Source={x:Static app:AppServices.ModPageGate}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <!-- Steam's hover: the card lifts 5px and its shadow turns into
                                         a faint white glow. -->
                                    <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-5" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                        <Setter TargetName="Shadow" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="QuickViewButton" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True" />
                                            <Condition Binding="{Binding IsInstalled}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="QuickSubscribe" Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        Startup panel, over the results area and only on the first load of a session.
                        Before this the window opened and sat empty while the catalog loaded; on a
                        first run, with no cache, that is a long silence while ~3000 mods are fetched
                        a page at a time.
                    -->
                    <Border
                        Background="{StaticResource SteamWorkshopBackground}"
                        Visibility="{Binding IsStartingUp, Converter={StaticResource TrueToVisible}}">
                        <StackPanel Margin="0,80,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <ui:ProgressRing
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                IsIndeterminate="True" />
                            <TextBlock
                                Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource SteamWhite}"
                                Text="{Binding StartupStage}" />
                            <!-- One sentence, not four Runs: "of" and "mods" were fragments no
                                 translator could place. Only a live fetch knows a total. -->
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource SteamText}"
                                Visibility="{Binding TotalCount, Source={x:Static app:AppServices.ModCache}, Converter={StaticResource HasCount}}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{loc:Str Browse_StartupProgressFormat}">
                                        <Binding Mode="OneWay" Path="LoadedCount" Source="{x:Static app:AppServices.ModCache}" />
                                        <Binding Mode="OneWay" Path="TotalCount" Source="{x:Static app:AppServices.ModCache}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock
                                MaxWidth="380"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource SteamTextDim}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="{loc:Str Browse_FirstLaunchNote}"
                                Visibility="{Binding TotalCount, Source={x:Static app:AppServices.ModCache}, Converter={StaticResource HasCount}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- The infinite list's foot: shown while there are cards still to add as the page nears its end. -->
            <TextBlock
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="{StaticResource SteamTextDim}"
                Text="{loc:Str Workshop_LoadingMore}"
                Visibility="{Binding HasMore, Converter={StaticResource TrueToVisible}}" />

            <!-- "Per page: [30]  < 1 2 3 ... 1,000 >", right-aligned under the grid. -->
            <StackPanel Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource SteamText}" Text="{loc:Str Workshop_PerPage}" />
                <ComboBox
                    MinWidth="60"
                    Margin="6,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    ToolTip="{loc:Str Common_PageSizeToolTip}"
                    ItemsSource="{Binding PageSizeOptions}"
                    SelectedItem="{Binding PageSize}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PageSizeLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <!-- The pager itself; the infinite list has no pages to step through. -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsInfinite, Converter={StaticResource FalseToVisible}}">
                <Button Style="{StaticResource PagerArrow}" Command="{Binding PreviousPageCommand}" ToolTip="{loc:Str Common_Previous}">
                    <Path Width="14" Height="10" Data="M5,0 L0,5 L5,10 M0,5 L14,5" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" />
                </Button>
                <ItemsControl Focusable="False" Margin="6,0" VerticalAlignment="Center" ItemsSource="{Binding PageLinks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Style="{StaticResource PageNumber}"
                                Command="{Binding DataContext.GoToPageNumberCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding Number}">
                                <TextBlock Text="{Binding Text}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource PagerArrow}" Command="{Binding NextPageCommand}" ToolTip="{loc:Str Common_Next}">
                    <Path Width="14" Height="10" Data="M9,0 L14,5 L9,10 M0,5 L14,5" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" />
                </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
