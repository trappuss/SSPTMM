<local:SteamModalWindow
    Title="{loc:Str ModListVersionChange_Title}"
    x:Class="TCFModManager.App.Views.ModListVersionChangeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TCFModManager.App.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Width="480"
    SizeToContent="Height">
    <!--
        Shown when a mod list names a version that is no longer published on sp-mod.com. One row per
        mod, ticked by default, so the substitution is visible and reversible rather than silent.
        Same plain-modal-FluentWindow shape as ReadModPageConfirmationWindow.
    -->
    <!-- Fork (1.3.0): a long list scrolls; the buttons stay on screen. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                TextWrapping="Wrap"
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{loc:Str ModListVersionChange_Intro}" />

            <ScrollViewer Grid.Row="1" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
            <ItemsControl Focusable="False" x:Name="ChangesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,8" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    IsChecked="{Binding IsAccepted, Mode=TwoWay}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        TextWrapping="Wrap"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        TextWrapping="Wrap"
                                        Margin="0,3,0,0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Detail}" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Style="{StaticResource SteamModalGreyButton}"
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{loc:Str Common_Cancel}"
                    Click="CancelButton_Click" />

                <Button
                    Style="{StaticResource SteamModalGreenButton}"
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{loc:Str Common_Continue}"
                    Click="ContinueButton_Click" />
            </Grid>
    </Grid>
</local:SteamModalWindow>
