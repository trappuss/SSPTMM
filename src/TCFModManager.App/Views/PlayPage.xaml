<Page
    x:Class="TCFModManager.App.Views.PlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:views="clr-namespace:TCFModManager.App.Views"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:app="clr-namespace:TCFModManager.App"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    Title="{loc:Str Nav_Play}">
    <Page.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:FalseToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
    </Page.Resources>
    <StackPanel Margin="24,16,24,16">

        <!-- Conflicts in this install (OPEN-11 R4): shown only when there are any, and never a gate. -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,0,0,16"
            Visibility="{Binding ConflictWarning, Converter={StaticResource NullToCollapsed}}">
            <StackPanel>
                <ui:Button
                    Padding="0"
                    Appearance="Transparent"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Icon="{ui:SymbolIcon ErrorCircle20}"
                    Content="{Binding ConflictWarning}"
                    Command="{Binding ShowConflictsCommand}" />
                <TextBlock
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{loc:Str Play_ConflictsHint}" />
            </StackPanel>
        </ui:Card>

        <!--
            The pre-launch check, above the buttons because that is the order it matters in.
            Hidden entirely unless a server is set up, so an install that plays alone never sees it.

            It never blocks a launch. It replaces a BepInEx plugin that spoke at the splash screen -
            the honest moment, seconds before joining - and the reason that plugin was dropped was
            containment, not that warning people was wrong. What it must not become is a gate: the
            mods it compares may not matter, the server may be wrong, and a raid held up by a
            warning nobody can override is worse than a version mismatch.
        -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,0,0,16"
            DataContext="{x:Static app:AppServices.PreLaunchCheck}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon
                        Symbol="Connected20"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Title}" />
                    <ProgressBar
                        Width="60"
                        Height="4"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Message}" />

                <!-- Named, not counted. "Three mods behind" is not something anyone can act on;
                     the names are, and they are what you check against what the server runs. -->
                <TextBlock
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding Outstanding}"
                    Visibility="{Binding HasOutstanding, Converter={StaticResource BoolToVisibility}}" />

                <!-- Review and install only when behind a list a server served: it opens Mod lists
                     with that list previewed, and installing is still the Apply there. -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button
                        Appearance="Primary"
                        Margin="0,0,8,0"
                        Content="{loc:Str Common_ReviewAndInstall}"
                        Icon="{ui:SymbolIcon ArrowDownload24}"
                        ToolTip="{loc:Str Common_ReviewAndInstallToolTip}"
                        Command="{Binding ReviewCommand}"
                        Visibility="{Binding CanReview, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button
                        Content="{loc:Str Play_CheckAgain}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        Command="{Binding CheckCommand}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Play_ServerHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8">
                    <!-- Fork (UI tidy-up 3): one line on show, the rest behind the "?". -->
                    <Run Text="{Binding ServerSummary, Mode=OneWay}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{Binding ServerDescription}" /></InlineUIContainer>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button
                        Appearance="Primary"
                        Content="{loc:Str Play_StartServer}"
                        Icon="{ui:SymbolIcon Play24}"
                        IsEnabled="{Binding CanStartServer}"
                        Command="{Binding StartServerCommand}"
                        Visibility="{Binding IsServerRunning, Converter={StaticResource InverseBoolToVisibility}}" />
                    <!-- While the server is up: stop it, red, asked about on the card first. -->
                    <ui:Button
                        Appearance="Danger"
                        Content="{loc:Str Play_StopServer}"
                        Icon="{ui:SymbolIcon Stop24}"
                        ToolTip="{loc:Str Play_StopServerToolTip}"
                        Command="{Binding AskStopServerCommand}"
                        Visibility="{Binding IsServerRunning, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="{loc:Str Play_Restart}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        ToolTip="{loc:Str Play_RestartServerToolTip}"
                        Command="{Binding AskRestartServerCommand}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ServerState}" />
                </StackPanel>

                <!-- Asked on the card, not in a dialog: the warning is about the thing the card is
                     describing. Asked at all because a raid in progress does not survive it. -->
                <StackPanel
                    Margin="0,0,0,8"
                    Visibility="{Binding ConfirmingServerRestart, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{loc:Str Play_RestartServerWarning}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Appearance="Danger"
                            Content="{loc:Str Play_RestartServerConfirm}"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Command="{Binding ConfirmRestartCommand}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Transparent"
                            Content="{loc:Str Common_Cancel}"
                            Command="{Binding CancelRestartCommand}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Margin="0,0,0,8"
                    Visibility="{Binding ConfirmingServerStop, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{loc:Str Play_StopServerWarning}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Appearance="Danger"
                            Content="{loc:Str Play_StopServerConfirm}"
                            Icon="{ui:SymbolIcon Stop24}"
                            Command="{Binding ConfirmStopServerCommand}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Transparent"
                            Content="{loc:Str Common_Cancel}"
                            Command="{Binding CancelStopServerCommand}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding ServerPath}" />

                <!-- What the server logs, read from its log file - its own window is untouched. -->
                <Expander Margin="0,8,0,0" Header="{loc:Str Play_ServerLog}" IsExpanded="{Binding ShowServerLog}">
                    <StackPanel Margin="0,8,0,0">
                        <TextBox
                            x:Name="ServerLogBox"
                            Height="280"
                            IsReadOnly="True"
                            FontFamily="Consolas, Courier New"
                            FontSize="11"
                            TextWrapping="NoWrap"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Text="{Binding ServerLogText, Mode=OneWay}"
                            TextChanged="ServerLogBox_TextChanged"
                            ScrollViewer.ScrollChanged="ServerLogBox_ScrollChanged" />
                        <DockPanel Margin="0,6,0,0">
                            <ui:Button
                                DockPanel.Dock="Right"
                                Content="{loc:Str Play_ServerLogOpenFolder}"
                                Command="{Binding OpenServerLogFolderCommand}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding ServerLogPath}" />
                        </DockPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Play_LauncherHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8">
                    <Run Text="{loc:Str Play_LauncherSummary}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Play_LauncherDescription}" /></InlineUIContainer>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button
                        Appearance="Primary"
                        Content="{loc:Str Play_OpenLauncher}"
                        Icon="{ui:SymbolIcon Play24}"
                        IsEnabled="{Binding CanStartClient}"
                        Command="{Binding StartClientCommand}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ClientState}" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding ClientPath}" />
            </StackPanel>
        </ui:Card>

        <!-- Only an install running a headless client has this launcher - or has been told in
             Options that it is one - so the card is off the page entirely on every other one
             rather than showing a dead button. -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Visibility="{Binding HasHeadless, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Play_HeadlessHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8">
                    <Run Text="{loc:Str Play_HeadlessSummary}" /><InlineUIContainer BaselineAlignment="Center"><views:InfoTip Text="{loc:Str Play_HeadlessDescription}" /></InlineUIContainer>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button
                        Content="{loc:Str Play_OpenHeadless}"
                        Icon="{ui:SymbolIcon Play24}"
                        IsEnabled="{Binding CanStartHeadless}"
                        Command="{Binding StartHeadlessCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="{loc:Str Play_Restart}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        ToolTip="{loc:Str Play_RestartHeadlessToolTip}"
                        Command="{Binding AskRestartHeadlessCommand}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding HeadlessState}" />
                </StackPanel>

                <StackPanel
                    Margin="0,0,0,8"
                    Visibility="{Binding ConfirmingHeadlessRestart, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{loc:Str Play_RestartHeadlessWarning}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Appearance="Danger"
                            Content="{loc:Str Play_RestartHeadlessConfirm}"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Command="{Binding ConfirmRestartCommand}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Transparent"
                            Content="{loc:Str Common_Cancel}"
                            Command="{Binding CancelRestartCommand}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding HeadlessPath}" />

                <!-- What Options has been told this machine is, since that is what decides which
                     mods a served list brings here. Blank, and so zero height, on an install that
                     has not said. -->
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,8,0,0"
                    Text="{Binding RoleSummary}" />

                <!--
                    The launcher is here but nobody has answered the question, so a served list is
                    being filtered as though this were an ordinary player.
                    The setup prompt fires when the install folder is set, which somebody who set
                    theirs months ago will never do again - this is how they find out there is
                    something to answer.
                -->
                <ui:InfoBar
                    Margin="0,12,0,0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="{loc:Str Play_RoleNoticeTitle}"
                    Message="{loc:Str Play_RoleNoticeMessage}"
                    Visibility="{Binding NeedsRoleAnswer, Converter={StaticResource BoolToVisibility}}" />
                <!-- The answer to the notice above, in Help (Help S5). -->
                <ui:Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Content="{loc:Str Help_ShowMeHow}"
                    Icon="{ui:SymbolIcon BookQuestionMark24}"
                    Click="RoleShowMeHow_Click"
                    Visibility="{Binding NeedsRoleAnswer, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ui:Card>

        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                TextWrapping="Wrap"
                Style="{StaticResource ErrorText}"
                Text="{Binding Message}" />
        </ui:Card>

    </StackPanel>
</Page>
