<!--
    Steam's downloads bar along the bottom of its window: what is downloading or installing now, how
    far the queue is, and "Manage" to open Downloads - which is no longer a tab of its own.

    HUNCH: Steam's bar is part of the Steam client, not of a web page, so nothing here could be
    measured. 40px high on #171A21 (the client's darkest grey) under a 1px black line, the title in
    11px small capitals at #8F98A0, the line under it 12px at #DCDEDF, a 3px #1A9FFF progress bar -
    all chosen to sit with the Workshop palette, not read off Steam.
-->
<UserControl
    x:Class="TCFModManager.App.Views.DownloadsBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:TCFModManager.App"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    DataContext="{x:Static app:AppServices.DownloadQueue}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <!-- Stretch both ways explicitly: the theme's own Button style aligns buttons to the left. -->
    <Button
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Cursor="Hand"
        FocusVisualStyle="{x:Null}"
        ToolTip="{loc:Str Downloads_BarToolTip}"
        Click="Bar_Click">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Face" Height="40" HorizontalAlignment="Stretch" Background="#171A21" BorderBrush="Black" BorderThickness="0,1,0,0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Face" Property="Background" Value="#1F242D" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="#8F98A0"
                Text="{Binding BarTitle}" />
            <TextBlock
                x:Name="Detail"
                Margin="0,1,0,0"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="#DCDEDF"
                TextTrimming="CharacterEllipsis"
                Text="{Binding BarDetail}" />
            <!-- Only while there is something to show progress for. -->
            <ProgressBar
                Width="260"
                Height="3"
                Margin="0,3,0,0"
                Minimum="0"
                Maximum="1"
                Foreground="{StaticResource SteamBlue}"
                Background="#33FFFFFF"
                BorderThickness="0"
                Value="{Binding BarFraction, Mode=OneWay}"
                Visibility="{Binding BarActive, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Button>
</UserControl>
