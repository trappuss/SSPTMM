<!-- ScrollViewer.CanContentScroll="False" opts this page out of WPF-UI's automatic outer
     DynamicScrollViewer: the ScrollViewer below is the page's own, and the wrapper only fights it.
     Background="Transparent" on the root Grid is the other half - a Grid with no Background only
     takes part in hit-testing where a child paints.

     Every TextBlock sets its Foreground from a DynamicResource brush, and de-emphasis is a
     Secondary/Tertiary brush rather than Opacity. -->
<Page
    x:Class="TCFModManager.App.Views.FootprintPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    Title="{loc:Str Nav_Footprint}"
    Loaded="FootprintPage_Loaded"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            One tint per resource an area can name, so a column of findings is scannable instead of
            a stack of identical grey chips.

            Fixed colours rather than theme brushes, at a low opacity, so each one blends into
            whatever surface is behind it - the same reason RowHoverBrush works in both themes. The
            text on top stays a theme brush, so contrast is never this palette's problem.

            THESE ARE CATEGORIES, NOT A SCALE. There is no red, nothing is ordered, and green sits
            on Start-up while amber sits on Disk precisely so the set cannot be read as a traffic
            light. A severity palette here would be the grade this page deliberately does not give
            - see the footprint notes on why the levels exist in code and are never shown.
        -->
        <SolidColorBrush x:Key="FootprintCpuTint" Color="#3B82F6" Opacity="0.22" />
        <SolidColorBrush x:Key="FootprintGpuTint" Color="#8B5CF6" Opacity="0.22" />
        <SolidColorBrush x:Key="FootprintMemoryTint" Color="#14B8A6" Opacity="0.22" />
        <SolidColorBrush x:Key="FootprintStartupTint" Color="#16A34A" Opacity="0.22" />
        <SolidColorBrush x:Key="FootprintDiskTint" Color="#D97706" Opacity="0.22" />

        <!--
            Client and Server on their own name a side and no resource, so they get no hue - but
            they still get a fill. Left on Secondary they came out as a white box with a grey
            outline in light mode, reading as an empty text field beside five filled pills rather
            than as a deliberate neutral. Grey at the same strength as the colours says "a chip,
            naming no particular resource", which is what they mean.
        -->
        <SolidColorBrush x:Key="FootprintNeutralTint" Color="#6B7280" Opacity="0.22" />

        <!--
            Appearance is Primary on every chip on purpose. Badge's own template sets the Border's
            background from a trigger for every appearance EXCEPT Primary, and a template trigger
            outranks anything set from out here - so Secondary would quietly win and the tint would
            never show. Primary has no such trigger, so Background flows through.

            THE TEXT COLOUR CANNOT BE SET FROM HERE. Badge's default style has its own trigger for
            Primary that sets Foreground to BadgeForeground, and a trigger in the base style beats a
            setter in a derived one whatever this file says - which pinned the label to the badge's
            colour instead of the theme's, leaving it dark on a dark card. The chip's content is
            therefore a TextBlock carrying its own Foreground, which nothing in the template can
            reach. Same rule as everywhere else in this app: a TextBlock states its own colour.
        -->
        <Style x:Key="FootprintAreaBadge" TargetType="ui:Badge" BasedOn="{StaticResource {x:Type ui:Badge}}">
            <!-- Primary for every chip, coloured or not, for the template-trigger reason above:
                 any other appearance and the Border's own trigger would overwrite the fill. -->
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="Background" Value="{StaticResource FootprintNeutralTint}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Resource}" Value="CPU">
                    <Setter Property="Background" Value="{StaticResource FootprintCpuTint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Resource}" Value="GPU">
                    <Setter Property="Background" Value="{StaticResource FootprintGpuTint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Resource}" Value="Memory">
                    <Setter Property="Background" Value="{StaticResource FootprintMemoryTint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Resource}" Value="Start-up">
                    <Setter Property="Background" Value="{StaticResource FootprintStartupTint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Resource}" Value="Disk">
                    <Setter Property="Background" Value="{StaticResource FootprintDiskTint}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        Margin="24,16,24,16"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <ui:Button
                DockPanel.Dock="Left"
                Appearance="Primary"
                Icon="{ui:SymbolIcon ArrowSync24}"
                Content="{loc:Str Common_Rescan}"
                IsEnabled="{Binding IsIdle}"
                Command="{Binding RescanCommand}" />

            <ui:ProgressRing
                DockPanel.Dock="Left"
                Width="20"
                Height="20"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <TextBlock
                DockPanel.Dock="Left"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Status}" />

            <ComboBox
                DockPanel.Dock="Right"
                MinWidth="220"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSort}" />

            <TextBlock
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{loc:Str Footprint_SortByLabel}" />
        </DockPanel>

        <!--
            The caveat is part of the feature, not decoration. Everything here is read from what a
            mod ships on disk, and a user who reads these levels as measured frame cost has been
            misled by the page rather than by the numbers.
        -->
        <ui:Card Grid.Row="1" Margin="0,16,0,0" Padding="16">
            <StackPanel>
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{loc:Str Footprint_WhatThisReadsHeader}" />
                <TextBlock
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{loc:Str Footprint_WhatThisReadsBody}" />
            </StackPanel>
        </ui:Card>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock
                Margin="4,8,0,0"
                TextWrapping="Wrap"
                VerticalAlignment="Top"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{loc:Str Footprint_Empty}"
                Visibility="{Binding HasRows, Converter={StaticResource FalseToVisible}}" />

            <ScrollViewer
                x:Name="RowsScrollViewer"
                Focusable="False"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                <ItemsControl Focusable="False" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Same shape as the Dependencies page's trees: the header is the
                                 summary, and opening it shows the breakdown. -->
                            <ui:CardExpander
                                Style="{StaticResource HoverCardExpander}"
                                Margin="0,0,0,8"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                <!-- No summary badge, by design. The counts below are checkable
                                     facts; a one-word grade on somebody else's mod is not, and it
                                     is the part that would travel without its explanation. -->
                                <ui:CardExpander.Header>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Title}" />

                                        <TextBlock
                                            Margin="0,3,0,0"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Detail}" />
                                    </StackPanel>
                                </ui:CardExpander.Header>

                                <StackPanel>
                                    <ItemsControl
                                        Focusable="False"
                                        Grid.IsSharedSizeScope="True"
                                        ItemsSource="{Binding Findings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource HoverRow}" Padding="10,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <!-- Shared so every finding's wording
                                                                 starts on the same line down the
                                                                 card, rather than stepping in and
                                                                 out with the length of each area
                                                                 label - and so a translation
                                                                 longer than 120px widens the whole
                                                                 column instead of one badge. -->
                                                            <ColumnDefinition
                                                                Width="Auto"
                                                                SharedSizeGroup="FootprintArea" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <ui:Badge
                                                            Grid.Column="0"
                                                            MinWidth="120"
                                                            Margin="0,0,12,0"
                                                            VerticalAlignment="Top"
                                                            HorizontalContentAlignment="Center"
                                                            Style="{StaticResource FootprintAreaBadge}">
                                                            <!-- The label states its own colour, so
                                                                 it follows the theme rather than
                                                                 the badge - see the style above. -->
                                                            <TextBlock
                                                                FontSize="11"
                                                                TextAlignment="Center"
                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                Text="{Binding Area}" />
                                                        </ui:Badge>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock
                                                                TextWrapping="Wrap"
                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                Text="{Binding What}" />
                                                            <TextBlock
                                                                Margin="0,3,0,0"
                                                                TextWrapping="Wrap"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding Effect}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock
                                        Margin="10,10,0,0"
                                        TextWrapping="Wrap"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding PerFrameTooltip}"
                                        Visibility="{Binding HasPerFrameTooltip, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
