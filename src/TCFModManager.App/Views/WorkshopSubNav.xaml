<!--
    The Workshop's own navigation strip, under the banner on Steam: Home, Browse, and Your Items.
    Browse and Your Items each open a menu under the pointer, as Steam's do: Browse's has the items'
    sort orders and the collections', and a click on Browse itself goes to the items. Your Items
    goes nowhere itself; a click opens its menu too.

    47px high on rgba(0,0,0,.37), 15px white labels with 10px padding, the first one 20px in, and a
    2px white bar under the current page - all measured off steamcommunity.com. Steam's strip also
    carries Discussions and About, which have nothing behind them in this app and are left out
    rather than shown as dead links.

    Which entry is lit comes from AppNavigation, not from the clicks: the page can change from
    somewhere else (a card, the update banner), and this strip has to follow it either way.
-->
<UserControl
    x:Class="TCFModManager.App.Views.WorkshopSubNav"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization">
    <Border Height="47" Background="{StaticResource SteamSubNavStrip}">
        <StackPanel Margin="20,0,0,0" Orientation="Horizontal">
            <ToggleButton
                x:Name="HomeTab"
                Style="{StaticResource SteamSubNavItem}"
                Click="HomeTab_Click">
                <TextBlock Text="{loc:Str Workshop_Home}" />
            </ToggleButton>

            <ToggleButton
                x:Name="BrowseTab"
                Style="{StaticResource SteamSubNavItem}"
                Click="BrowseTab_Click"
                MouseEnter="Menu_MouseEnter"
                MouseLeave="Menu_MouseLeave">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Str Nav_Browse}" />
                    <Path Style="{StaticResource SteamDropTriangle}" />
                </StackPanel>
            </ToggleButton>

            <!-- Steam's Browse menu: two columns, the items' sort orders and the collections'. -->
            <Popup
                x:Name="BrowsePopup"
                AllowsTransparency="True"
                HorizontalOffset="-10"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=BrowseTab}"
                StaysOpen="True"
                Closed="Popup_Closed">
                <Border
                    x:Name="BrowsePanel"
                    Margin="10,0,10,10"
                    Background="Transparent"
                    MouseLeave="Menu_MouseLeave">
                    <Border Style="{StaticResource SteamYourItemsPanel}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel MinWidth="155" Margin="0,0,20,0">
                                <TextBlock Style="{StaticResource SteamYourItemsHeader}" Text="{loc:Str Workshop_BrowseModsHeader}" />
                                <Button Style="{StaticResource SteamYourItemsEntry}" Content="{loc:Str Sort_BrowseMostEndorsed}" Tag="MostEndorsed" Click="BrowseMods_Click" />
                                <Button Style="{StaticResource SteamYourItemsEntry}" Content="{loc:Str Sort_BrowseNewest}" Tag="Newest" Click="BrowseMods_Click" />
                                <Button Margin="0" Style="{StaticResource SteamYourItemsEntry}" Content="{loc:Str Sort_BrowseLastUpdated}" Tag="LastUpdated" Click="BrowseMods_Click" />
                            </StackPanel>
                            <StackPanel MinWidth="130">
                                <TextBlock Style="{StaticResource SteamYourItemsHeader}" Text="{loc:Str Workshop_BrowseCollectionsHeader}" />
                                <Button Margin="0" Style="{StaticResource SteamYourItemsEntry}" Content="{loc:Str Collections_SortMostRecent}" Click="BrowseCollections_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Popup>

            <ToggleButton
                x:Name="YourItemsTab"
                Style="{StaticResource SteamSubNavItem}"
                Click="YourItemsTab_Click"
                MouseEnter="Menu_MouseEnter"
                MouseLeave="Menu_MouseLeave">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Str Workshop_YourItems}" />
                    <Path Style="{StaticResource SteamDropTriangle}" />
                </StackPanel>
            </ToggleButton>

            <Popup
                x:Name="YourItemsPopup"
                AllowsTransparency="True"
                HorizontalOffset="-10"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=YourItemsTab}"
                StaysOpen="True"
                Closed="Popup_Closed">
                <!-- The margin leaves room for the shadow, which falls on every side, inside the
                     popup's own surface; the offset keeps the panel's edge under the tab's. The
                     transparent border around it keeps the pointer "in the menu" across that room. -->
                <Border x:Name="YourItemsPanel" Background="Transparent" MouseLeave="Menu_MouseLeave">
                <Border Margin="10,0,10,10" MinWidth="220" Style="{StaticResource SteamYourItemsPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SteamYourItemsHeader}" Text="{loc:Str Workshop_YourItemsHeader}" />
                        <Button Style="{StaticResource SteamYourItemsEntry}" Content="{loc:Str Workshop_SubscribedItems}" Click="SubscribedItems_Click" />
                        <Button Style="{StaticResource SteamYourItemsEntry}" Content="{loc:Str Workshop_YourCollections}" Click="YourCollections_Click" />
                        <Button Margin="0" Style="{StaticResource SteamYourItemsEntry}" Content="{loc:Str FollowedAuthors_Title}" Click="FollowedAuthors_Click" />
                    </StackPanel>
                </Border>
                </Border>
            </Popup>
        </StackPanel>
    </Border>
</UserControl>
