<!--
    The Workshop's own navigation strip, under the banner on Steam: Home, Browse, and Your Items,
    which opens a small menu rather than going anywhere itself.

    47px high on rgba(0,0,0,.37), 15px white labels with 10px padding, the first one 20px in, and a
    2px white bar under the current page - all measured off steamcommunity.com. Steam's strip also
    carries Discussions and About, which have nothing behind them in this app and are left out
    rather than shown as dead links.

    Which entry is lit comes from AppNavigation, not from the clicks: the page can change from
    somewhere else (a card, the update banner), and this strip has to follow it either way.
-->
<UserControl
    x:Class="TCFModManager.App.Views.WorkshopSubNav"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization">
    <Border Height="47" Background="{StaticResource SteamSubNavStrip}">
        <StackPanel Margin="20,0,0,0" Orientation="Horizontal">
            <ToggleButton
                x:Name="HomeTab"
                Style="{StaticResource SteamSubNavItem}"
                Click="HomeTab_Click">
                <TextBlock Text="{loc:Str Workshop_Home}" />
            </ToggleButton>

            <ToggleButton
                x:Name="BrowseTab"
                Style="{StaticResource SteamSubNavItem}"
                Click="BrowseTab_Click">
                <TextBlock Text="{loc:Str Nav_Browse}" />
            </ToggleButton>

            <ToggleButton
                x:Name="YourItemsTab"
                Style="{StaticResource SteamSubNavItem}"
                Click="YourItemsTab_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Str Workshop_YourItems}" />
                    <Path Style="{StaticResource SteamDropTriangle}" />
                </StackPanel>
            </ToggleButton>

            <Popup
                x:Name="YourItemsPopup"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=YourItemsTab}"
                StaysOpen="False"
                Closed="YourItemsPopup_Closed">
                <!-- The margin leaves room for the drop shadow inside the popup's own surface. -->
                <Border Margin="0,0,12,12" MinWidth="220" Style="{StaticResource SteamMenuPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SteamMenuHeader}" Text="{loc:Str Workshop_YourItemsHeader}" />
                        <Button Style="{StaticResource SteamMenuItem}" Click="SubscribedItems_Click">
                            <TextBlock Text="{loc:Str Workshop_SubscribedItems}" />
                        </Button>
                        <Button Style="{StaticResource SteamMenuItem}" Click="YourCollections_Click">
                            <TextBlock Text="{loc:Str Workshop_YourCollections}" />
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>
    </Border>
</UserControl>
