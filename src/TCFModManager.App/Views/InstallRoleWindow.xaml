<local:SteamModalWindow
    Title="{loc:Str InstallRole_Title}"
    x:Class="TCFModManager.App.Views.InstallRoleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TCFModManager.App.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Width="560"
    SizeToContent="Height">
    <!--
        Asked once, when an install folder turns out to have a Fika headless launcher in it. Same
        plain modal FluentWindow pattern as ModDisableConfirmationWindow - ShowDialog() from the
        call site, the answer read back through a static Ask helper.

        Only ONE question is put, because only one of the two is unknowable. The launcher on disk
        already says this machine can host; nothing on disk can say whether anybody sits at it, and
        a headless install has SPT.Server.exe like any other.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="1"
            Margin="0">
            <TextBlock
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Margin="0,0,0,8"
                Text="{loc:Str InstallRole_Intro}" />

            <TextBlock
                x:Name="LauncherText"
                FontSize="11"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,16" />

            <TextBlock
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,16"
                Text="{loc:Str InstallRole_Explanation}" />

            <TextBlock
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                Foreground="White"
                Margin="0,0,0,16"
                Text="{loc:Str InstallRole_Question}" />

            <TextBlock
                FontSize="11"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,16"
                Text="{loc:Str InstallRole_Note}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button
                    Style="{StaticResource SteamModalGreyButton}"
                    Content="{loc:Str InstallRole_AskLater}"
                    Click="LaterButton_Click" />

                <Button
                    Style="{StaticResource SteamModalGreyButton}"
                    Content="{loc:Str InstallRole_OnlyHosts}"
                    ToolTip="{loc:Str InstallRole_OnlyHostsToolTip}"
                    Click="HostsOnlyButton_Click" />

                <!--
                    Primary on the answer that keeps everything, not on the one the launcher hints
                    at. Emphasis is also what Enter picks, and of the two ways to be wrong here, a
                    machine that quietly stops installing player mods is the one somebody has to
                    debug.
                -->
                <Button
                    Style="{StaticResource SteamModalGreenButton}"
                    Content="{loc:Str InstallRole_PlaysToo}"
                    ToolTip="{loc:Str InstallRole_PlaysTooToolTip}"
                    Click="PlaysHereButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</local:SteamModalWindow>
