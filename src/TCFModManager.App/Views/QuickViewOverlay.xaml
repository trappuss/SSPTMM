<!--
    Steam's Quick View (the magnifier on a Browse card), over the whole window.

    Measured on steamcommunity.com/workshop/browse (2026-09-25): the page behind darkened to about
    40% (a 60% black backdrop); the modal #23262E, 1150 wide, with a 0 0 10px 5px rgba(0,0,0,.75)
    shadow, 16px padding (8 at the bottom). Left: the picture 547x308 on black, then the strip of
    160x90 pictures 8px apart with a 40px rgba(0,0,0,.8) arrow over its right end. Right, 24px
    over: the title 24px bold white on 31px lines with the rating 15px at its right; "CREATED BY:"
    13px upper case, 1px letter spacing, #ACB2B8, the name rgba(255,255,255,.77); a box with a
    rgba(0,0,0,.28)-to-nothing gradient, 6px 10px padding, labels 13px upper case and values 12px in
    two columns; "TAGS" 13px upper case over chips #3D4450, white 12px, 1px 12px padding, 24 high,
    radius 2, 4 apart; the description 15px #ACB2B8 on 20px lines, cut after seven. The bottom bar
    #262B34 with 5px padding: 36px buttons, 13px white, radius 2, 1px 8px padding - Subscribe
    #80A006, the rest #3D4450. The close X white, 15px, above the modal's top right; the arrows
    46px white chevrons on 94x48 buttons at the window's edges, at 35% when there is nowhere to go.

    Steam's visitors, subscribers, votes, Favorite and awards have no sp-mod.com counterpart:
    Downloads and Favorites stand in the stats box, the endorsements where the stars are, and See
    More opens the item page.
-->
<UserControl
    x:Class="TCFModManager.App.Views.QuickViewOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:markup="clr-namespace:TCFModManager.App.Behaviors.Markup"
    Focusable="True"
    FocusVisualStyle="{x:Null}"
    FontFamily="{StaticResource SteamFont}"
    PreviewKeyDown="Overlay_KeyDown"
    PreviewMouseDown="Overlay_PreviewMouseDown">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:UpdateAvailableToVisibilityConverter x:Key="TrueToVisible" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <converters:EqualityConverter x:Key="IsSame" />

        <Style x:Key="QvLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#ACB2B8" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style x:Key="QvValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#ACB2B8" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The bottom bar's buttons. -->
        <Style x:Key="QvButton" TargetType="Button" BasedOn="{StaticResource SteamButton}">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <!-- Hover colour not measured (Steam's are disabled until signed in): HUNCH. -->
        <Style x:Key="QvGreenButton" TargetType="Button" BasedOn="{StaticResource QvButton}">
            <Setter Property="Background" Value="#80A006" />
            <Setter Property="Tag" Value="#8FB30A" />
        </Style>

        <!-- The arrows at the window's edges. -->
        <Style x:Key="QvStep" TargetType="Button">
            <Setter Property="Width" Value="94" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Face" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- The backdrop; a click on it closes, as on Steam. -->
        <Border Background="#99000000" MouseLeftButtonUp="Backdrop_Click" />

        <Button
            HorizontalAlignment="Left"
            Style="{StaticResource QvStep}"
            Command="{Binding PreviousCommand}"
            ToolTip="{loc:Str Common_Previous}">
            <Path Width="19" Height="30" Data="M19,0 L0,15 L19,30" Stretch="Fill" Stroke="White" StrokeThickness="4" />
        </Button>
        <Button
            HorizontalAlignment="Right"
            Style="{StaticResource QvStep}"
            Command="{Binding NextCommand}"
            ToolTip="{loc:Str Common_Next}">
            <Path Width="19" Height="30" Data="M0,0 L19,15 L0,30" Stretch="Fill" Stroke="White" StrokeThickness="4" />
        </Button>

        <Grid MaxWidth="1150" Margin="94,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The close X, above the top right. -->
            <Button
                Grid.Row="0"
                Width="23"
                Height="23"
                Margin="0,0,0,27"
                HorizontalAlignment="Right"
                Cursor="Hand"
                FocusVisualStyle="{x:Null}"
                ToolTip="{loc:Str Common_Close}"
                Click="Close_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Path Width="12" Height="12" Data="M0,0 L12,12 M12,0 L0,12" Stretch="Fill" Stroke="White" StrokeThickness="2.5" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Grid.Row="1" Background="#23262E" MouseLeftButtonUp="Modal_MouseLeftButtonUp">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.75" ShadowDepth="0" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="16,16,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- The pictures. -->
                        <StackPanel Grid.Column="0">
                            <Grid Height="308" Background="Black" ClipToBounds="True">
                                <!-- The listing's own picture until the details arrive. -->
                                <Image
                                    Stretch="Uniform"
                                    behaviors:ThumbnailLoader.DecodeWidth="547"
                                    behaviors:ThumbnailLoader.Source="{Binding Listing.Thumbnail}"
                                    Visibility="{Binding HasItem, Converter={StaticResource FalseToVisible}}" />
                                <!-- The chosen picture or video; a click opens it full size. -->
                                <markup:RemotePicture
                                    x:Name="PreviewPicture"
                                    Cursor="Hand"
                                    LimitToNaturalSize="False"
                                    Stretch="Uniform"
                                    Url="{Binding Item.SelectedMedia.Thumbnail}"
                                    MouseLeftButtonUp="Preview_MouseLeftButtonUp" />
                                <Grid Width="68" Height="48" IsHitTestVisible="False" Visibility="{Binding Item.SelectedIsVideo, Converter={StaticResource TrueToVisible}, FallbackValue=Collapsed}">
                                    <Border Background="#E6212121" CornerRadius="12" />
                                    <Path Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L18,11 L0,22 Z" Fill="White" />
                                </Grid>
                                <ui:ProgressRing
                                    Width="36"
                                    Height="36"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsLoading, Converter={StaticResource TrueToVisible}}" />
                            </Grid>

                            <Grid Margin="0,8,0,4" Visibility="{Binding Item.HasGallery, Converter={StaticResource TrueToVisible}, FallbackValue=Collapsed}">
                                <ScrollViewer
                                    x:Name="Strip"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Disabled"
                                    ScrollChanged="Strip_ScrollChanged">
                                    <ItemsControl ItemsSource="{Binding Item.Gallery}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    x:Name="Thumb"
                                                    Width="160"
                                                    Height="90"
                                                    Margin="0,0,8,0"
                                                    Background="Black"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="Thumb_MouseLeftButtonUp">
                                                    <Image Stretch="UniformToFill" behaviors:ThumbnailLoader.DecodeWidth="160" behaviors:ThumbnailLoader.Source="{Binding Thumbnail}" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource IsSame}">
                                                                <Binding />
                                                                <Binding Path="DataContext.Item.SelectedMedia" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter TargetName="Thumb" Property="BorderBrush" Value="White" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <!-- More to the right: a dark end with an arrow that pages the strip. -->
                                <Border
                                    x:Name="StripMore"
                                    Width="40"
                                    HorizontalAlignment="Right"
                                    Background="#CC000000"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    MouseLeftButtonUp="StripMore_Click">
                                    <Path Width="17" Height="26" Data="M0,0 L17,13 L0,26" Stretch="Fill" Stroke="#ACB2B8" StrokeThickness="3" />
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- The words. -->
                        <StackPanel Grid.Column="2">
                            <DockPanel>
                                <StackPanel Margin="12,4,0,0" DockPanel.Dock="Right" Visibility="{Binding Item.HasEndorsements, Converter={StaticResource TrueToVisible}, FallbackValue=Collapsed}">
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <ui:SymbolIcon FontSize="18" Filled="True" Foreground="#8BC53F" Symbol="ThumbLike20" />
                                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="#8BC53F" Text="{Binding Item.Endorsements, StringFormat=N0}" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" FontSize="15" Foreground="#ACB2B8" Text="{Binding Item.EndorsementsText}" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    LineHeight="31"
                                    LineStackingStrategy="BlockLineHeight"
                                    MaxHeight="62"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    Text="{Binding Listing.Name}" />
                            </DockPanel>

                            <TextBlock Margin="0,7,0,0" FontSize="13" Visibility="{Binding Listing.Owner.Name, Converter={StaticResource NullToCollapsed}, FallbackValue=Collapsed}">
                                <Run Foreground="#ACB2B8" Text="{loc:Str QuickView_CreatedBy}" />
                                <Hyperlink Foreground="#C5FFFFFF" TextDecorations="{x:Null}" Command="{Binding OpenAuthorCommand}">
                                    <Run Text="{Binding Listing.Owner.Name, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>

                            <!-- Posted / updated / size, and the counts. -->
                            <Border Margin="0,4,0,0" Padding="10,6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#47000000" />
                                        <GradientStop Offset="1" Color="#00000000" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" MinWidth="132" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="19" />
                                        <RowDefinition Height="19" />
                                        <RowDefinition Height="19" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource QvLabel}" Text="{loc:Str QuickView_Posted}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource QvValue}" Text="{Binding Item.PostedText, FallbackValue=''}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource QvLabel}" Text="{loc:Str QuickView_Updated}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource QvValue}" Text="{Binding Item.UpdatedText, FallbackValue=''}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource QvLabel}" Text="{loc:Str QuickView_FileSize}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource QvValue}" Text="{Binding Item.FileSize, FallbackValue=''}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource QvLabel}" Text="{loc:Str QuickView_Downloads}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource QvValue}" Text="{Binding Item.Downloads, StringFormat=N0, FallbackValue=''}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource QvLabel}" Text="{loc:Str QuickView_Favorites}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource QvValue}" Text="{Binding Item.Favourites, StringFormat=N0, FallbackValue=''}" />
                                </Grid>
                            </Border>

                            <StackPanel Margin="0,16,0,0" Visibility="{Binding HasTags, Converter={StaticResource TrueToVisible}}">
                                <TextBlock FontSize="13" Foreground="#ACB2B8" Text="{loc:Str QuickView_Tags}" />
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="24" Margin="0,0,4,4" Padding="12,1" Background="#3D4450" CornerRadius="2">
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="White" Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock
                                Margin="0,12,0,0"
                                MaxHeight="140"
                                FontSize="15"
                                Foreground="#ACB2B8"
                                LineHeight="20"
                                LineStackingStrategy="BlockLineHeight"
                                TextTrimming="WordEllipsis"
                                TextWrapping="Wrap"
                                Text="{Binding Description}" />

                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="13"
                                Foreground="{StaticResource SteamLegacyBlue}"
                                TextWrapping="Wrap"
                                Text="{Binding Message}"
                                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </Grid>

                    <!-- The bottom bar. -->
                    <Border Padding="5" Background="#262B34">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="0" Style="{StaticResource QvButton}" Command="{Binding SeeMoreCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Str QuickView_SeeMore}" />
                                    <ui:SymbolIcon Margin="6,0,0,0" FontSize="14" Symbol="ArrowRight16" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasItem}">
                                <Button Command="{Binding ToggleSubscribeCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource QvGreenButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Item.IsSubscribed}" Value="True">
                                                    <Setter Property="Background" Value="#3D4450" />
                                                    <Setter Property="Tag" Value="#67707B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Item.IsSubscribed, Converter={StaticResource FalseToVisible}, FallbackValue=Visible}">
                                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Add16" />
                                            <TextBlock Text="{loc:Str Item_Subscribe}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Item.IsSubscribed, Converter={StaticResource TrueToVisible}, FallbackValue=Collapsed}">
                                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Dismiss16" />
                                            <TextBlock Text="{loc:Str Item_Unsubscribe}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource QvButton}" Command="{Binding AddToCollectionCommand}" ToolTip="{loc:Str Collection_AddToolTip}">
                                    <TextBlock Text="{loc:Str Collection_AddTitle}" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
