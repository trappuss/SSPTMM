<!-- ScrollViewer.CanContentScroll="False" opts this page out of WPF-UI's automatic outer
     DynamicScrollViewer: NavigationView wraps every hosted Page's content in one by default, which
     sits above this page's own scrolling regions and makes the wheel behave strangely (see the
     scroll-anywhere corrections on InstalledPage for the full story). This page scrolls its own
     list and its own editor, so it wants that wrapper gone.
     Background="Transparent" on the root Grid is the other half: a Grid with no Background only
     takes part in hit-testing where a child actually paints, so without it the wheel handler below
     would never see events over the empty parts of the page. -->
<Page
    x:Class="TCFModManager.App.Views.ConfigsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Title="{loc:Str Nav_Configs}"
    Loaded="ConfigsPage_Loaded"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        Margin="24,16,24,16"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Closable, but not remembered - see ShowDisclaimer on the view model. -->
        <ui:InfoBar
            Grid.Row="0"
            Margin="0,0,0,12"
            Severity="Warning"
            IsClosable="True"
            IsOpen="{Binding ShowDisclaimer, Mode=TwoWay}"
            Title="{loc:Str Configs_DisclaimerTitle}"
            Message="{loc:Str Configs_DisclaimerMessage}" />

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <ui:Button
                DockPanel.Dock="Right"
                Content="{loc:Str Common_Rescan}"
                Icon="{ui:SymbolIcon ArrowSync24}"
                Command="{Binding ScanCommand}" />

            <ui:ProgressRing
                DockPanel.Dock="Right"
                Width="20"
                Height="20"
                Margin="0,0,12,0"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <TextBlock
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusMessage}" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- The list. Grouped by where each file lives, so the client/server split is the shape
                 of the list rather than a chip on each row. One ListBox rather than nested
                 ItemsControls, so it has a single selection and the arrow keys walk the whole
                 thing - the grouping is added to the collection's default view in code-behind. -->
            <Grid x:Name="RailPanel" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:TextBox
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    PlaceholderText="{loc:Str Configs_SearchPlaceholder}"
                    Icon="{ui:SymbolIcon Search24}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding SourceFilterOptions}"
                    SelectedItem="{Binding SelectedSourceFilter}" />

                <TextBlock
                    Grid.Row="2"
                    Margin="4,12,0,0"
                    VerticalAlignment="Top"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{loc:Str Configs_NoMatches}"
                    Visibility="{Binding HasResults, Converter={StaticResource FalseToVisible}}" />

                <ScrollViewer
                    x:Name="ListScrollViewer"
                    FocusVisualStyle="{x:Null}"
                    Grid.Row="2"
                    Focusable="False"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <ListBox
                        x:Name="ConfigList"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="0,0,12,0"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ItemsSource="{Binding Results}"
                        SelectedItem="{Binding SelectedEntry}"
                        HorizontalContentAlignment="Stretch">
                        <!-- The row Border below draws the hover and the selection, so the item
                             itself contributes no padding, margin, fill or chrome of its own. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                                <!-- Replaced outright, not just zeroed: the stock template paints
                                     its own accent fill for a selected row whatever Background
                                     says, which stacks with the one the row draws. See trap 8 in
                                     the theme notes. -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <!-- DataContext is the CollectionViewGroup: Name is the
                                             ConfigSectionHeader, ItemCount the number of files. -->
                                        <StackPanel Margin="0,12,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Symbol="{Binding Name.Glyph}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Name.Title}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Name.Location}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding ItemCount, StringFormat='({0})'}" />
                                            </StackPanel>
                                            <Separator Margin="0,6,0,0" Opacity="0.25" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ClickableRow}" Padding="6,4" Opacity="{Binding RowOpacity}">
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="{Binding Glyph}"
                                        ToolTip="{Binding FormatLabel}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding Title}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding FullPath}"
                                            Text="{Binding Subtitle}" />
                                        <ui:Badge
                                            Margin="0,3,0,0"
                                            HorizontalAlignment="Left"
                                            Appearance="Caution"
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Content="{Binding Badge}"
                                            Visibility="{Binding Badge, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Transparent" />

            <!-- The editor. Both formats are edited as text for now; the .cfg form goes here next,
                 swapped in on Format, with this text box kept as the "Raw" view. -->
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    MaxWidth="380"
                    Text="{loc:Str Configs_EmptyState}"
                    Visibility="{Binding HasSelection, Converter={StaticResource FalseToVisible}}" />

                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <ui:Button
                            DockPanel.Dock="Right"
                            Padding="8,6"
                            ToolTip="{loc:Str Configs_ShowInExplorerToolTip}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Command="{Binding OpenFolderCommand}" />
                        <ui:Button
                            DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            Padding="8,6"
                            ToolTip="{loc:Str Configs_CopyPathToolTip}"
                            Icon="{ui:SymbolIcon Copy24}"
                            Command="{Binding CopyPathCommand}" />

                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                Text="{Binding SelectedEntry.Title}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap"
                                Text="{Binding SelectedEntry.Entry.DisplayPath}" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <!-- The one line that says what editing this file actually means - which
                             half of the install it belongs to, and what happens to it when the mod
                             is disabled or removed. -->
                        <TextBlock
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding SelectedEntry.LocationNote}" />

                        <TextBlock
                            Margin="0,6,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{Binding SelectedEntry.StateNote}"
                            Visibility="{Binding SelectedEntry.HasStateNote, Converter={StaticResource BoolToVis}}" />

                        <!-- What the last recorded update did to this exact file. The Downloads queue
                             says it once, as it happens; this is where it can still be read later. -->
                        <TextBlock
                            Margin="0,6,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding SelectedEntry.UpdateNote}"
                            Visibility="{Binding SelectedEntry.HasUpdateNote, Converter={StaticResource BoolToVis}}" />

                        <!-- Per-mod, and only for a server mod's own config: nothing an update does
                             can reach a client mod's settings in BepInEx\config. -->
                        <StackPanel
                            Margin="0,10,0,0"
                            Visibility="{Binding ShowPolicy, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{loc:Str Configs_UpdatePolicyLabel}" />

                                <ComboBox
                                    MinWidth="190"
                                    ItemsSource="{Binding PolicyOptions}"
                                    SelectedItem="{Binding SelectedPolicyOption}"
                                    ToolTip="{loc:Str Configs_UpdatePolicyToolTip}" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,6,0,0"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding PolicyNote}" />

                            <!-- The places a mod keeps things no convention would find, and the ones
                                 that only look like config. A chip each, with the kind spelled out,
                                 because the three do opposite things. -->
                            <ItemsControl
                                Focusable="False"
                                Margin="0,8,0,0"
                                ItemsSource="{Binding Locations}"
                                Visibility="{Binding HasLocations, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,6,4"
                                            Padding="8,2"
                                            CornerRadius="3"
                                            ToolTip="{Binding ToolTip}"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    FontSize="11"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Label}" />

                                                <ui:Button
                                                    Margin="6,0,-4,0"
                                                    Padding="2"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Appearance="Transparent"
                                                    ToolTip="{loc:Str Configs_StopTreatingToolTip}"
                                                    Command="{Binding DataContext.RemoveLocationCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                    CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                                                </ui:Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="0,4,0,0">
                                <ui:Button
                                    Margin="0,0,8,4"
                                    Content="{loc:Str Configs_AuthoredFiles}"
                                    Icon="{ui:SymbolIcon FolderAdd24}"
                                    ToolTip="{loc:Str Configs_AuthoredFilesToolTip}"
                                    Command="{Binding AddUserDataFolderCommand}" />

                                <ui:Button
                                    Margin="0,0,8,4"
                                    Content="{loc:Str Configs_SettingsElsewhere}"
                                    Icon="{ui:SymbolIcon DocumentAdd24}"
                                    ToolTip="{loc:Str Configs_SettingsElsewhereToolTip}"
                                    Command="{Binding AddSettingsFileCommand}" />

                                <ui:Button
                                    Margin="0,0,0,4"
                                    Content="{loc:Str Configs_NotAConfig}"
                                    Icon="{ui:SymbolIcon EyeOff24}"
                                    ToolTip="{loc:Str Configs_NotAConfigToolTip}"
                                    Command="{Binding IgnoreSelectedFileCommand}" />
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock
                            Margin="0,6,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{Binding RunningWarning}"
                            Visibility="{Binding RunningWarning, Converter={StaticResource NullToCollapsed}}" />

                        <TextBlock
                            Margin="0,6,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding EditorError}"
                            Visibility="{Binding EditorError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <TextBox
                        Grid.Row="2"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        FontFamily="Consolas, Cascadia Mono, Courier New"
                        FontSize="13"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalContentAlignment="Top"
                        SpellCheck.IsEnabled="False"
                        Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" />

                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <ui:Button
                            DockPanel.Dock="Right"
                            Appearance="Primary"
                            Content="{loc:Str Common_Save}"
                            Icon="{ui:SymbolIcon Save24}"
                            Command="{Binding SaveCommand}" />
                        <ui:Button
                            DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            Content="{loc:Str Configs_Revert}"
                            Icon="{ui:SymbolIcon ArrowUndo24}"
                            ToolTip="{loc:Str Configs_RevertToolTip}"
                            Command="{Binding RevertCommand}" />

                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{loc:Str Configs_UnsavedChanges}"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
