<ui:FluentWindow
    x:Class="TCFModManager.App.Views.ModPageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Width="1100"
    Height="820"
    MinWidth="640"
    MinHeight="480"
    Background="{StaticResource SteamLegacyBackground}"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    WindowBackdropType="None"
    WindowStartupLocation="CenterOwner">
    <!--
        A mod's real sp-mod.com page, inside the app - what the read-the-mod-page gate opens instead
        of a browser tab. It is the site itself (the page counts as visited, the author's
        instructions and warnings are all there), just not in another window. Several pages to
        read are stepped through here one at a time rather than opened as a pile of tabs.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" />

        <!-- "2 of 5: <name>", the steps, and the way out to the browser. -->
        <DockPanel Grid.Row="1" Margin="16,4,16,10" LastChildFill="True">
            <Button
                x:Name="DoneButton"
                DockPanel.Dock="Right"
                Style="{StaticResource SteamBlueButton}"
                Click="DoneButton_Click" />
            <Button
                x:Name="NextButton"
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Style="{StaticResource SteamButton}"
                Content="{loc:Str ModPage_NextPage}"
                Click="NextButton_Click" />
            <Button
                x:Name="PreviousButton"
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Style="{StaticResource SteamButton}"
                Content="{loc:Str ModPage_PreviousPage}"
                Click="PreviousButton_Click" />
            <Button
                DockPanel.Dock="Right"
                Margin="0,0,16,0"
                Style="{StaticResource SteamLinkButton}"
                Foreground="{StaticResource SteamTextDim}"
                Click="BrowserButton_Click">
                <TextBlock Text="{loc:Str Viewer_OpenInBrowser}" />
            </Button>
            <TextBlock
                x:Name="Heading"
                VerticalAlignment="Center"
                FontSize="15"
                Foreground="{StaticResource SteamTextBright}"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <wv2:WebView2 x:Name="Browser" Grid.Row="2" />
    </Grid>
</ui:FluentWindow>
