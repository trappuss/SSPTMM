<UserControl
    x:Class="TCFModManager.App.Views.MediaViewerOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:TCFModManager.App"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:markup="clr-namespace:TCFModManager.App.Behaviors.Markup"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    DataContext="{x:Static app:AppServices.MediaViewer}"
    Focusable="True"
    FocusVisualStyle="{x:Null}"
    KeyDown="Overlay_KeyDown">
    <!--
        Steam's screenshot and video viewer: the picture as large as the window allows (never
        larger than itself) on a near-black scrim, arrows either side, the count and Close above.
        A click on the scrim outside the picture closes it, as on Steam.
    -->
    <UserControl.Resources>
        <converters:UpdateAvailableToVisibilityConverter x:Key="TrueToVisible" />

        <Style x:Key="ViewerArrow" TargetType="Button" BasedOn="{StaticResource SteamButton}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#66000000" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#EB000000" MouseLeftButtonUp="Scrim_MouseLeftButtonUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Count on the left, the way out on the right. -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="24,16,24,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource SteamText}" Text="{Binding Counter}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource SteamButton}" Command="{Binding CloseCommand}" Content="{loc:Str Common_Close}" />
            <Button DockPanel.Dock="Right" Margin="0,0,8,0" Style="{StaticResource SteamButton}" Command="{Binding OpenInBrowserCommand}" Content="{loc:Str Viewer_OpenInBrowser}" />
        </DockPanel>

        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ViewerArrow}" Command="{Binding PreviousCommand}" ToolTip="{loc:Str Common_Previous}">
            <Path Width="12" Height="22" Data="M11,0 L0,11 L11,22" Stretch="Fill" Stroke="White" StrokeThickness="2.5" />
        </Button>
        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ViewerArrow}" Command="{Binding NextCommand}" ToolTip="{loc:Str Common_Next}">
            <Path Width="12" Height="22" Data="M0,0 L11,11 L0,22" Stretch="Fill" Stroke="White" StrokeThickness="2.5" />
        </Button>

        <!-- The picture, at its own size or smaller. -->
        <markup:RemotePicture
            x:Name="Picture"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MouseLeftButtonUp="Content_MouseLeftButtonUp"
            Visibility="{Binding IsPicture, Converter={StaticResource TrueToVisible}}" />

        <!-- A video plays here; the web view is created the first time one is shown. -->
        <Grid
            x:Name="VideoHost"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,24"
            Background="Black"
            MouseLeftButtonUp="Content_MouseLeftButtonUp"
            Visibility="{Binding IsVideo, Converter={StaticResource TrueToVisible}}">
            <!-- Without a WebView2 runtime: the thumbnail and a way to watch it on YouTube. -->
            <StackPanel x:Name="VideoFallback" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <markup:RemotePicture x:Name="VideoThumbnail" MaxHeight="360" />
                <Button Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource SteamBlueButton}" Command="{Binding OpenInBrowserCommand}" Content="{loc:Str Viewer_WatchOnYouTube}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
