<!--
    Browsing: Collections - Steam's collections browse page (steamcommunity.com/workshop/browse with
    section=collections), over sp-mod.com's public lists (sp-mod.com/lists).

    Measured on Steam 2026-09-25: "Browsing: Collections" 18px #F1F2F3, the count under it, then the
    same search box, sort face and 300px sidebar as the items page. The cards are two to a row,
    152px high and 16px apart: on a radial gradient (62% 99% at 17% 35%, #3C4149 to #1B1D21) with a
    1px 10px rgba(0,0,0,.58) shadow, the picture 152px square at the left, then 10px in the title
    16.7px white on one line, "By X" 12px rgba(255,255,255,.635), up to three lines of description
    13.37px #ACB2B8 (17.38px apart, 5px above) and "Contains N items" 12px #636B74 at the foot. Under
    the pointer a card lifts 5px and its shadow turns to a faint white glow, as the item cards do.

    What sp-mod.com has, and so what this page has: newest first only (Steam's Most Popular and Top
    Rated have nothing to be measured by), a search, and the SPT version a list was made for - which
    sits where Steam's stars do, lit when it is this install's. A list with no picture of its own
    shows sp-mod.com's list glyph instead.
-->
<Page
    x:Class="TCFModManager.App.Views.CollectionsBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:TCFModManager.App.Views"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    ScrollViewer.CanContentScroll="False"
    Title="{loc:Str Collections_Title}"
    Loaded="Page_Loaded">
    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:UpdateAvailableToVisibilityConverter x:Key="TrueToVisible" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <converters:EqualityConverter x:Key="IsSame" />
        <converters:PageSizeLabelConverter x:Key="PageSizeLabel" />

        <!-- The sort order's face: rgba(0,0,0,.37), 283x42, 15px #C4C4C4. -->
        <Style x:Key="SortFace" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#C4C4C4" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Padding="10,0" Background="{StaticResource SteamSortBox}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- A page number in the pager: 15px white, the current one #ACB2B8 and not a link. -->
        <Style x:Key="PageNumber" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SteamBlue}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SteamText}" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SteamText}" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The pager's arrows: #1A9FFF 41x24, radius 2; #21537A with a grey arrow when there is
             nowhere to go. -->
        <Style x:Key="PagerArrow" TargetType="Button" BasedOn="{StaticResource SteamBlueButton}">
            <Setter Property="Width" Value="41" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SteamBlueHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#21537A" />
                                <Setter Property="Foreground" Value="#71757A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Steam's collection card background. -->
        <RadialGradientBrush x:Key="CardFace" Center="0.17,0.35" GradientOrigin="0.17,0.35" RadiusX="0.62" RadiusY="0.99">
            <GradientStop Offset="0" Color="#3C4149" />
            <GradientStop Offset="1" Color="#1B1D21" />
        </RadialGradientBrush>
    </Page.Resources>

    <ScrollViewer
        x:Name="PageScroll"
        FocusVisualStyle="{x:Null}"
        ScrollChanged="PageScroll_ScrollChanged"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24">
            <views:WorkshopBanner />
            <views:WorkshopSubNav />

            <TextBlock Margin="0,24,0,0" FontSize="18" Foreground="{StaticResource SteamTextBright}" Text="{loc:Str Collections_BrowsingTitle}" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="14"
                Foreground="{StaticResource SteamText}"
                Text="{Binding EntriesText}"
                Visibility="{Binding EntriesText, Converter={StaticResource NullToCollapsed}}" />

            <TextBlock
                Margin="0,4,0,0"
                FontSize="13"
                Foreground="{StaticResource SteamLegacyBlue}"
                TextWrapping="Wrap"
                Text="{Binding StatusMessage}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />

            <TextBlock
                Margin="0,4,0,0"
                FontSize="13"
                Foreground="{StaticResource SteamTextDim}"
                Text="{Binding ProgressText}"
                Visibility="{Binding ProgressText, Converter={StaticResource NullToCollapsed}}" />

            <!-- Search on the left, sort order on the right. -->
            <DockPanel Margin="0,10,0,12">
                <ToggleButton
                    x:Name="SortToggle"
                    DockPanel.Dock="Right"
                    Width="283"
                    Height="42"
                    Style="{StaticResource SortFace}"
                    ToolTip="{loc:Str Common_SortToolTip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path
                            Grid.Column="0"
                            Width="24"
                            Height="16"
                            Margin="0,0,21,0"
                            Data="M0,1 L14,1 M0,7 L11,7 M0,13 L8,13 M19,0 L19,14 M15,10 L19,14 L23,10"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                            StrokeThickness="2" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SelectedSortOption.Label}" />
                        <Path
                            Grid.Column="2"
                            Width="14"
                            Height="10"
                            Margin="10,0,4,0"
                            Data="M0,0 L14,0 L7,10 Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                            Stretch="Fill" />
                    </Grid>
                </ToggleButton>
                <Popup
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=SortToggle, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=SortToggle}"
                    StaysOpen="False">
                    <Border Margin="0,0,12,12" MinWidth="283" Style="{StaticResource SteamMenuPanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SteamMenuHeader}" Text="{loc:Str Workshop_SortOrderHeader}" />
                            <ItemsControl Focusable="False" ItemsSource="{Binding SortOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton
                                            Style="{StaticResource SteamRadio}"
                                            Command="{Binding DataContext.SelectSortCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Click="SortChoice_Click">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource IsSame}" Mode="OneWay">
                                                    <Binding />
                                                    <Binding Path="DataContext.SelectedSortOption" RelativeSource="{RelativeSource AncestorType=Page}" />
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                            <TextBlock Text="{Binding Label}" />
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>

                <StackPanel Orientation="Horizontal">
                    <Border Width="420" Height="42" Padding="8" Background="{StaticResource SteamGray}">
                        <TextBox
                            Style="{StaticResource SteamSearchField}"
                            Tag="{loc:Str Collections_SearchPlaceholder}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                    <Button
                        Width="36"
                        Height="42"
                        Margin="4,0,0,0"
                        Padding="0"
                        Style="{StaticResource SteamButton}"
                        ToolTip="{loc:Str Collections_RefreshToolTip}"
                        Command="{Binding RefreshCommand}">
                        <ui:SymbolIcon FontSize="20" Foreground="{StaticResource SteamText}" Symbol="ArrowClockwise24" />
                    </Button>
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="10" VerticalAlignment="Top" Background="{StaticResource SteamSidebarBackground}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,5" Style="{StaticResource SteamSidebarHeader}" Text="{loc:Str Workshop_SptVersionHeader}" />
                        <ComboBox
                            MinHeight="36"
                            FontSize="13"
                            ToolTip="{loc:Str Collections_SptFilterToolTip}"
                            ItemsSource="{Binding SptChoices}"
                            SelectedItem="{Binding SelectedSpt}" />

                        <TextBlock Margin="0,14,0,0" FontSize="13" Foreground="{StaticResource SteamTextDim}" TextWrapping="Wrap" Text="{loc:Str Collections_SidebarNote}" />

                        <Button Margin="0,14,0,0" HorizontalAlignment="Left" Style="{StaticResource SteamButton}" ToolTip="{loc:Str Common_ClearFiltersToolTip}" Command="{Binding ClearFiltersCommand}">
                            <TextBlock Text="{loc:Str Common_ClearFilters}" />
                        </Button>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="2" MinHeight="400">
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="14"
                        Foreground="{StaticResource SteamTextDim}"
                        Text="{loc:Str Collections_Loading}"
                        Visibility="{Binding IsLoading, Converter={StaticResource TrueToVisible}}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="14"
                        Foreground="{StaticResource SteamText}"
                        Text="{loc:Str Collections_NoMatches}"
                        Visibility="{Binding ShowNoMatches, Converter={StaticResource TrueToVisible}}" />

                    <!-- Two cards to a row, 16px apart; the right margin takes back the last gap. -->
                    <ItemsControl Margin="0,0,-16,0" Focusable="False" ItemsSource="{Binding Lists}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    x:Name="CardRoot"
                                    Height="152"
                                    Margin="0,0,16,16"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    behaviors:CollectionHover.Enabled="True"
                                    MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                    <Grid.RenderTransform>
                                        <TranslateTransform Y="0" />
                                    </Grid.RenderTransform>

                                    <Border x:Name="Shadow" Background="#1B1D21">
                                        <Border.CacheMode>
                                            <BitmapCache />
                                        </Border.CacheMode>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" Direction="315" Opacity="0.58" ShadowDepth="1.4" Color="Black" />
                                        </Border.Effect>
                                    </Border>
                                    <Border x:Name="Glow" Background="#1B1D21" Visibility="Hidden">
                                        <Border.CacheMode>
                                            <BitmapCache />
                                        </Border.CacheMode>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" Direction="315" Opacity="0.25" ShadowDepth="1.4" Color="White" />
                                        </Border.Effect>
                                    </Border>

                                    <Grid Background="{StaticResource CardFace}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="152" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- The list's picture, or sp-mod.com's glyph on its stripes. -->
                                        <Grid Grid.Column="0" Background="#030712">
                                            <ui:SymbolIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="40"
                                                Foreground="#4B5563"
                                                Symbol="TextBulletListLtr24"
                                                Visibility="{Binding HasCover, Converter={StaticResource FalseToVisible}}" />
                                            <Image
                                                Stretch="UniformToFill"
                                                Visibility="{Binding HasCover, Converter={StaticResource TrueToVisible}}"
                                                behaviors:ThumbnailLoader.DecodeWidth="152"
                                                behaviors:ThumbnailLoader.Source="{Binding Cover}" />
                                        </Grid>

                                        <DockPanel Grid.Column="1" Margin="10">
                                            <DockPanel DockPanel.Dock="Top">
                                                <!-- Where Steam's stars are: the SPT version it was made for. -->
                                                <Border
                                                    x:Name="Spt"
                                                    Margin="8,2,0,0"
                                                    Padding="6,1"
                                                    VerticalAlignment="Top"
                                                    Background="#3D4450"
                                                    CornerRadius="2"
                                                    DockPanel.Dock="Right"
                                                    ToolTip="{Binding SptToolTip}"
                                                    Visibility="{Binding SptVersion, Converter={StaticResource NullToCollapsed}}">
                                                    <TextBlock x:Name="SptText" FontSize="12" Foreground="#ACB2B8" Text="{Binding SptVersion}" />
                                                </Border>
                                                <TextBlock
                                                    FontSize="16.7"
                                                    Foreground="White"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{Binding Title}" />
                                            </DockPanel>
                                            <TextBlock
                                                DockPanel.Dock="Top"
                                                FontSize="12"
                                                Foreground="#A2FFFFFF"
                                                TextTrimming="CharacterEllipsis"
                                                Text="{Binding ByText}"
                                                Visibility="{Binding ByText, Converter={StaticResource NullToCollapsed}}" />
                                            <DockPanel DockPanel.Dock="Bottom">
                                                <StackPanel
                                                    DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding IsSubscribed, Converter={StaticResource TrueToVisible}}">
                                                    <ui:SymbolIcon Margin="0,0,4,0" FontSize="13" Foreground="#66C0F4" Symbol="Checkmark16" />
                                                    <TextBlock FontSize="12" Foreground="#66C0F4" Text="{loc:Str Workshop_TagSubscribed}" />
                                                </StackPanel>
                                                <TextBlock FontSize="12" Foreground="#636B74" Text="{Binding ContainsText}" />
                                            </DockPanel>
                                            <TextBlock
                                                MaxHeight="57"
                                                Padding="0,5,0,0"
                                                FontSize="13.37"
                                                Foreground="#ACB2B8"
                                                LineHeight="17.38"
                                                LineStackingStrategy="BlockLineHeight"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap"
                                                Text="{Binding Teaser}" />
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-5" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                        <Setter TargetName="Shadow" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsForInstalledSpt}" Value="True">
                                        <Setter TargetName="Spt" Property="Background" Value="{StaticResource SteamGreenInner}" />
                                        <Setter TargetName="SptText" Property="Foreground" Value="#D2E885" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <!-- The infinite list's foot, while it has cards to add. -->
            <TextBlock
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="{StaticResource SteamTextDim}"
                Text="{loc:Str Workshop_LoadingMore}"
                Visibility="{Binding HasMore, Converter={StaticResource TrueToVisible}}" />

            <!-- "Per page: [Infinite]  < 1 2 3 ... 27 >", right-aligned under the grid, as Browse. -->
            <StackPanel Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource SteamText}" Text="{loc:Str Workshop_PerPage}" />
                <ComboBox
                    MinWidth="60"
                    Margin="6,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    ToolTip="{loc:Str Common_PageSizeToolTip}"
                    ItemsSource="{Binding PageSizeOptions}"
                    SelectedItem="{Binding PageSize}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PageSizeLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasPages, Converter={StaticResource TrueToVisible}}">
                    <Button Style="{StaticResource PagerArrow}" Command="{Binding PreviousPageCommand}" ToolTip="{loc:Str Common_Previous}">
                        <Path Width="14" Height="10" Data="M5,0 L0,5 L5,10 M0,5 L14,5" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" />
                    </Button>
                    <ItemsControl Focusable="False" Margin="6,0" VerticalAlignment="Center" ItemsSource="{Binding PageLinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Style="{StaticResource PageNumber}"
                                    Command="{Binding DataContext.GoToPageNumberCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding Number}">
                                    <TextBlock Text="{Binding Text}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource PagerArrow}" Command="{Binding NextPageCommand}" ToolTip="{loc:Str Common_Next}">
                        <Path Width="14" Height="10" Data="M9,0 L14,5 L9,10 M0,5 L14,5" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
