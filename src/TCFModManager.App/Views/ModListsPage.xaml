<!-- ScrollViewer.CanContentScroll="False" opts this page out of WPF-UI's automatic outer
     DynamicScrollViewer, the same as ConfigsPage and InstalledPage: this page scrolls its own two
     lists, so that wrapper only gets in the way. Background="Transparent" on the root Grid is the
     other half - a Grid with no Background only takes part in hit-testing where a child paints.

     Every TextBlock sets its Foreground from a DynamicResource brush. A plain ListBox's default
     template hands its items the system control foreground - black - so anything inheriting inside
     one is unreadable in dark mode. Secondary/Tertiary carry the de-emphasis rather than Opacity,
     which is the mapping the v1.6.0 theme sweep settled on. -->
<Page
    x:Class="TCFModManager.App.Views.ModListsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Title="{loc:Str Nav_ModLists}"
    Loaded="ModListsPage_Loaded"
    Unloaded="ModListsPage_Unloaded"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            A preview's colours: the summary chips and each plan row's status badge. Red for what is
            missing here, amber for what is here but not as the list has it, green for what is
            already right, grey for the rest. The same system fill brushes the shared StatusIcon
            style uses, so a preview reads in the colours the rest of the app does.
        -->
        <Style x:Key="ToneBadge" TargetType="Border">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Good">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Disabled">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Bad">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToneBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Good">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Disabled">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Bad">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Each badge leads with the shared status icon for its state - the one Installed shows for
            that mod - in the badge's own colour.
        -->
        <Style x:Key="ToneIcon" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="{Binding Icon}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Good">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Disabled">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Bad">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The container contributes nothing - no padding, margin, fill or chrome - so the row
            Border inside the template draws the whole thing.
        -->
        <Style x:Key="BareContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <!--
                The template is replaced outright rather than just having its Background zeroed.
                Setting Background="Transparent" does not stop a selected row being painted: the
                stock template draws selection with its own accent fill and left indicator, which
                the property never touches. With the row below drawing its own selected state too,
                a picked list came out as a solid accent slab with a second edge around it - two
                selection visuals stacked, one of them nobody chose.

                A bare ContentPresenter leaves selection entirely to the row style, which is the
                only place it is described. Selection behaviour is unaffected - IsSelected is
                ListBox input handling, not something the template provides.
            -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadOnlyContainer" TargetType="ListBoxItem" BasedOn="{StaticResource BareContainer}">
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!--
            One saved list. A card-coloured row with space around it rather than a bare strip pressed
            against its neighbours, so the left column reads the way the Installed page's List view
            does. Margin and Padding live in the style, not on the Border, so the two triggers still
            win over the resting fill - a local value on the element would outrank them.
        -->
        <Style x:Key="ListCardRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0,6,8" />
            <Setter Property="Padding" Value="12,11" />
            <Style.Triggers>
                <!-- Selected first, hover second, so pointing at the current list still reads as
                     pointing at it. Same ordering as ClickableRow in App.xaml.

                     The selected row keeps its own text colours: the fill is a tint over the card
                     rather than a solid accent, so primary/tertiary stay readable on it and the
                     row does not change shape or weight when it is picked. -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SelectedRowStroke}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        Margin="24,16,24,16"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: make a list or bring one in, then the ones already here. -->
        <!-- The page's title, as Steam's "Your collections" has it. -->
        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Margin="0,0,0,16"
            FontSize="18"
            Foreground="{StaticResource SteamTextBright}"
            Text="{loc:Str Workshop_YourCollections}" />

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Padding="16">
                <StackPanel>
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{loc:Str ModLists_CaptureHeader}" />

                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,4,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:Str ModLists_CaptureDescription}" />

                    <ui:TextBox
                        PlaceholderText="{loc:Str ModLists_NamePlaceholder}"
                        Text="{Binding NewListName, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:Button
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Appearance="Primary"
                            Icon="{ui:SymbolIcon AppsList24}"
                            Content="{loc:Str ModLists_Capture}"
                            Command="{Binding CaptureCommand}" />

                        <ui:Button
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            ToolTip="{loc:Str ModLists_ImportToolTip}"
                            Icon="{ui:SymbolIcon ArrowImport24}"
                            Content="{loc:Str ModLists_Import}"
                            Command="{Binding ImportCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <TextBlock
                Grid.Row="1"
                Margin="4,20,0,8"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{loc:Str ModLists_SavedHeader}" />

            <!--
                Top, not the default.

                A ui:Card in a "*" row is laid out centred, so a card whose content is shorter than
                its cell floats in the middle of it with empty space above and below - which is what
                the contents filter exposed: narrowing a 107-mod list to seven rows detached this
                card from the top of the page and left it hanging halfway down.

                It is only the ALIGNMENT that changes. The card is still measured against the cell's
                height, so a list too long for it is still constrained and still scrolls inside its
                own ListBox rather than running off the bottom of the window.
            -->
            <ui:Card Grid.Row="2" Padding="4,8,4,2" VerticalAlignment="Top">
                <Grid>
                    <TextBlock
                        Margin="12"
                        TextWrapping="Wrap"
                        VerticalAlignment="Top"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Visibility="{Binding HasLists, Converter={StaticResource FalseToVisible}}"
                        Text="{loc:Str ModLists_SavedEmpty}" />

                    <ListBox
                        x:Name="ListsBox"
                        BorderThickness="0"
                        Background="Transparent"
                        ItemContainerStyle="{StaticResource BareContainer}"
                        ItemsSource="{Binding Lists}"
                        SelectedItem="{Binding Selected, Mode=TwoWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListCardRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            TextWrapping="Wrap"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Name}" />

                                        <TextBlock
                                            TextWrapping="Wrap"
                                            FontSize="12"
                                            Margin="0,3,0,0"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Detail}" />
                                    </StackPanel>

                                    <!-- Three separate things, deliberately not one badge: the list
                                         you follow, the list a server hands you (followed at the
                                         same time), and the list THIS machine serves to others. -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0">

                                        <Border
                                            Padding="8,3"
                                            Margin="0,0,6,0"
                                            CornerRadius="4"
                                            ToolTip="{loc:Str ModLists_ServingToolTip}"
                                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                            Visibility="{Binding IsPublished, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Symbol="ArrowUpload24"
                                                    FontSize="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                                <TextBlock
                                                    Margin="5,0,0,0"
                                                    FontSize="11"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                    Text="{loc:Str ModLists_ServingBadge}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- On origin, not on being followed: the list you fetched
                                             and have not applied yet is the one you most need to
                                             tell apart from your own. -->
                                        <Border
                                            Padding="8,3"
                                            Margin="0,0,6,0"
                                            CornerRadius="4"
                                            ToolTip="{loc:Str ModLists_FromServerToolTip}"
                                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                            Visibility="{Binding IsFromServer, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Symbol="CloudArrowDown24"
                                                    FontSize="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                                <TextBlock
                                                    Margin="5,0,0,0"
                                                    FontSize="11"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                    Text="{loc:Str ModLists_FromServerBadge}" />
                                            </StackPanel>
                                        </Border>

                                        <ui:SymbolIcon
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            ToolTip="{loc:Str ModLists_FollowingServerToolTip}"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                            Symbol="CheckmarkCircle24"
                                            Visibility="{Binding IsActiveServer, Converter={StaticResource BoolToVis}}" />

                                        <ui:SymbolIcon
                                            VerticalAlignment="Center"
                                            ToolTip="{loc:Str ModLists_FollowingToolTip}"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                            Symbol="CheckmarkCircle24"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ui:Card>

            <!-- The single undo point, kept here rather than among the lists: it is about the
                 install, not about whichever list happens to be selected. Hidden until there is
                 something to undo, and gone again once used. -->
            <ui:Button
                Grid.Row="3"
                Margin="0,12,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Icon="{ui:SymbolIcon ArrowUndo24}"
                Content="{Binding RevertLabel}"
                ToolTip="{loc:Str ModLists_UndoToolTip}"
                Visibility="{Binding HasRevert, Converter={StaticResource BoolToVis}}"
                Command="{Binding RevertCommand}" />
        </Grid>

        <!-- Right: the selected list, and what applying it would do. -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                TextWrapping="Wrap"
                MaxWidth="520"
                HorizontalAlignment="Left"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Visibility="{Binding HasSelection, Converter={StaticResource FalseToVisible}}"
                Text="{loc:Str ModLists_EmptyState}" />

            <!-- Header: the name, then the two things you actually do, then the quieter rest. -->
            <StackPanel
                Grid.Row="0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox
                        Grid.Column="0"
                        FontSize="16"
                        IsEnabled="{Binding SelectionIsEditable}"
                        Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:Button
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        ToolTip="{loc:Str ModLists_RenameToolTip}"
                        Icon="{ui:SymbolIcon Rename24}"
                        Content="{loc:Str ModLists_Rename}"
                        Command="{Binding RenameCommand}" />
                </Grid>

                <TextBlock
                    Margin="2,10,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding SelectionDetail}" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <ui:Button
                        MinWidth="110"
                        HorizontalContentAlignment="Center"
                        Content="{loc:Str ModLists_Preview}"
                        ToolTip="{loc:Str ModLists_PreviewToolTip}"
                        Command="{Binding PreviewCommand}" />

                    <ui:Button
                        MinWidth="110"
                        Margin="10,0,0,0"
                        HorizontalContentAlignment="Center"
                        Appearance="Primary"
                        Content="{Binding ApplyLabel}"
                        ToolTip="{loc:Str ModLists_ApplyToolTip}"
                        Command="{Binding ApplyCommand}" />

                    <!-- Only while a plan is showing: the plan sits in the same cell as the list's
                         own contents, so this is how you get back to them. -->
                    <ui:Button
                        Margin="10,0,0,0"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon ArrowLeft24}"
                        Content="{loc:Str ModLists_BackToMods}"
                        ToolTip="{loc:Str ModLists_BackToModsToolTip}"
                        Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}"
                        Command="{Binding ClosePlanCommand}" />
                </StackPanel>

                <Separator
                    Margin="0,16,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <!-- The list as a Workshop collection page. -->
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon Grid24}"
                        Content="{loc:Str Collection_ViewPage}"
                        ToolTip="{loc:Str Collection_ViewPageToolTip}"
                        Command="{Binding ViewCollectionCommand}" />

                    <ui:Button
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon ArrowExportLtr24}"
                        Content="{loc:Str ModLists_Export}"
                        ToolTip="{loc:Str ModLists_ExportToolTip}"
                        Command="{Binding ExportCommand}" />

                    <!-- Only a served list has anywhere to be refreshed FROM, so it is the only
                         one that shows this. -->
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        Content="{loc:Str ModLists_RefreshFromServer}"
                        ToolTip="{loc:Str ModLists_RefreshFromServerToolTip}"
                        Visibility="{Binding SelectionIsFromServer, Converter={StaticResource BoolToVis}}"
                        Command="{Binding RefreshFromServerCommand}" />

                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon Branch24}"
                        Content="{loc:Str ModLists_MakeCopy}"
                        ToolTip="{loc:Str ModLists_MakeCopyToolTip}"
                        Visibility="{Binding SelectionIsImported, Converter={StaticResource BoolToVis}}"
                        Command="{Binding ForkCommand}" />

                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon ArrowUndo24}"
                        Content="{loc:Str ModLists_StopFollowing}"
                        ToolTip="{loc:Str ModLists_StopFollowingToolTip}"
                        Visibility="{Binding SelectionIsActive, Converter={StaticResource BoolToVis}}"
                        Command="{Binding StopFollowingCommand}" />

                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Transparent"
                        Content="{loc:Str ModLists_Delete}"
                        ToolTip="{loc:Str ModLists_DeleteToolTip}"
                        Command="{Binding DeleteCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- What just happened, directly under the buttons that cause it rather than in a
                 footer at the far end of the page. It answers "did that touch my install?", so it
                 belongs where the eye already is. -->
            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                Margin="2,14,0,0">
                <ui:ProgressRing
                    Width="16"
                    Height="16"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                <TextBlock
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusMessage}" />
            </StackPanel>

            <StackPanel Grid.Row="2">
                <ui:InfoBar
                    Margin="0,16,0,0"
                    Severity="Warning"
                    IsClosable="False"
                    IsOpen="{Binding HasVersionWarning, Mode=OneWay}"
                    Message="{Binding VersionWarning}" />

                <!-- Monitor mode: this apply downloads its installs and updates for the user to
                     install, and says so before anything runs. -->
                <ui:InfoBar
                    Margin="0,16,0,0"
                    Severity="Informational"
                    IsClosable="False"
                    IsOpen="{Binding HasDownloadOnlyNotice, Mode=OneWay}"
                    Message="{Binding DownloadOnlyNotice}" />
            </StackPanel>

            <!-- The plan at a glance: one coloured count per kind of change, in the colours the
                 rows below carry. -->
            <ItemsControl
                Grid.Row="3"
                Margin="0,16,0,6"
                ItemsSource="{Binding PlanChips}"
                ToolTip="{Binding PlanSummary}"
                Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ToneBadge}" Margin="0,0,8,6" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource ToneIcon}" />
                                <TextBlock Style="{StaticResource ToneBadgeText}" FontSize="12" VerticalAlignment="Center" Text="{Binding Text}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
                What the list names, and where mods are added to it or taken off it.

                Shares its cell with the plan below and swaps with it: previewing answers a
                different question, and stacking two long lists is the congestion this page was
                corrected for once already.

                Taking a mod off a list changes the list and nothing else. The mod stays installed
                and enabled; only applying an Exclusive list afterwards sets it aside.
            -->
            <ui:Card
                Grid.Row="4"
                Padding="4"
                Margin="0,16,0,0"
                VerticalAlignment="Top"
                Visibility="{Binding ShowContents, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,8,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding EntriesHeader}" />

                        <!-- Add and remove change what is on screen; Save writes it to the list;
                             Apply is the only thing on this page that touches the game folder. Save
                             and Discard appear only when there is something to save. -->
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="{Binding SelectionIsEditable, Converter={StaticResource BoolToVis}}">
                            <ui:Button
                                Icon="{ui:SymbolIcon Add24}"
                                Content="{loc:Str ModLists_AddMods}"
                                ToolTip="{loc:Str ModLists_AddModsToolTip}"
                                Command="{Binding AddModsCommand}" />

                            <!-- The one-button replacement for taking a mod off the list and adding
                                 it back to pick up its new version. -->
                            <ui:Button
                                Margin="8,0,0,0"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                Content="{loc:Str ModLists_RefreshVersions}"
                                ToolTip="{loc:Str ModLists_RefreshVersionsToolTip}"
                                Command="{Binding RefreshVersionsCommand}" />

                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Icon="{ui:SymbolIcon Save24}"
                                Content="{loc:Str Common_Save}"
                                ToolTip="{loc:Str ModLists_SaveToolTip}"
                                Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"
                                Command="{Binding SaveCommand}" />

                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Transparent"
                                Icon="{ui:SymbolIcon ArrowUndo24}"
                                Content="{loc:Str ModLists_Discard}"
                                ToolTip="{loc:Str ModLists_DiscardToolTip}"
                                Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DiscardCommand}" />

                            <!-- One step rather than export-then-copy: the app knows where the
                                 server's config folder is, and a file the operator has to move by
                                 hand is one that ends up in the wrong place. -->
                            <ui:Button
                                Margin="8,0,0,0"
                                Icon="{ui:SymbolIcon ArrowUpload24}"
                                Content="{loc:Str ModLists_Publish}"
                                ToolTip="{loc:Str ModLists_PublishToolTip}"
                                Command="{Binding PublishCommand}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <TextBlock
                            TextWrapping="Wrap"
                            Margin="10,0,10,8"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Visibility="{Binding SelectionIsImported, Converter={StaticResource BoolToVis}}"
                            Text="{loc:Str ModLists_ImportedNotice}" />

                        <!-- Preview and Apply are disabled until this is gone: they work off the
                             saved list, and running them against something the panel no longer
                             agrees with is the one confusing state this page can get into. -->
                        <TextBlock
                            TextWrapping="Wrap"
                            Margin="10,0,10,8"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"
                            Text="{Binding UnsavedLabel, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Only once there is something to filter. A search box over an empty list
                         is furniture. -->
                    <Grid
                        Grid.Row="2"
                        Margin="10,0,10,8"
                        Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox
                            Grid.Column="0"
                            PlaceholderText="{loc:Str ModLists_EntrySearchPlaceholder}"
                            Icon="{ui:SymbolIcon Search24}"
                            ToolTip="{loc:Str ModLists_EntrySearchToolTip}"
                            Text="{Binding EntrySearch, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox
                            Grid.Column="1"
                            MinWidth="176"
                            Margin="8,0,0,0"
                            DisplayMemberPath="Label"
                            ToolTip="{loc:Str ModLists_ScopeFilterToolTip}"
                            ItemsSource="{Binding ScopeFilters}"
                            SelectedItem="{Binding ScopeFilter}" />

                        <ComboBox
                            Grid.Column="2"
                            MinWidth="130"
                            Margin="8,0,0,0"
                            DisplayMemberPath="Label"
                            ToolTip="{loc:Str ModLists_EntrySortToolTip}"
                            ItemsSource="{Binding EntrySorts}"
                            SelectedItem="{Binding EntrySort}" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <TextBlock
                            Margin="10,4,10,10"
                            TextWrapping="Wrap"
                            VerticalAlignment="Top"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Visibility="{Binding HasEntries, Converter={StaticResource FalseToVisible}}"
                            Text="{loc:Str ModLists_NoEntries}" />

                        <!-- A filter matching nothing is not an empty list, and saying so would be
                             alarming on a list of 76. -->
                        <TextBlock
                            Margin="10,4,10,10"
                            TextWrapping="Wrap"
                            VerticalAlignment="Top"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVis}}"
                            Text="{loc:Str ModLists_NoMatches}" />

                        <ListBox
                            x:Name="EntriesBox"
                            BorderThickness="0"
                            Background="Transparent"
                            ItemContainerStyle="{StaticResource ReadOnlyContainer}"
                            ItemsSource="{Binding EntriesView}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HoverRow}" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- The listing title, then the folder it occupies and
                                                 the version the list names. Two lines because the
                                                 title and the folder name are often nothing like
                                                 each other, and both are worth reading. -->
                                            <StackPanel
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0">
                                                <DockPanel>
                                                    <!-- Installed here, and how: Browse's mark. -->
                                                    <ui:SymbolIcon
                                                        DockPanel.Dock="Left"
                                                        FontSize="15"
                                                        Margin="0,1,6,0"
                                                        VerticalAlignment="Top"
                                                        Symbol="{Binding StatusGlyph}"
                                                        Style="{StaticResource StatusIcon}"
                                                        ToolTip="{Binding StatusTooltip}"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" />
                                                    <ui:SymbolIcon
                                                        DockPanel.Dock="Left"
                                                        Symbol="Pin24"
                                                        FontSize="14"
                                                        Margin="0,1,6,0"
                                                        VerticalAlignment="Top"
                                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                        ToolTip="{loc:Str Common_PinnedToolTip}"
                                                        Visibility="{Binding IsPinnedHere, Converter={StaticResource BoolToVis}}" />

                                                    <TextBlock
                                                        TextWrapping="Wrap"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding Name}" />
                                                </DockPanel>

                                                <TextBlock
                                                    TextWrapping="Wrap"
                                                    FontSize="12"
                                                    Margin="0,3,0,0"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Detail}" />
                                            </StackPanel>

                                            <!-- On every row, every state. This is a value you
                                                 cycle, so an unlabelled row would read as "not set"
                                                 rather than "everyone". -->
                                            <Border
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"
                                                Padding="8,3"
                                                CornerRadius="4"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding ScopeLabel}" />
                                            </Border>

                                            <ui:Button
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"
                                                Padding="8,4"
                                                Appearance="Transparent"
                                                Icon="{ui:SymbolIcon PeopleSwap24}"
                                                ToolTip="{loc:Str ModLists_ScopeToolTip}"
                                                Visibility="{Binding DataContext.SelectionIsEditable, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.CycleScopeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}" />

                                            <ui:Button
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Margin="0,0,4,0"
                                                Padding="8,4"
                                                Appearance="Transparent"
                                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                Icon="{ui:SymbolIcon Dismiss24}"
                                                ToolTip="{loc:Str ModLists_RemoveEntryToolTip}"
                                                Visibility="{Binding DataContext.SelectionIsEditable, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </ui:Card>

            <ui:Card
                Grid.Row="4"
                Padding="4"
                Margin="0,4,0,0"
                VerticalAlignment="Top"
                Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                <ListBox
                    x:Name="PlanBox"
                    BorderThickness="0"
                    Background="Transparent"
                    ItemContainerStyle="{StaticResource ReadOnlyContainer}"
                    ItemsSource="{Binding PlanRows}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Laid out as the contents rows are, so previewing a list shows the
                                 same list - with where this machine stands against each entry. -->
                            <Border Style="{StaticResource HoverRow}" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock
                                        TextWrapping="Wrap"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        TextWrapping="Wrap"
                                        FontSize="12"
                                        Margin="0,3,0,0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding EntryDetail}" />
                                </StackPanel>

                                <Border
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    Padding="8,3"
                                    CornerRadius="4"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Visibility="{Binding HasScope, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ScopeLabel}" />
                                </Border>

                                <!-- Where this machine stands: Missing, 3.0.0 → 3.1.2, Disabled,
                                     Already right. The action it leads to is the tooltip. -->
                                <Border Grid.Column="2" Style="{StaticResource ToneBadge}" ToolTip="{Binding Kind}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Style="{StaticResource ToneIcon}" />
                                        <TextBlock Style="{StaticResource ToneBadgeText}" VerticalAlignment="Center" Text="{Binding Status}" />
                                    </StackPanel>
                                </Border>

                                <ui:Button
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Margin="8,-4,0,-4"
                                    Padding="8,4"
                                    Appearance="Transparent"
                                    Icon="{ui:SymbolIcon Pin24}"
                                    ToolTip="{loc:Str ModLists_PinToolTip}"
                                    Visibility="{Binding CanPin, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}" />

                                <ui:Button
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Margin="8,-4,0,-4"
                                    Padding="8,4"
                                    Appearance="Transparent"
                                    Icon="{ui:SymbolIcon PinOff24}"
                                    ToolTip="{loc:Str ModLists_UnpinToolTip}"
                                    Visibility="{Binding CanUnpin, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}" />
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
