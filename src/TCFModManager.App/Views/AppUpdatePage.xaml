<Page
    x:Class="TCFModManager.App.Views.AppUpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    Title="{loc:Str Nav_About}"
    ScrollViewer.CanContentScroll="False">
    <!--
        ScrollViewer.CanContentScroll="False" on the Page itself opts this page out of WPF-UI's
        automatic outer DynamicScrollViewer (NavigationViewContentPresenter overrides the default
        for every Page in the app), leaving the ScrollViewer below as the only scrolling container.
        Same reason InstalledPage and DependenciesPage set it.
    -->
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
    </Page.Resources>

    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,16">

            <!--
                SSPTMM: what this app is, its version, and the app it is built on. Shown in place of
                the original's own-update section below, which only applies to the original.
            -->
            <ui:Card Padding="16" Visibility="{Binding IsFork, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding AppName, Mode=OneWay}" />
                    <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding VersionLine, Mode=OneWay}" />
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{loc:Str About_Description}" />
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding BasedOnLine, Mode=OneWay}" />
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{loc:Str About_Updates}" />

                    <!-- Fork: a newer release on GitHub. Told, never installed: the button opens the
                         release page in the browser. -->
                    <Border
                        Margin="0,12,0,0"
                        Padding="12"
                        CornerRadius="4"
                        Background="#66000000"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ReleaseTitle, Mode=OneWay}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding ReleaseDetails, Mode=OneWay}"
                                Visibility="{Binding ReleaseDetails, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{loc:Str About_UpdateBody}" />
                            <ui:Button
                                Margin="0,10,0,0"
                                Appearance="Primary"
                                Content="{loc:Str About_OpenRelease}"
                                Icon="{ui:SymbolIcon Open24}"
                                Command="{Binding OpenModPageCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- ShowNewestRelease, not !UpdateAvailable: a check that hasn't run, failed, or
                         found nothing to compare with must not claim this is the newest release. -->
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="{loc:Str About_UpToDate}"
                        Visibility="{Binding ShowNewestRelease, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding CheckError, Mode=OneWay}"
                        Visibility="{Binding CheckError, Converter={StaticResource NullToCollapsed}}" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Content="{loc:Str AppUpdate_CheckNow}"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Command="{Binding CheckForUpdatesCommand}" />
                        <ui:Button
                            Content="{loc:Str About_SourceLink}"
                            Icon="{ui:SymbolIcon Open24}"
                            Command="{Binding OpenRepositoryCommand}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Transparent"
                            Content="{loc:Str About_OriginalLink}"
                            Icon="{ui:SymbolIcon Open24}"
                            Command="{Binding OpenOriginalCommand}" />
                        <ui:ProgressRing
                            Width="20"
                            Height="20"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsIndeterminate="True"
                            Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <!-- Fork (1.2.0): the answer to the one-time question, changeable here. -->
                    <CheckBox
                        Margin="0,12,0,0"
                        Content="{loc:Str AppUpdate_CheckAtStart}"
                        ToolTip="{loc:Str AppUpdate_CheckAtStartToolTip}"
                        IsChecked="{Binding CheckForNewReleases}" />
                </StackPanel>
            </ui:Card>

            <StackPanel Visibility="{Binding IsFork, Converter={StaticResource FalseToVisible}}">
            <!-- Where this comes from. Stated up front rather than buried, because "an app that
                 updates itself" is worth being unambiguous about. -->
            <ui:InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="{loc:Str AppUpdate_InfoTitle}"
                Message="{loc:Str AppUpdate_InfoMessage}" />

            <ui:Card Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock
                        Text="{loc:Str AppUpdate_VersionHeader}"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Str AppUpdate_InstalledLabel}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding CurrentVersion, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,4"
                        Visibility="{Binding LatestVersion, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Str AppUpdate_LatestLabel}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding LatestVersion, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button
                            Content="{loc:Str AppUpdate_CheckNow}"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Command="{Binding CheckForUpdatesCommand}" />
                        <ui:ProgressRing
                            Width="20"
                            Height="20"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsIndeterminate="True"
                            Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Error"
                        Title="{loc:Str AppUpdate_CheckFailedTitle}"
                        Message="{Binding CheckError}"
                        Visibility="{Binding CheckError, Converter={StaticResource NullToCollapsed}}" />

                    <!-- ShowUpToDate, not !UpdateAvailable: a page that hasn't checked yet, or whose
                         check failed, must not claim the app is up to date. -->
                    <TextBlock
                        Margin="0,12,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="{loc:Str AppUpdate_UpToDate}"
                        Visibility="{Binding ShowUpToDate, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ui:Card>
            </StackPanel>

            <!-- The Server Map mod. Installed by hand on the machine running the server, so this
                 card only ever says it is behind and links its page - there is no install button.
                 Shown on the server's own machine (the files on disk) and on a machine connected
                 to a server (what that server's /hello reports). -->
            <ui:Card
                Padding="16"
                Margin="0,16,0,0"
                Visibility="{Binding ShowServerMapMod, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock
                        Text="{loc:Str AppUpdate_ServerMapHeader}"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8" />

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,4"
                        Visibility="{Binding HasServerMapLocal, Converter={StaticResource BoolToVis}}">
                        <TextBlock Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Str AppUpdate_ServerMapLocalLabel}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding ServerMapLocalVersion, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,4"
                        Visibility="{Binding HasServerMapConnected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Str AppUpdate_ServerMapConnectedLabel}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding ServerMapConnectedVersion, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,4"
                        Visibility="{Binding ServerMapLatestVersion, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Str AppUpdate_LatestLabel}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding ServerMapLatestVersion, Mode=OneWay}" />
                    </StackPanel>

                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="{loc:Str AppUpdate_ServerMapBehindTitle}"
                        Message="{Binding ServerMapLocalBehindMessage}"
                        Visibility="{Binding ServerMapLocalBehind, Converter={StaticResource BoolToVis}}" />

                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="{loc:Str AppUpdate_ServerMapStubBehindTitle}"
                        Message="{Binding ServerMapStubBehindMessage}"
                        Visibility="{Binding ServerMapStubBehind, Converter={StaticResource BoolToVis}}" />

                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="{loc:Str AppUpdate_ServerMapBehindTitle}"
                        Message="{Binding ServerMapConnectedBehindMessage}"
                        Visibility="{Binding ServerMapConnectedBehind, Converter={StaticResource BoolToVis}}" />

                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="{loc:Str AppUpdate_ServerMapUpToDate}"
                        Visibility="{Binding ShowServerMapUpToDate, Converter={StaticResource BoolToVis}}" />

                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="{loc:Str AppUpdate_ServerMapCheckFailed}"
                        Visibility="{Binding ServerMapCheckFailed, Converter={StaticResource BoolToVis}}" />

                    <ui:Button
                        Margin="0,12,0,0"
                        Content="{loc:Str AppUpdate_ServerMapOpenPage}"
                        Icon="{ui:SymbolIcon Open24}"
                        Command="{Binding OpenServerMapModPageCommand}" />
                </StackPanel>
            </ui:Card>

            <!-- Everything below only exists when there's actually something newer. -->
            <StackPanel Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">

                <ui:Card
                    Padding="16"
                    Margin="0,16,0,0"
                    Visibility="{Binding ShowOriginalUpdateCard, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock
                            Text="{Binding ChangeTitle}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Margin="0,0,0,6" />

                        <TextBlock
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Margin="0,0,0,10"
                            Text="{Binding ChangeSummary}" />

                        <!-- The version-numbering key, spelled out so the summary above lands even
                             for someone who's never thought about what the three numbers mean. -->
                        <Border
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontSize="11"
                                    Margin="0,0,0,6"
                                    Text="{loc:Str AppUpdate_VersionGuideHeader}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                    <Run FontWeight="SemiBold" Text="{loc:Str AppUpdate_PatternPatch}" /><Run Text=" - " /><Run Text="{loc:Str AppUpdate_PatchNote}" />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                    <Run FontWeight="SemiBold" Text="{loc:Str AppUpdate_PatternMinor}" /><Run Text=" - " /><Run Text="{loc:Str AppUpdate_MinorNote}" />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="{loc:Str AppUpdate_PatternMajor}" /><Run Text=" - " /><Run Text="{loc:Str AppUpdate_MajorNote}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                FontSize="12"
                                Text="{Binding PublishedText}"
                                Visibility="{Binding PublishedText, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                FontSize="12"
                                Margin="12,0,0,0"
                                Text="{Binding DownloadSizeText}"
                                Visibility="{Binding DownloadSizeText, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                Content="{loc:Str AppUpdate_OpenModPage}"
                                Icon="{ui:SymbolIcon Open24}"
                                Command="{Binding OpenModPageCommand}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Content="{loc:Str AppUpdate_DownloadAndInstall}"
                                Icon="{ui:SymbolIcon ArrowDownload24}"
                                Command="{Binding InstallUpdateCommand}"
                                Visibility="{Binding CanInstallHere, Converter={StaticResource BoolToVis}}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Content="{loc:Str Common_Cancel}"
                                Command="{Binding CancelInstallCommand}"
                                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Text="{loc:Str AppUpdate_InstallNote}"
                            Visibility="{Binding CanInstallHere, Converter={StaticResource BoolToVis}}" />

                        <StackPanel
                            Margin="0,12,0,0"
                            Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Margin="0,0,0,6"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding InstallStatus}" />
                            <ProgressBar
                                Height="6"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding InstallProgress, Mode=OneWay}" />
                        </StackPanel>

                        <ui:InfoBar
                            Margin="0,12,0,0"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Error"
                            Title="{loc:Str AppUpdate_NotAppliedTitle}"
                            Message="{Binding InstallError}"
                            Visibility="{Binding InstallError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Padding="16"
                    Margin="0,16,0,0"
                    Visibility="{Binding Changelog, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel>
                        <TextBlock
                            Text="{loc:Str AppUpdate_WhatsNew}"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8" />
                        <!-- Same renderer the mod update dialog uses for a version's release notes. -->
                        <RichTextBox
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            IsReadOnly="True"
                            IsDocumentEnabled="True"
                            Focusable="False"
                            VerticalScrollBarVisibility="Disabled"
                            HorizontalScrollBarVisibility="Disabled"
                            behaviors:HtmlText.Html="{Binding Changelog}" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
