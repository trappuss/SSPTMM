<!--
    A mod's Workshop item page, drawn after Steam's (steamcommunity.com/sharedfiles/filedetails).
    It opens over the page area, under the hub tabs, whenever a mod is opened anywhere in the app,
    and closes on Esc or its Workshop breadcrumb.

    Steam's item page is still its older design: flat #1B2838, 950px wide and centred. Measured:
    12px #8F98A0 breadcrumbs; a 30px light title with the rating to its right; 14px/500 tabs with a
    3px #1A9FFF bar; a header panel in a blue gradient (rgba(64,128,183) at .4 fading to .2) with a
    636x358 preview on black, the details beside it (labels #5C8699 13px, values #EBEBEB 14px,
    stats #8F98A0) and #939393 buttons on rgba(0,0,0,.4) under it; the subscribe box at
    rgba(21,21,21,.36) with a #35465E edge, 13px light #5C8699 over a 20px bold name, and the green
    button; the 295px right column of panels (rgba(0,0,0) .2 to .5 left to right, 11px upper-case
    #8F98A0 titles, required items on rgba(84,133,183,.2), stats in #6088BB); and the description
    under an 11px #61696D "DESCRIPTION" and a rule.

    Where Steam has star ratings, discussions and comments, this has what sp-mod.com publishes:
    endorsements, favourites and downloads, and each version's changelog as the Change Notes tab.
-->
<UserControl
    x:Class="TCFModManager.App.Views.WorkshopItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:TCFModManager.App.Views"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:app="clr-namespace:TCFModManager.App"
    xmlns:markup="clr-namespace:TCFModManager.App.Behaviors.Markup"
    Focusable="True"
    FocusVisualStyle="{x:Null}"
    KeyDown="View_KeyDown">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:UpdateAvailableToVisibilityConverter x:Key="TrueToVisible" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <converters:EqualityConverter x:Key="IsSame" />
        <converters:LocalTimeConverter x:Key="LocalTime" />

        <!-- A breadcrumb: 12px #8F98A0, white under the pointer. -->
        <Style x:Key="Crumb" TargetType="Button" BasedOn="{StaticResource SteamLinkButton}">
            <Setter Property="Foreground" Value="{StaticResource SteamTextDim}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- A row in a right-hand panel that opens something: Steam's required-item rows. -->
        <Style x:Key="PanelRow" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="{StaticResource SteamRequiredItem}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#555485B7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One of the right-hand panels' mod rows: a small picture and the name. -->
        <DataTemplate x:Key="RelatedRow">
            <Button
                Padding="5"
                Style="{StaticResource PanelRow}"
                behaviors:ModContextMenu.Mod="{Binding Mod}"
                Command="{Binding DataContext.OpenRelatedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}">
                <DockPanel>
                    <Border Width="40" Height="40" Margin="0,0,8,0" Background="Black" ClipToBounds="True">
                        <Image Stretch="UniformToFill" behaviors:ThumbnailLoader.DecodeWidth="40" behaviors:ThumbnailLoader.Source="{Binding Thumbnail}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="13" Foreground="{StaticResource SteamValueText}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                        <TextBlock FontSize="11" Foreground="{StaticResource SteamTextDim}" TextTrimming="CharacterEllipsis" Text="{Binding Author, StringFormat={loc:Str Browse_ByAuthorFormat}}" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>

        <!-- Steam's highlight strip slider: black track, a grey handle that lightens under the pointer. -->
        <Style x:Key="StripScrollBar" TargetType="ScrollBar">
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Black">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Handle" MinWidth="60">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Offset="0" Color="#706E6B" />
                                                            <GradientStop Offset="1" Color="#5A5856" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Handle" Property="Background" Value="#82807C" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The header's label/value pairs: "Content Type:" in #5C8699, the value in #EBEBEB 14px. -->
        <Style x:Key="DetailLabel" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource SteamLabelBlue}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="DetailValue" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource SteamValueText}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SteamLegacyBackground}">
        <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="950" Margin="24,20,24,40">

                <!-- Breadcrumbs: SPT > Workshop > <author>'s Workshop. -->
                <StackPanel Orientation="Horizontal" TextElement.FontSize="12" TextElement.Foreground="{StaticResource SteamTextDim}">
                    <Button Style="{StaticResource Crumb}" ToolTip="{loc:Str Item_CloseToolTip}" Click="Workshop_Click">
                        <TextBlock Text="{loc:Str Hub_Title}" />
                    </Button>
                    <Path Width="4" Height="7" Margin="6,1,6,0" VerticalAlignment="Center" Data="M0,0 L4,3.5 L0,7" Stretch="Fill" Stroke="{StaticResource SteamTextDim}" StrokeThickness="1" />
                    <Button Style="{StaticResource Crumb}" ToolTip="{loc:Str Item_CloseToolTip}" Click="Workshop_Click">
                        <TextBlock Text="{loc:Str Nav_Workshop}" />
                    </Button>
                    <Path Width="4" Height="7" Margin="6,1,6,0" VerticalAlignment="Center" Data="M0,0 L4,3.5 L0,7" Stretch="Fill" Stroke="{StaticResource SteamTextDim}" StrokeThickness="1" Visibility="{Binding AuthorsWorkshop, Converter={StaticResource NullToCollapsed}}" />
                    <Button Style="{StaticResource Crumb}" Command="{Binding OpenAuthorsWorkshopCommand}" Visibility="{Binding AuthorsWorkshop, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding AuthorsWorkshop}" />
                    </Button>
                </StackPanel>

                <!-- Title, and where Steam's stars sit, the endorsement count. -->
                <DockPanel Margin="0,4,0,0">
                    <StackPanel
                        DockPanel.Dock="Right"
                        Margin="10,0,20,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasEndorsements, Converter={StaticResource TrueToVisible}}">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="26" Filled="True" Foreground="#8BC53F" Symbol="ThumbLike24" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="22" Foreground="#8BC53F" Text="{Binding Endorsements, StringFormat=N0}" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#919191" Text="{Binding Endorsements, StringFormat={loc:Str Browse_EndorsementsFormat}}" />
                    </StackPanel>
                    <TextBlock
                        FontFamily="{StaticResource SteamFontLight}"
                        FontWeight="Light"
                        FontSize="30"
                        Foreground="{StaticResource SteamWhite}"
                        TextTrimming="CharacterEllipsis"
                        Text="{Binding Name}" />
                </DockPanel>

                <!-- Description | Change Notes. -->
                <StackPanel Margin="0,24,0,14" Orientation="Horizontal">
                    <ToggleButton
                        Style="{StaticResource SteamSectionTab}"
                        Command="{Binding ShowDescriptionCommand}"
                        IsChecked="{Binding IsDescriptionShown, Mode=OneWay}">
                        <TextBlock Text="{loc:Str Item_TabDescription}" />
                    </ToggleButton>
                    <!-- Steam's own order: Description, Comments, Change Notes. Versions is sp-mod.com's. -->
                    <ToggleButton
                        Style="{StaticResource SteamSectionTab}"
                        Command="{Binding ShowCommentsCommand}"
                        IsChecked="{Binding IsCommentsShown, Mode=OneWay}"
                        Visibility="{Binding HasModPage, Converter={StaticResource TrueToVisible}}">
                        <TextBlock Text="{loc:Str Item_TabComments}" />
                    </ToggleButton>
                    <ToggleButton
                        Style="{StaticResource SteamSectionTab}"
                        Command="{Binding ShowChangeNotesCommand}"
                        IsChecked="{Binding IsChangeNotesShown, Mode=OneWay}">
                        <TextBlock Text="{loc:Str Item_TabChangeNotes}" />
                    </ToggleButton>
                    <ToggleButton
                        Style="{StaticResource SteamSectionTab}"
                        Command="{Binding ShowVersionsCommand}"
                        IsChecked="{Binding IsVersionsShown, Mode=OneWay}">
                        <TextBlock Text="{Binding VersionsTabTitle}" />
                    </ToggleButton>
                </StackPanel>

                <!-- ============================================================ Description tab -->
                <StackPanel Visibility="{Binding IsDescriptionShown, Converter={StaticResource TrueToVisible}}">

                    <!-- The header panel. -->
                    <Border Padding="15" Background="{StaticResource SteamItemHeaderBackground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="636*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="268*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <!-- The chosen picture or video, 636x358 on black; a click opens it full size. -->
                                <Grid Height="358" Background="Black" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="Preview_MouseLeftButtonUp">
                                    <markup:RemotePicture
                                        x:Name="PreviewPicture"
                                        LimitToNaturalSize="False"
                                        Stretch="Uniform"
                                        Url="{Binding SelectedMedia.Thumbnail}" />
                                    <Grid Width="68" Height="48" Visibility="{Binding SelectedIsVideo, Converter={StaticResource TrueToVisible}}">
                                        <Border Background="#E6212121" CornerRadius="12" />
                                        <Path Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L18,11 L0,22 Z" Fill="White" />
                                    </Grid>
                                </Grid>

                                <!-- Steam's highlight strip: every picture and video, 116x65 on black, the
                                     chosen one framed; a slider under it when they do not all fit. -->
                                <Border Margin="0,1,0,0" Padding="7,7,7,0" Background="#80000000" Visibility="{Binding HasGallery, Converter={StaticResource TrueToVisible}}">
                                    <StackPanel>
                                        <ScrollViewer x:Name="Strip" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ScrollChanged="Strip_ScrollChanged">
                                            <ItemsControl ItemsSource="{Binding Gallery}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            Width="116"
                                                            Height="65"
                                                            Margin="0,0,3,6"
                                                            Cursor="Hand"
                                                            FocusVisualStyle="{x:Null}"
                                                            Command="{Binding DataContext.SelectMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid Background="Black">
                                                                        <ContentPresenter />
                                                                        <Border x:Name="Frame" BorderBrush="#97C0E3" BorderThickness="0" />
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Value="True">
                                                                            <DataTrigger.Binding>
                                                                                <MultiBinding Converter="{StaticResource IsSame}">
                                                                                    <Binding />
                                                                                    <Binding Path="DataContext.SelectedMedia" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                                </MultiBinding>
                                                                            </DataTrigger.Binding>
                                                                            <Setter TargetName="Frame" Property="BorderThickness" Value="1" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Grid ClipToBounds="True">
                                                                <Image Stretch="Uniform" behaviors:ThumbnailLoader.DecodeWidth="116" behaviors:ThumbnailLoader.Source="{Binding Thumbnail}" />
                                                                <Grid Width="32" Height="32" ToolTip="{loc:Str Item_PlayVideo}">
                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="Video">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>
                                                                    <Ellipse Fill="#B3000000" Stroke="White" StrokeThickness="1.5" />
                                                                    <Path Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L10,6 L0,12 Z" Fill="White" />
                                                                </Grid>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <ScrollBar
                                            x:Name="StripSlider"
                                            Orientation="Horizontal"
                                            Style="{StaticResource StripScrollBar}"
                                            Scroll="StripSlider_Scroll" />
                                    </StackPanel>
                                </Border>

                                <!-- Steam's row of small buttons under the preview. -->
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Margin="0,0,5,5" Style="{StaticResource SteamGeneralButton}" Command="{Binding ViewModPageCommand}" Visibility="{Binding HasModPage, Converter={StaticResource TrueToVisible}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Open16" />
                                            <TextBlock Text="{loc:Str Common_ViewModPage}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="0,0,5,5" Style="{StaticResource SteamGeneralButton}" Command="{Binding CopyLinkCommand}" Visibility="{Binding HasModPage, Converter={StaticResource TrueToVisible}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Share16" />
                                            <TextBlock Text="{loc:Str Item_CopyLink}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="0,0,5,5" Style="{StaticResource SteamGeneralButton}" Command="{Binding AddToCollectionCommand}" ToolTip="{loc:Str Collection_AddToolTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="AddSquareMultiple16" />
                                            <TextBlock Text="{loc:Str Collection_AddTitle}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Visibility="{Binding Category, Converter={StaticResource NullToCollapsed}}">
                                    <Run Style="{StaticResource DetailLabel}" Text="{loc:Str Item_ContentTypeLabel}" />
                                    <Run Style="{StaticResource DetailValue}" Text="{Binding Category, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Visibility="{Binding Tags, Converter={StaticResource NullToCollapsed}}">
                                    <Run Style="{StaticResource DetailLabel}" Text="{loc:Str Item_TagsLabel}" />
                                    <Run Style="{StaticResource DetailValue}" Text="{Binding Tags, Mode=OneWay}" />
                                </TextBlock>
                                <!-- The licence, opening its text when sp-mod.com links one. -->
                                <WrapPanel Margin="0,0,0,6" Visibility="{Binding License, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Margin="0,0,4,0" VerticalAlignment="Center">
                                        <Run Style="{StaticResource DetailLabel}" Text="{loc:Str Item_LicenseLabel}" />
                                    </TextBlock>
                                    <TextBlock VerticalAlignment="Center" Visibility="{Binding HasLicenseLink, Converter={StaticResource FalseToVisible}}">
                                        <Run Style="{StaticResource DetailValue}" Text="{Binding License, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SteamLinkButton}"
                                        Foreground="{StaticResource SteamValueText}"
                                        Command="{Binding OpenLicenseCommand}"
                                        ToolTip="{Binding Mod.License.Link}"
                                        Visibility="{Binding HasLicenseLink, Converter={StaticResource TrueToVisible}}">
                                        <TextBlock FontSize="14" TextDecorations="Underline" Text="{Binding License}" />
                                    </Button>
                                </WrapPanel>

                                <!-- The rest of sp-mod.com's Details panel: the plugin id, the
                                     source code, and the VirusTotal scans of the version Subscribe
                                     would install. -->
                                <TextBlock Margin="0,0,0,6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Guid}" Visibility="{Binding Guid, Converter={StaticResource NullToCollapsed}}">
                                    <Run Style="{StaticResource DetailLabel}" Text="{loc:Str Item_GuidLabel}" />
                                    <Run Style="{StaticResource DetailValue}" FontFamily="{StaticResource SteamMonospace}" FontSize="13" Text="{Binding Guid, Mode=OneWay}" />
                                </TextBlock>
                                <StackPanel Margin="0,0,0,6" Visibility="{Binding HasSourceCode, Converter={StaticResource TrueToVisible}}">
                                    <TextBlock>
                                        <Run Style="{StaticResource DetailLabel}" Text="{loc:Str Item_SourceCodeLabel}" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding SourceCode}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SteamLinkButton}"
                                                    Command="{Binding DataContext.OpenWebLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding Url}">
                                                    <TextBlock FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding Text}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <WrapPanel Margin="0,0,0,6" Visibility="{Binding HasVirusTotal, Converter={StaticResource TrueToVisible}}">
                                    <TextBlock Margin="0,0,4,0">
                                        <Run Style="{StaticResource DetailLabel}" Text="{loc:Str Item_VirusTotalLabel}" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding VirusTotal}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Margin="0,0,8,0"
                                                    Style="{StaticResource SteamLinkButton}"
                                                    Command="{Binding DataContext.OpenWebLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding Url}">
                                                    <TextBlock FontSize="13" Text="{Binding Text}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>

                                <!-- Which SPT the release Subscribe would fetch runs on. -->
                                <TextBlock Margin="0,0,0,6" FontSize="13" TextWrapping="Wrap" ToolTip="{Binding Card.SptVersionTooltip}">
                                    <Run Style="{StaticResource CompatibilityText}" DataContext="{Binding Card}" Text="{Binding SptVersionDisplay, Mode=OneWay}" />
                                    <Run Foreground="{StaticResource SteamTextDim}" Text="{Binding Card.DisplayReleaseVersion, Mode=OneWay, StringFormat='v{0}'}" />
                                </TextBlock>

                                <Rectangle Height="1" Margin="0,8,0,10" Fill="#335485B7" />

                                <Grid TextElement.FontSize="13" TextElement.Foreground="{StaticResource SteamTextDim}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Margin="0,0,24,4" Text="{loc:Str Item_FileSize}" Visibility="{Binding FileSize, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileSize}" Visibility="{Binding FileSize, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Grid.Row="1" Margin="0,0,24,4" Text="{loc:Str Item_Posted}" Visibility="{Binding PostedAt, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PostedText}" ToolTip="{Binding PostedToolTip}" Visibility="{Binding PostedAt, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Grid.Row="2" Margin="0,0,24,4" Text="{loc:Str Item_Updated}" Visibility="{Binding UpdatedAt, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UpdatedText}" ToolTip="{Binding UpdatedToolTip}" Visibility="{Binding UpdatedAt, Converter={StaticResource NullToCollapsed}}" />
                                </Grid>

                                <Button Margin="0,4,0,0" HorizontalAlignment="Left" Style="{StaticResource SteamLinkButton}" Foreground="#2F89BC" Command="{Binding ShowChangeNotesCommand}">
                                    <TextBlock FontSize="13">
                                        <Run Text="{Binding ChangeNotesLink, Mode=OneWay}" />
                                        <Run Foreground="#E5E5E5" Text="{loc:Str Item_View}" />
                                    </TextBlock>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Under the header: the subscribe box and the description on the left, the
                         panels on the right. -->
                    <!-- sp-mod.com's notices, where the choice to subscribe is made: a mod that
                         works like a multiplayer cheat (red on the site) and one that may change a
                         profile for good (amber). Steam has nothing like them; their colours and
                         words are the site's. -->
                    <StackPanel Margin="0,22,0,-22">
                        <Border
                            Margin="0,8,0,0"
                            Padding="14,10"
                            Background="#B91C1C"
                            Visibility="{Binding HasCheatNotice, Converter={StaticResource TrueToVisible}}">
                            <DockPanel>
                                <ui:SymbolIcon Margin="0,1,10,0" VerticalAlignment="Top" FontSize="18" Foreground="White" Filled="True" Symbol="Warning16" />
                                <TextBlock FontSize="14" Foreground="White" TextWrapping="Wrap">
                                    <Run FontWeight="Bold" Text="{loc:Str Item_CheatNoticeLead}" />
                                    <Run Text="{loc:Str Item_CheatNotice}" />
                                    <Hyperlink Command="{Binding OpenCheatGuidelinesCommand}" Foreground="White">
                                        <Run Text="{loc:Str Item_CheatNoticeMore}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                        <Border
                            Margin="0,8,0,0"
                            Padding="14,10"
                            Background="#D97706"
                            Visibility="{Binding HasProfileNotice, Converter={StaticResource TrueToVisible}}">
                            <DockPanel>
                                <ui:SymbolIcon Margin="0,1,10,0" VerticalAlignment="Top" FontSize="18" Foreground="White" Filled="True" Symbol="Warning16" />
                                <TextBlock FontSize="14" Foreground="White" TextWrapping="Wrap">
                                    <Run FontWeight="Bold" Text="{loc:Str Item_ProfileNoticeLead}" />
                                    <Run Text="{loc:Str Item_ProfileNotice}" />
                                    <Hyperlink Command="{Binding OpenProfileNoticeCommand}" Foreground="White">
                                        <Run Text="{loc:Str Item_ProfileNoticeMore}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="655*" />
                            <ColumnDefinition Width="295*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Padding="16" Background="{StaticResource SteamSubscribeBox}" BorderBrush="{StaticResource SteamSubscribeBoxBorder}" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Orientation="Horizontal">
                                        <!-- Update, beside the green button, when a newer release
                                             for this SPT is out. -->
                                        <Button
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Top"
                                            MinHeight="34"
                                            Style="{StaticResource SteamBlueButton}"
                                            Command="{Binding UpdateCommand}"
                                            Visibility="{Binding CanUpdate, Converter={StaticResource TrueToVisible}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="ArrowSync16" />
                                                <TextBlock Text="{loc:Str ModUpdate_Update}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Subscribe, or - once installed - Subscribed, which
                                             turns into Unsubscribe under the pointer, exactly as
                                             Steam's does. -->
                                        <Button
                                            x:Name="SubscribeButton"
                                            MinWidth="144"
                                            Style="{StaticResource SteamGreenButton}"
                                            Command="{Binding SubscribeCommand}"
                                            ToolTip="{Binding InstallToolTip, Source={x:Static app:AppServices.ModPageGate}}"
                                            Visibility="{Binding IsSubscribed, Converter={StaticResource FalseToVisible}}">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInQueue}" Value="True">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCheckingRequirements}" Value="True">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ui:SymbolIcon Margin="0,0,14,0" FontSize="16" Symbol="Add16" />
                                                    <TextBlock Text="{loc:Str Item_Subscribe}" />
                                                </StackPanel>
                                                <!-- While Subscribe works out what the mod needs. -->
                                                <TextBlock HorizontalAlignment="Center" Text="{loc:Str Item_Checking}" Visibility="{Binding IsCheckingRequirements, Converter={StaticResource TrueToVisible}}" />
                                                <!-- While it downloads and installs: how far, in the button. -->
                                                <StackPanel MinWidth="160" Visibility="{Binding IsInQueue, Converter={StaticResource TrueToVisible}}">
                                                    <TextBlock HorizontalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding QueueStatus}" />
                                                    <ProgressBar
                                                        Height="4"
                                                        Margin="0,4,0,0"
                                                        Maximum="1"
                                                        Foreground="White"
                                                        Background="#40000000"
                                                        IsIndeterminate="{Binding IsQueueIndeterminate, Mode=OneWay}"
                                                        Value="{Binding QueueProgress, Mode=OneWay}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="SubscribedButton"
                                            MinWidth="144"
                                            Style="{StaticResource SteamGreenButton}"
                                            Command="{Binding UnsubscribeCommand}"
                                            Visibility="{Binding IsSubscribed, Converter={StaticResource TrueToVisible}}">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ui:SymbolIcon Margin="0,0,14,0" FontSize="16" Symbol="Checkmark16" />
                                                    <TextBlock Text="{loc:Str Item_Subscribed}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ui:SymbolIcon Margin="0,0,14,0" FontSize="16" Symbol="Dismiss16" />
                                                    <TextBlock Text="{loc:Str Item_Unsubscribe}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock FontFamily="{StaticResource SteamFontLight}" FontWeight="Light" FontSize="13" Foreground="{StaticResource SteamLabelBlue}" Text="{loc:Str Item_SubscribeToDownload}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SteamWhite}" TextWrapping="Wrap" Text="{Binding Name}" />
                                        <!-- Installed / update available / disabled, in the app's own words. -->
                                        <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#A4D007" TextWrapping="Wrap" Text="{Binding StatusLine}" Visibility="{Binding StatusLine, Converter={StaticResource NullToCollapsed}}" />
                                        <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource SteamLegacyBlue}" TextWrapping="Wrap" Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Steam's #JustSubscribed bar, straight under the box once the
                                 install asked for here has landed: rgba(64,128,183,.8), #66C0F4
                                 14px text with "Subscriptions" as a white link to Subscribed
                                 items, a tick at the left and a close X at the top right. -->
                            <Border
                                Padding="10"
                                Background="#CC4080B7"
                                Visibility="{Binding JustSubscribed, Converter={StaticResource TrueToVisible}}">
                                <DockPanel>
                                    <Button
                                        Width="16"
                                        Height="16"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Top"
                                        DockPanel.Dock="Right"
                                        Cursor="Hand"
                                        Focusable="False"
                                        Command="{Binding DismissJustSubscribedCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid x:Name="Glyph" Background="Transparent" Opacity="0.7">
                                                    <ui:SymbolIcon FontSize="16" Foreground="White" Symbol="Dismiss16" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <ui:SymbolIcon Margin="0,0,10,0" VerticalAlignment="Center" FontSize="20" Foreground="#66C0F4" Symbol="Checkmark20" />
                                    <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="#66C0F4" TextWrapping="Wrap">
                                        <Run Text="{Binding JustSubscribedBefore, Mode=OneWay}" /><Hyperlink Command="{Binding OpenSubscriptionsCommand}" Foreground="White" TextDecorations="None"><Run Text="{loc:Str Item_JustSubscribedLink}" /></Hyperlink><Run Text="{Binding JustSubscribedAfter, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            <!-- Steam's "In N Collections": your collections holding this item.
                                 Measured: an 11px upper-case #61696D title; rows rgba(84,133,183,.2),
                                 30px, 5px inside, 1px apart, rgba(117,186,255,.3) under the pointer;
                                 the name 14px bold white, the item count 14px #99A1A8 at the right. -->
                            <StackPanel Margin="0,20,0,0" Visibility="{Binding HasInCollections, Converter={StaticResource TrueToVisible}}">
                                <TextBlock Margin="0,0,0,6" FontSize="11" Foreground="#61696D" Text="{Binding InCollectionsTitle}" />
                                <ItemsControl ItemsSource="{Binding InCollections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.OpenCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                FocusVisualStyle="{x:Null}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Row" Height="30" Margin="0,0,0,1" Padding="5,0" Background="#335485B7">
                                                            <DockPanel VerticalAlignment="Center">
                                                                <TextBlock Margin="12,0,0,0" DockPanel.Dock="Right" FontSize="14" Foreground="#99A1A8" Text="{Binding CountText}" />
                                                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                            </DockPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="#4D75BAFF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- DESCRIPTION, with the rule over it. -->
                            <Rectangle Height="1" Margin="0,26,0,0" Fill="#1F2E40" />
                            <TextBlock Style="{StaticResource SteamDescriptionTitle}" Text="{loc:Str Item_DescriptionHeader}" />
                            <!-- Steam's description: 14px #ACB2B8 on 20px lines. The renderer
                                 colours the document from TextFillColorPrimaryBrush, so the local
                                 key below is what it finds first. -->
                            <RichTextBox
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Disabled"
                                IsDocumentEnabled="True"
                                IsReadOnly="True"
                                VerticalScrollBarVisibility="Disabled"
                                behaviors:HtmlText.Html="{Binding DescriptionHtml}">
                                <RichTextBox.Resources>
                                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#ACB2B8" />
                                    <Style TargetType="Paragraph">
                                        <Setter Property="LineHeight" Value="20" />
                                    </Style>
                                </RichTextBox.Resources>
                            </RichTextBox>

                            <!-- The mod's own addons; collapses when it has none. -->
                            <views:AddonsSection Margin="0,16,0,0" DataContext="{Binding Addons}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <!-- REQUIRED ITEMS: the dependencies of the version Subscribe fetches. -->
                            <Border Style="{StaticResource SteamRightPanel}" Visibility="{Binding HasRequiredItems, Converter={StaticResource TrueToVisible}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SteamRightPanelTitle}" Text="{loc:Str Item_RequiredItems}" />
                                    <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="{StaticResource SteamTextMinor}" TextWrapping="Wrap" Text="{loc:Str Item_RequiredItemsNote}" />
                                    <ItemsControl ItemsSource="{Binding RequiredItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Margin="0,0,0,1"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    behaviors:ModContextMenu.ModId="{Binding ModId}"
                                                    Command="{Binding DataContext.OpenRequiredCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Row" Padding="7" Background="{StaticResource SteamRequiredItem}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="#555485B7" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock FontSize="14" Foreground="{StaticResource SteamValueText}" TextWrapping="Wrap" Text="{Binding Label}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- CREATED BY. -->
                            <Border Style="{StaticResource SteamRightPanel}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SteamRightPanelTitle}" Text="{loc:Str Item_CreatedBy}" />
                                    <!-- Each name opens everything they made, in Browse. -->
                                    <ItemsControl ItemsSource="{Binding Authors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Margin="0,0,0,2"
                                                    Padding="6"
                                                    Style="{StaticResource PanelRow}"
                                                    ToolTip="{loc:Str Item_AuthorToolTip}"
                                                    Command="{Binding DataContext.OpenAuthorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="32" Height="32" Margin="0,0,8,0" Background="#3D4450" BorderBrush="#57CBDE" BorderThickness="1" ClipToBounds="True">
                                                            <Grid>
                                                                <ui:SymbolIcon FontSize="18" Foreground="{StaticResource SteamText}" Symbol="Person16" />
                                                                <Image Stretch="UniformToFill" behaviors:ThumbnailLoader.DecodeWidth="32" behaviors:ThumbnailLoader.Source="{Binding Photo}" />
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SteamValueText}" Text="{Binding Name}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- The counts, numbers in #6088BB. -->
                            <Border Style="{StaticResource SteamRightPanel}">
                                <Grid Margin="5,4,0,0" TextElement.FontSize="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Margin="0,0,12,3" HorizontalAlignment="Right" Foreground="{StaticResource SteamStatNumber}" Text="{Binding Downloads, StringFormat=N0}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{StaticResource SteamStatLabel}" Text="{loc:Str Item_StatDownloads}" />
                                    <TextBlock Grid.Row="1" Margin="0,0,12,3" HorizontalAlignment="Right" Foreground="{StaticResource SteamStatNumber}" Text="{Binding Favourites, StringFormat=N0}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{StaticResource SteamStatLabel}" Text="{loc:Str Item_StatFavourites}" />
                                    <TextBlock Grid.Row="2" Margin="0,0,12,3" HorizontalAlignment="Right" Foreground="{StaticResource SteamStatNumber}" Text="{Binding Endorsements, StringFormat=N0}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{StaticResource SteamStatLabel}" Text="{loc:Str Item_StatEndorsements}" />
                                </Grid>
                            </Border>

                            <!-- REQUIRED BY: the mods whose current release needs this one. -->
                            <Border Style="{StaticResource SteamRightPanel}" Visibility="{Binding HasRequiredBy, Converter={StaticResource TrueToVisible}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SteamRightPanelTitle}" Text="{Binding RequiredByTitle}" />
                                    <ItemsControl ItemsSource="{Binding RequiredBy}" ItemTemplate="{StaticResource RelatedRow}" />
                                </StackPanel>
                            </Border>

                            <!-- MORE BY <author>. -->
                            <Border Style="{StaticResource SteamRightPanel}" Visibility="{Binding HasMoreByAuthor, Converter={StaticResource TrueToVisible}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SteamRightPanelTitle}" Text="{Binding MoreByAuthorTitle}" />
                                    <ItemsControl ItemsSource="{Binding MoreByAuthor}" ItemTemplate="{StaticResource RelatedRow}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- ============================================================ Versions tab -->
                <!-- sp-mod.com's version cards: number and date, SPT, size, downloads, Fika, what
                     it needs, and a button to install that version. -->
                <StackPanel Visibility="{Binding IsVersionsShown, Converter={StaticResource TrueToVisible}}">
                    <ItemsControl ItemsSource="{Binding Versions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="16" Background="#33000000">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource SteamTextDim}" Text="{Binding PublishedAt, Converter={StaticResource LocalTime}, StringFormat={loc:Str Item_VersionReleasedFormat}}" Visibility="{Binding PublishedAt, Converter={StaticResource NullToCollapsed}}" />
                                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="13" Foreground="#A4D007" Text="{loc:Str Item_VersionFika}" Visibility="{Binding IsFikaCompatible, Converter={StaticResource TrueToVisible}}" />
                                            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Right" FontSize="13" Foreground="#A4D007" Text="{loc:Str Item_VersionInstalled}" Visibility="{Binding IsInstalled, Converter={StaticResource TrueToVisible}}" />
                                            <Button
                                                Margin="0,10,0,0"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource SteamButton}"
                                                Command="{Binding InstallCommand}"
                                                Content="{Binding InstallLabel}"
                                                Visibility="{Binding CanInstall, Converter={StaticResource TrueToVisible}}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock FontSize="20" Foreground="{StaticResource SteamWhite}" Text="{Binding Version}" />
                                            <WrapPanel Margin="0,6,0,0">
                                                <Border Margin="0,0,8,0" Padding="6,1" CornerRadius="2" Visibility="{Binding HasSptRange, Converter={StaticResource TrueToVisible}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#3D4450" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompatible}" Value="True">
                                                                    <Setter Property="Background" Value="#4C6B22" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCompatible}" Value="False">
                                                                    <Setter Property="Background" Value="#6B2222" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="12" Foreground="White" Text="{Binding SptRange, StringFormat='SPT {0}'}" />
                                                </Border>
                                                <TextBlock Margin="0,0,12,0" FontSize="13" Foreground="{StaticResource SteamText}" Text="{Binding Size}" Visibility="{Binding Size, Converter={StaticResource NullToCollapsed}}" />
                                                <TextBlock FontSize="13" Foreground="{StaticResource SteamText}" Text="{Binding Downloads, StringFormat={loc:Str Item_VersionDownloadsFormat}}" />
                                            </WrapPanel>
                                            <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="{StaticResource SteamText}" TextWrapping="Wrap" Visibility="{Binding HasDependencies, Converter={StaticResource TrueToVisible}}">
                                                <Run Foreground="{StaticResource SteamTextDim}" Text="{loc:Str Item_VersionDependencies}" />
                                                <Run Text="{Binding Dependencies, Mode=OneWay}" />
                                            </TextBlock>
                                            <WrapPanel Margin="0,6,0,0" Visibility="{Binding HasVirusTotal, Converter={StaticResource TrueToVisible}}">
                                                <TextBlock Margin="0,0,4,0" FontSize="13" Foreground="{StaticResource SteamTextDim}" Text="{loc:Str Item_VirusTotalLabel}" />
                                                <ItemsControl ItemsSource="{Binding VirusTotal}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                Margin="0,0,8,0"
                                                                Style="{StaticResource SteamLinkButton}"
                                                                Command="{Binding DataContext.OpenWebLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding Url}">
                                                                <TextBlock FontSize="13" Text="{Binding Text}" />
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </WrapPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource SteamText}"
                        Text="{loc:Str ModUpdate_LoadingVersions}"
                        Visibility="{Binding IsLoadingVersions, Converter={StaticResource TrueToVisible}}" />
                    <Button
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SteamButton}"
                        Command="{Binding LoadMoreVersionsCommand}"
                        Content="{loc:Str Item_VersionsMore}"
                        Visibility="{Binding CanLoadMoreVersions, Converter={StaticResource TrueToVisible}}" />
                </StackPanel>

                <!-- ============================================================ Comments tab -->
                <!-- sp-mod.com's own comments, embedded (see WorkshopItemView.xaml.cs). The page
                     does not scroll on this tab: the comments fill the space under the tabs and
                     scroll themselves. -->
                <StackPanel x:Name="CommentsTab" Visibility="{Binding IsCommentsShown, Converter={StaticResource TrueToVisible}}">
                    <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="{StaticResource SteamTextDim}" Text="{loc:Str Item_CommentsSignIn}" Visibility="{Binding Visibility, ElementName=CommentsHost}" />
                    <Border x:Name="CommentsHost" Background="#1B2838" />
                    <TextBlock x:Name="CommentsOff" Margin="0,20,0,0" HorizontalAlignment="Center" Foreground="{StaticResource SteamText}" Text="{loc:Str Item_CommentsNone}" Visibility="Collapsed" />
                    <StackPanel x:Name="CommentsFallback" Margin="0,20,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock MaxWidth="520" Foreground="{StaticResource SteamText}" TextAlignment="Center" TextWrapping="Wrap" Text="{loc:Str Item_CommentsUnavailable}" />
                        <Button Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource SteamBlueButton}" Content="{loc:Str Item_CommentsOpen}" Click="OpenComments_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- ============================================================ Change Notes tab -->
                <StackPanel Visibility="{Binding IsChangeNotesShown, Converter={StaticResource TrueToVisible}}">
                    <TextBlock
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource SteamText}"
                        Text="{loc:Str ModUpdate_LoadingVersions}"
                        Visibility="{Binding IsLoadingVersions, Converter={StaticResource TrueToVisible}}" />
                    <TextBlock
                        Margin="0,20,0,0"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding VersionsProblem}"
                        Visibility="{Binding VersionsProblem, Converter={StaticResource NullToCollapsed}}" />

                    <!-- Steam's Change Notes page: a bar saying how many are shown, then each
                         note as an "Update: <date>" headline in light blue, a byline, and the
                         notes in a dark box. Measured on sharedfiles/filedetails/changelog: 20px
                         light #67C1F5 headline 30px apart, 14px #99A1A8 byline, 14px #CFD8E1 body
                         on rgba(0,0,0,.2) with 16px padding; the bar rgba(0,0,0,.4), 12px. Where
                         Steam names the author the byline has the version and its SPT range. -->
                    <Border
                        Height="32"
                        Margin="0,0,0,4"
                        Padding="10,0"
                        Background="#66000000"
                        Visibility="{Binding ChangeNotesShowing, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#99A1A8" Text="{Binding ChangeNotesShowing}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding ChangeNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,26,0,0">
                                    <TextBlock
                                        FontFamily="{StaticResource SteamFontLight}"
                                        FontSize="20"
                                        Foreground="#67C1F5"
                                        TextWrapping="Wrap"
                                        Text="{Binding Headline}"
                                        Visibility="{Binding Headline, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="#99A1A8"
                                        TextWrapping="Wrap"
                                        Text="{Binding Byline}"
                                        Visibility="{Binding Byline, Converter={StaticResource NullToCollapsed}}" />
                                    <Border
                                        Margin="0,6,0,14"
                                        Padding="16"
                                        Background="#33000000"
                                        Visibility="{Binding Html, Converter={StaticResource NullToCollapsed}}">
                                        <RichTextBox
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="14"
                                            Foreground="#CFD8E1"
                                            Focusable="False"
                                            HorizontalScrollBarVisibility="Disabled"
                                            IsDocumentEnabled="True"
                                            IsReadOnly="True"
                                            VerticalScrollBarVisibility="Disabled"
                                            behaviors:HtmlText.Html="{Binding Html}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SteamButton}"
                        Command="{Binding LoadMoreVersionsCommand}"
                        Content="{loc:Str Item_ChangeNotesMore}"
                        Visibility="{Binding CanLoadMoreVersions, Converter={StaticResource TrueToVisible}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
