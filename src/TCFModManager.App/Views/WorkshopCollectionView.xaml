<!--
    A collection's Workshop page (steamcommunity.com/sharedfiles/filedetails for a collection),
    for one of this install's mod lists.

    Measured on a 34-item collection (2026-09-24): the title bar rgba(27,27,27,.8), 75px, the name in
    30px light white 16px in; the control row under it rgba(42,60,83,.8) with a 1px #233245 top edge.
    Items: "ITEMS (34)" 11px upper case #61696D with the count #939393; an rgba(0,0,0,.2) bar with
    Subscribe to all / Unsubscribe from all / Save to Collection (30px, 14px #939393 on
    rgba(0,0,0,.4), radius 3, #97C0E3 with #3C3D3E text under the pointer); rows rgba(84,133,183,.2)
    2px apart with a 100px picture, the name 16px light white, "Created by" 12px #969696 with the
    name #8F98A0, one line of description 14px #969696, and a 32x30 square subscribe button - green
    with a plus, or once subscribed a #567397 outline and a tick that turns into a grey x under the
    pointer. The right-hand panel: "A COLLECTION OF N ITEMS CREATED BY" and a chip per author (14px
    #66C0F4 on rgba(102,192,244,.4); white on #66C0F4 under the pointer), then Posted and Updated.

    The rest measured again 2026-09-26 on a 235-item collection: Description / Comments tabs (14px,
    3px #1A9FFF under the chosen one, 20px above and 12 below); the header 950x470 - the collection's
    picture 948px wide with the title bar over its top; 25px down, two columns 645 and 295 apart by
    10. Each left section starts with a 1px #35465E rule 7px down, then its heading 11px upper case
    #61696D, the description 14px #ACB2B8 on 20px lines. The right panel: a gradient from
    rgba(0,0,0,.2) to rgba(0,0,0,.5) left to right, 10 10 10 11 inside; "COLLECTION ASSEMBLED BY"
    over a 44px rgba(84,133,183,.2) block with a 36px picture and the name 11px; then the numbers
    13px, figure and label side by side.

    Steam's header picture is one the collection's author uploads. A list here has one when its
    author gave sp-mod.com one; otherwise its own items' pictures stand in, six by three - or, with
    fewer than eighteen different ones, its first item's picture. Ratings,
    visitors and favourites are Steam's and have nothing behind them on sp-mod.com: left out.
-->
<UserControl
    x:Class="TCFModManager.App.Views.WorkshopCollectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Focusable="True"
    FocusVisualStyle="{x:Null}"
    KeyDown="View_KeyDown">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:UpdateAvailableToVisibilityConverter x:Key="TrueToVisible" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />

        <Style x:Key="Crumb" TargetType="Button" BasedOn="{StaticResource SteamLinkButton}">
            <Setter Property="Foreground" Value="{StaticResource SteamTextDim}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- general_btn subscribe: the collection bar's three buttons. -->
        <Style x:Key="CollectionBarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#939393" />
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Padding="10,0,12,0" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#97C0E3" />
                                <Setter Property="Foreground" Value="#3C3D3E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An author chip in the right-hand panel. -->
        <Style x:Key="AuthorChip" TargetType="Button">
            <Setter Property="Foreground" Value="#66C0F4" />
            <Setter Property="Background" Value="#6666C0F4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Padding="6,3,6,2" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#66C0F4" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The square subscribe button on each row. -->
        <Style x:Key="SquareSubscribe" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Not subscribed: Steam's green with a plus. -->
                            <Border x:Name="Plus" Background="{StaticResource SteamGreenInner}" CornerRadius="2">
                                <ui:SymbolIcon FontSize="16" Foreground="#D2E885" Symbol="Add16" />
                            </Border>
                            <!-- Subscribed: an outline and a tick... -->
                            <Border x:Name="Tick" BorderBrush="#567397" BorderThickness="1" CornerRadius="2" Visibility="Collapsed">
                                <ui:SymbolIcon FontSize="16" Foreground="#66C0F4" Symbol="Checkmark16" />
                            </Border>
                            <!-- ...that turns into Unsubscribe's grey x under the pointer. -->
                            <Border x:Name="Cross" Background="#4B4F54" BorderBrush="#7E7E7E" BorderThickness="1" CornerRadius="2" Visibility="Collapsed">
                                <ui:SymbolIcon FontSize="16" Foreground="White" Symbol="Dismiss16" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                <Setter TargetName="Plus" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsInstalled}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Tick" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsInstalled}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Plus" Property="Background" Value="{StaticResource SteamGreenInnerHover}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- An author's name in a row: #8F98A0, Steam's link blue under the pointer. -->
        <Style x:Key="AuthorLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#8F98A0" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#66C0F4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A section's heading on the left: 11px upper case #61696D. -->
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#61696D" />
        </Style>

        <!-- A heading in the right-hand panel: 11px upper case #8F98A0. -->
        <Style x:Key="PanelHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8F98A0" />
        </Style>

        <!-- Steam's friendBlock: 44px on rgba(84,133,183,.2), 4 0 4 4 inside, the name #898989. -->
        <Style x:Key="FriendBlock" TargetType="Button">
            <Setter Property="Foreground" Value="#898989" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Block" Height="44" Padding="4,4,0,4" Background="#335485B7">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Block" Property="Background" Value="#665485B7" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Transparent: the Workshop's grid (or your own picture, Options) behind the window shows
         through, as on Browse and Home. MainWindow hides the page this was opened over meanwhile. -->
    <Border Background="Transparent">
        <ScrollViewer x:Name="Scroll" FocusVisualStyle="{x:Null}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="950" Margin="24,20,24,40">

                <!-- Breadcrumbs: SPT > Workshop > Your collections (or Collections > their Workshop). -->
                <StackPanel Orientation="Horizontal" TextElement.FontSize="12" TextElement.Foreground="{StaticResource SteamTextDim}">
                    <Button Style="{StaticResource Crumb}" ToolTip="{loc:Str Item_CloseToolTip}" Click="Close_Click">
                        <TextBlock Text="{loc:Str Hub_Title}" />
                    </Button>
                    <Path Width="4" Height="7" Margin="6,1,6,0" VerticalAlignment="Center" Data="M0,0 L4,3.5 L0,7" Stretch="Fill" Stroke="{StaticResource SteamTextDim}" StrokeThickness="1" />
                    <Button Style="{StaticResource Crumb}" ToolTip="{loc:Str Item_CloseToolTip}" Click="Close_Click">
                        <TextBlock Text="{loc:Str Nav_Workshop}" />
                    </Button>
                    <Path Width="4" Height="7" Margin="6,1,6,0" VerticalAlignment="Center" Data="M0,0 L4,3.5 L0,7" Stretch="Fill" Stroke="{StaticResource SteamTextDim}" StrokeThickness="1" />
                    <Button Style="{StaticResource Crumb}" Command="{Binding ManageCommand}" Visibility="{Binding IsPublic, Converter={StaticResource FalseToVisible}}">
                        <TextBlock Text="{loc:Str Collection_Breadcrumb}" />
                    </Button>
                    <Button Style="{StaticResource Crumb}" Command="{Binding BrowseCollectionsCommand}" Visibility="{Binding IsPublic, Converter={StaticResource TrueToVisible}}">
                        <TextBlock Text="{loc:Str Collections_Breadcrumb}" />
                    </Button>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasListAuthor, Converter={StaticResource TrueToVisible}}">
                        <Path Width="4" Height="7" Margin="6,1,6,0" VerticalAlignment="Center" Data="M0,0 L4,3.5 L0,7" Stretch="Fill" Stroke="{StaticResource SteamTextDim}" StrokeThickness="1" />
                        <Button Style="{StaticResource Crumb}" Command="{Binding OpenListAuthorCommand}">
                            <TextBlock Text="{Binding ListAuthor, StringFormat={loc:Str Item_AuthorsWorkshopFormat}}" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Description | Comments (a public collection's, on sp-mod.com). -->
                <StackPanel Margin="0,20,0,12" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource SteamSectionTab}" Command="{Binding ShowDescriptionCommand}" IsChecked="{Binding IsDescriptionShown, Mode=OneWay}">
                        <TextBlock Text="{loc:Str Item_TabDescription}" />
                    </ToggleButton>
                    <ToggleButton
                        Style="{StaticResource SteamSectionTab}"
                        Command="{Binding ShowCommentsCommand}"
                        IsChecked="{Binding IsCommentsShown, Mode=OneWay}"
                        Visibility="{Binding HasContentPublic, Converter={StaticResource TrueToVisible}}">
                        <TextBlock Text="{loc:Str Item_TabComments}" />
                    </ToggleButton>
                </StackPanel>

                <!-- The header: the collection's picture, 948x470, with the title bar over its top. On the
                     Comments tab the comments come straight under the tabs instead: a web view cannot
                     scroll with the page, so it gets the height under them. -->
                <Grid Visibility="{Binding IsDescriptionShown, Converter={StaticResource TrueToVisible}}">
                    <Grid Height="470" Margin="0,0,2,0" ClipToBounds="True" Visibility="{Binding HasHeaderArt, Converter={StaticResource TrueToVisible}}">
                        <Grid.CacheMode>
                            <BitmapCache />
                        </Grid.CacheMode>
                        <Image
                            VerticalAlignment="Top"
                            Stretch="UniformToFill"
                            Visibility="{Binding HeaderImage, Converter={StaticResource NullToCollapsed}}"
                            behaviors:ThumbnailLoader.DecodeWidth="948"
                            behaviors:ThumbnailLoader.Source="{Binding HeaderImage}" />
                        <ItemsControl Focusable="False" VerticalAlignment="Top" ItemsSource="{Binding HeaderPictures}" Visibility="{Binding HasHeaderTiles, Converter={StaticResource TrueToVisible}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="158" Background="Black">
                                        <Image Stretch="UniformToFill" behaviors:ThumbnailLoader.DecodeWidth="158" behaviors:ThumbnailLoader.Source="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Border Height="75" VerticalAlignment="Top" Padding="16,18,16,0" Background="#CC1B1B1B">
                        <DockPanel>
                            <!-- Where Steam's stars are: the SPT version a public collection was made for. -->
                            <TextBlock
                                Margin="12,6,4,0"
                                VerticalAlignment="Top"
                                DockPanel.Dock="Right"
                                FontSize="13"
                                Foreground="#8F98A0"
                                Text="{Binding ListSptText}"
                                Visibility="{Binding ListSptText, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock
                                FontFamily="{StaticResource SteamFontLight}"
                                FontWeight="Light"
                                FontSize="30"
                                Foreground="White"
                                TextTrimming="CharacterEllipsis"
                                Text="{Binding Name}" />
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- The control row: rgba(42,60,83,.8), a 1px #233245 top edge, 6 6 6 1 inside. -->
                <Border Padding="6,6,1,6" Background="#CC2A3C53" BorderBrush="#233245" BorderThickness="0,1,0,0" Visibility="{Binding IsDescriptionShown, Converter={StaticResource TrueToVisible}}">
                    <WrapPanel>
                        <Button Margin="0,0,5,0" Style="{StaticResource SteamGeneralButton}" Command="{Binding ManageCommand}" Visibility="{Binding CanManage, Converter={StaticResource TrueToVisible}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Edit16" />
                                <TextBlock Text="{loc:Str Collection_Manage}" />
                            </StackPanel>
                        </Button>
                        <!-- Steam's Favorite, where Steam has it: before Share. Pressed ("Favorited", a filled
                             blue star): HUNCH - Steam shows that state only when signed in. -->
                        <Button Margin="0,0,5,0" Style="{StaticResource SteamGeneralButton}" Command="{Binding ToggleFavoriteCommand}" Visibility="{Binding HasContentPublic, Converter={StaticResource TrueToVisible}}" ToolTip="{loc:Str Collection_FavoriteToolTip}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsFavorite, Converter={StaticResource FalseToVisible}}">
                                    <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Star16" />
                                    <TextBlock Text="{loc:Str Collection_Favorite}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsFavorite, Converter={StaticResource TrueToVisible}}">
                                    <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Filled="True" Foreground="#66C0F4" Symbol="Star16" />
                                    <TextBlock Text="{loc:Str Collection_Favorited}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Margin="0,0,5,0" Style="{StaticResource SteamGeneralButton}" Command="{Binding CopyLinkCommand}" Visibility="{Binding IsPublic, Converter={StaticResource TrueToVisible}}" ToolTip="{loc:Str Collection_ShareToolTip}">
                            <TextBlock Text="{loc:Str Collection_Share}" />
                        </Button>
                        <Button Margin="0" Style="{StaticResource SteamGeneralButton}" Command="{Binding OpenOnSiteCommand}" Visibility="{Binding IsPublic, Converter={StaticResource TrueToVisible}}" ToolTip="{loc:Str Collection_ViewOnSiteToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Open16" />
                                <TextBlock Text="{loc:Str Collection_ViewOnSite}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="13"
                    Foreground="{StaticResource SteamLegacyBlue}"
                    TextWrapping="Wrap"
                    Text="{Binding Message}"
                    Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />

                <!-- A public collection while its page is read, and when it could not be. -->
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="14"
                    Foreground="{StaticResource SteamTextDim}"
                    Text="{loc:Str Collection_Loading}"
                    Visibility="{Binding IsLoading, Converter={StaticResource TrueToVisible}}" />
                <StackPanel Margin="0,20,0,0" Visibility="{Binding HasLoadFailed, Converter={StaticResource TrueToVisible}}">
                    <TextBlock FontSize="14" Foreground="{StaticResource SteamText}" TextWrapping="Wrap" Text="{Binding LoadFailed}" />
                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource SteamButton}" Command="{Binding RetryCommand}">
                        <TextBlock Text="{loc:Str Collection_TryAgain}" />
                    </Button>
                </StackPanel>

                <!-- ============================================================ Comments tab -->
                <StackPanel Margin="0,20,0,0" Visibility="{Binding IsCommentsShown, Converter={StaticResource TrueToVisible}}">
                    <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="{StaticResource SteamTextDim}" Text="{loc:Str Item_CommentsSignIn}" Visibility="{Binding Visibility, ElementName=CommentsHost}" />
                    <Border x:Name="CommentsHost" Background="#1B2838" />
                    <TextBlock x:Name="CommentsOff" Margin="0,20,0,0" HorizontalAlignment="Center" Foreground="{StaticResource SteamText}" Text="{loc:Str Item_CommentsNone}" Visibility="Collapsed" />
                    <StackPanel x:Name="CommentsFallback" Margin="0,20,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock MaxWidth="520" Foreground="{StaticResource SteamText}" TextAlignment="Center" TextWrapping="Wrap" Text="{loc:Str Item_CommentsUnavailable}" />
                        <Button Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource SteamBlueButton}" Content="{loc:Str Item_CommentsOpen}" Click="OpenComments_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- ============================================================ Description tab -->
                <Grid Margin="0,25,0,0" Visibility="{Binding ShowsDescriptionTab, Converter={StaticResource TrueToVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="645*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="295*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <!-- DESCRIPTION: the collection's own words, exactly as its author wrote them - a
                             long one folded to its first lines until asked for. -->
                        <StackPanel Margin="0,0,0,20" Visibility="{Binding HasDescription, Converter={StaticResource TrueToVisible}}">
                            <Rectangle Height="1" Margin="0,7,0,0" Fill="#35465E" />
                            <TextBlock Margin="0,5,0,0" Style="{StaticResource SectionHeading}" Text="{loc:Str Collection_DescriptionHeader}" />
                            <RichTextBox
                                Margin="0,26,0,0"
                                Padding="0"
                                ClipToBounds="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Disabled"
                                IsDocumentEnabled="True"
                                IsReadOnly="True"
                                VerticalScrollBarVisibility="Disabled"
                                Visibility="{Binding DescriptionHtml, Converter={StaticResource NullToCollapsed}}"
                                behaviors:HtmlText.Html="{Binding DescriptionHtml}">
                                <RichTextBox.Resources>
                                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#ACB2B8" />
                                    <Style TargetType="Paragraph">
                                        <Setter Property="LineHeight" Value="20" />
                                    </Style>
                                </RichTextBox.Resources>
                                <RichTextBox.Style>
                                    <Style TargetType="RichTextBox" BasedOn="{StaticResource {x:Type RichTextBox}}">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DescriptionIsLong}" Value="True" />
                                                    <Condition Binding="{Binding IsDescriptionOpen}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="MaxHeight" Value="220" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RichTextBox.Style>
                            </RichTextBox>
                            <TextBlock
                                Margin="0,26,0,0"
                                FontSize="14"
                                Foreground="#ACB2B8"
                                LineHeight="20"
                                TextWrapping="Wrap"
                                Text="{Binding LocalDescription}"
                                Visibility="{Binding LocalDescription, Converter={StaticResource NullToCollapsed}}" />
                            <Button
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SteamLinkButton}"
                                Command="{Binding ToggleDescriptionCommand}"
                                Visibility="{Binding DescriptionIsLong, Converter={StaticResource TrueToVisible}}">
                                <TextBlock FontSize="13" Text="{Binding DescriptionToggleText}" />
                            </Button>
                        </StackPanel>

                        <!-- ITEMS (N), how much of it is here, the bar and the rows. -->
                        <Rectangle Height="1" Margin="0,7,0,0" Fill="#35465E" />
                        <TextBlock Margin="0,5,0,0" FontSize="11">
                            <Run Foreground="#61696D" Text="{Binding ItemsTitle, Mode=OneWay}" />
                            <Run Foreground="#939393" Text="{Binding ItemsCount, Mode=OneWay}" />
                        </TextBlock>

                        <!-- "12 of 96 mods subscribed · 3 can be updated". -->
                        <TextBlock
                            Margin="0,12,0,0"
                            FontSize="14"
                            Foreground="#C6D4DF"
                            TextWrapping="Wrap"
                            Text="{Binding Summary}"
                            Visibility="{Binding Summary, Converter={StaticResource NullToCollapsed}}" />

                        <Border Margin="0,16,0,2" Padding="10" Background="#33000000">
                            <WrapPanel>
                                <Button Style="{StaticResource CollectionBarButton}" Command="{Binding SubscribeToAllCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Add16" />
                                        <TextBlock Text="{loc:Str Collection_SubscribeAll}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource CollectionBarButton}" Command="{Binding UnsubscribeFromAllCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Dismiss16" />
                                        <TextBlock Text="{loc:Str Collection_UnsubscribeAll}" />
                                    </StackPanel>
                                </Button>
                                <!-- Not Steam's (Steam updates by itself): Subscribed items' Update all, over this
                                     collection's items. Only while there is something to update. -->
                                <Button Style="{StaticResource CollectionBarButton}" Command="{Binding UpdateAllCommand}" ToolTip="{loc:Str Collection_UpdateAllToolTip}" Visibility="{Binding HasUpdates, Converter={StaticResource TrueToVisible}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="ArrowSync16" />
                                        <TextBlock Text="{Binding UpdateAllLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource CollectionBarButton}" Command="{Binding SaveToCollectionCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Copy16" />
                                        <TextBlock Text="{loc:Str Collection_SaveToCollection}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Border>

                        <TextBlock
                            Margin="0,16,0,0"
                            FontSize="14"
                            Foreground="{StaticResource SteamText}"
                            Text="{loc:Str Collection_NoItems}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource TrueToVisible}}" />

                        <ItemsControl Focusable="False" ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Margin="0,0,0,2" Background="#335485B7" behaviors:ModContextMenu.Mod="{Binding Mod}">
                                        <DockPanel>
                                            <Button
                                                Margin="12,0,14,0"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource SquareSubscribe}"
                                                ToolTip="{Binding SubscribeToolTip}"
                                                Command="{Binding DataContext.ToggleSubscribeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanSubscribe, Converter={StaticResource TrueToVisible}}" />

                                            <!-- The picture: 100px on black, a 1px frame lit #97C0E3 under the pointer. -->
                                            <Border
                                                x:Name="Frame"
                                                Width="102"
                                                Height="102"
                                                Margin="6"
                                                Background="Black"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="Item_Click">
                                                <Border.CacheMode>
                                                    <BitmapCache />
                                                </Border.CacheMode>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="10" Opacity="1" ShadowDepth="2.8" Direction="315" Color="Black" />
                                                </Border.Effect>
                                                <Image Stretch="UniformToFill" behaviors:ThumbnailLoader.DecodeWidth="100" behaviors:ThumbnailLoader.Source="{Binding Thumbnail}" />
                                            </Border>

                                            <StackPanel Margin="6,13,12,6" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Item_Click">
                                                <TextBlock
                                                    FontFamily="{StaticResource SteamFontLight}"
                                                    FontWeight="Light"
                                                    FontSize="16"
                                                    Foreground="White"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{Binding Name}" />
                                                <TextBlock FontSize="12" Foreground="#969696" Visibility="{Binding Author, Converter={StaticResource NullToCollapsed}}">
                                                    <Run Text="{loc:Str Collection_ItemCreatedBy}" />
                                                    <Hyperlink
                                                        Style="{StaticResource AuthorLink}"
                                                        ToolTip="{loc:Str Item_AuthorToolTip}"
                                                        Command="{Binding DataContext.OpenItemAuthorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                        <Run Text="{Binding Author, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock
                                                    Margin="0,10,0,0"
                                                    FontSize="14"
                                                    Foreground="#969696"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{Binding Teaser}"
                                                    Visibility="{Binding Teaser, Converter={StaticResource NullToCollapsed}}" />
                                                <TextBlock
                                                    Margin="0,10,0,0"
                                                    FontSize="13"
                                                    Foreground="#969696"
                                                    TextWrapping="Wrap"
                                                    Text="{Binding Note}"
                                                    Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                                                <!-- The collection author's own note on this item. -->
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    FontSize="13"
                                                    FontStyle="Italic"
                                                    Foreground="#C6D4DF"
                                                    TextWrapping="Wrap"
                                                    Text="{Binding AuthorNote}"
                                                    Visibility="{Binding AuthorNote, Converter={StaticResource NullToCollapsed}}" />
                                                <!-- Which version it gets on this SPT version, or that there is none. -->
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    FontSize="12"
                                                    TextWrapping="Wrap"
                                                    Text="{Binding VersionText}"
                                                    Visibility="{Binding VersionText, Converter={StaticResource NullToCollapsed}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#8F98A0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding VersionIsWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="#D3AC42" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="#97C0E3" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- The right-hand panel. -->
                    <Border Grid.Column="2" VerticalAlignment="Top" Padding="10,10,10,11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#33000000" />
                                <GradientStop Offset="1" Color="#80000000" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Visibility="{Binding HasAuthors, Converter={StaticResource TrueToVisible}}">
                                <TextBlock Margin="0,5,0,10" Style="{StaticResource PanelHeading}" TextWrapping="Wrap" Text="{Binding CreatedByTitle}" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding Authors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Style="{StaticResource AuthorChip}"
                                                Command="{Binding DataContext.OpenAuthorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{loc:Str Item_AuthorToolTip}">
                                                <TextBlock Text="{Binding}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- COLLECTION ASSEMBLED BY: who made a public collection. -->
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasListAuthor, Converter={StaticResource TrueToVisible}}">
                                <TextBlock Margin="0,5,0,10" Style="{StaticResource PanelHeading}" Text="{loc:Str Collection_AssembledBy}" />
                                <Button Style="{StaticResource FriendBlock}" Command="{Binding OpenListAuthorCommand}" ToolTip="{loc:Str Collection_ListAuthorToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" Margin="0,0,7,0" Padding="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0.05" Color="#6A6A6A" />
                                                    <GradientStop Offset="0.95" Color="#555555" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid Background="#2A2E33">
                                                <ui:SymbolIcon FontSize="20" Foreground="#6B7580" Symbol="Person24" />
                                                <Image Stretch="UniformToFill" behaviors:ThumbnailLoader.DecodeWidth="34" behaviors:ThumbnailLoader.Source="{Binding ListAuthorAvatar}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock VerticalAlignment="Center" FontSize="11" LineHeight="13" Text="{Binding ListAuthor}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- The numbers, figure and label side by side, as Steam's are. -->
                            <Grid Margin="0,18,0,0" TextElement.FontSize="13" TextElement.Foreground="#8F98A0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Margin="0,0,13,4" Text="{Binding ItemsNumber}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Str Collection_ItemsLabel}" />
                                <TextBlock Grid.Row="1" Margin="0,0,13,4" Text="{Binding PostedText}" Visibility="{Binding HasPosted, Converter={StaticResource TrueToVisible}}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Str Collection_Posted}" Visibility="{Binding HasPosted, Converter={StaticResource TrueToVisible}}" />
                                <TextBlock Grid.Row="2" Margin="0,0,13,0" Text="{Binding UpdatedText}" Visibility="{Binding UpdatedText, Converter={StaticResource NullToCollapsed}}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Str Collection_Updated}" Visibility="{Binding UpdatedText, Converter={StaticResource NullToCollapsed}}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
