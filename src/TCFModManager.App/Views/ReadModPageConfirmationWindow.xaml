<Window
    x:Class="TCFModManager.App.Views.ReadModPageConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Width="560"
    Background="#25282E"
    FontFamily="{StaticResource SteamFont}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStyle="None"
    KeyDown="Window_KeyDown">
    <!--
        The read-the-mod-page gate, shown via ShowDialog() from any call site: one row per mod page
        that must be opened before Continue unlocks.

        Drawn as Steam's modal dialog (see SteamDialog.xaml for the measurements): the glow, the
        blue line along the top, a 22px bold title, 16px #ACB2B8 text, and the modal's own buttons -
        green for Continue, grey for Cancel, blue for each page's Open. The page behind is dimmed
        while it is open.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="1.414" RadiusY="1.414">
                    <GradientStop Offset="0" Color="#664A515C" />
                    <GradientStop Offset="0.6" Color="#004B515C" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Rectangle Grid.Row="0" Height="1">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#00CCFF" />
                    <GradientStop Offset="1" Color="#3366FF" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <TextBlock
            x:Name="TitleText"
            Grid.Row="1"
            Margin="24,24,48,0"
            FontSize="22"
            FontWeight="Bold"
            Foreground="White"
            TextWrapping="Wrap"
            Text="{loc:Str ReadModPage_Title}" />

        <Button
            Grid.Row="0"
            Grid.RowSpan="2"
            Width="16"
            Height="16"
            Margin="9"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Cursor="Hand"
            Focusable="False"
            Click="CancelButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Glyph" Background="Transparent" Opacity="0.7">
                        <ui:SymbolIcon FontSize="16" Foreground="White" Symbol="Dismiss16" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <StackPanel Grid.Row="2" Margin="24" TextElement.FontSize="16" TextElement.Foreground="#ACB2B8">
            <TextBlock
                x:Name="IntroText"
                Margin="0,0,0,18"
                LineHeight="21"
                TextWrapping="Wrap"
                Text="{loc:Str ReadModPage_Intro}" />

            <!-- Shown only for a batch too long to open a page at a time. -->
            <StackPanel x:Name="BatchBar" Margin="0,0,0,16" Visibility="Collapsed">
                <TextBlock x:Name="BatchProgress" Margin="0,0,0,10" TextWrapping="Wrap" />

                <WrapPanel>
                    <Button x:Name="OpenBatchButton" Margin="0,0,12,0" Style="{StaticResource SteamModalBlueButton}" Click="OpenBatchButton_Click" />
                    <Button x:Name="SkipOpeningButton" Margin="0" Style="{StaticResource SteamModalGreyButton}" Content="{loc:Str ReadModPage_SkipOpening}" Click="SkipOpeningButton_Click" />
                </WrapPanel>
            </StackPanel>

            <!-- One row per page: the name, and its Open button (Opened once it has been). -->
            <ScrollViewer FocusVisualStyle="{x:Null}" MaxHeight="320" Margin="0,0,0,4" VerticalScrollBarVisibility="Auto">
                <ItemsControl Focusable="False" x:Name="LinksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,2" Padding="10,6" Background="{StaticResource SteamRequiredItem}">
                                <DockPanel>
                                    <Button
                                        Margin="12,0,0,0"
                                        DockPanel.Dock="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SteamModalBlueButton}"
                                        IsEnabled="{Binding HasUrl}"
                                        Click="OpenLinkButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Open16" />
                                            <TextBlock FontSize="14" Text="{Binding ButtonLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="White"
                                        TextWrapping="Wrap"
                                        Text="{Binding Name}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="ContinueButton"
                    Margin="0"
                    Style="{StaticResource SteamModalGreenButton}"
                    IsEnabled="False"
                    Content="{loc:Str Common_Continue}"
                    Click="ContinueButton_Click" />
                <Button
                    Style="{StaticResource SteamModalGreyButton}"
                    Content="{loc:Str Common_Cancel}"
                    Click="CancelButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
