<local:SteamModalWindow
    x:Class="TCFModManager.App.Views.ModListAddModWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TCFModManager.App.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Width="660"
    Height="680"
    MinWidth="520"
    MinHeight="440"
    Title="{loc:Str ModLists_AddMods}"
    ResizeMode="CanResizeWithGrip">
    <!--
        Picks mods to add to a list, from what this install has and from the cached sp-mod.com
        catalog. Nothing here downloads or installs anything - it names mods, and applying the list
        is what acts on them.

        Every TextBlock sets its own Foreground: a plain ListBox hands its content the system
        control foreground, which is black whatever the theme is.
    -->
    <local:SteamModalWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            The container draws nothing itself - the row Border inside the template does. Selection
            is what "picked" means here, and it is driven item-by-item in code rather than by a
            binding on IsSelected: the visible collection is replaced every time the source or the
            search changes, and a container being torn down writes its own IsSelected back on the
            way out, which would silently untick rows nobody touched.

            A row already on the list is disabled, which is also what stops it being selected.
        -->
        <Style x:Key="ChoiceContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsEnabled" Value="{Binding CanChoose}" />

            <!-- Replaced outright, for the reason written up on ModListsPage's BareContainer: the
                 stock template paints its own accent fill for a selected row whatever Background
                 says, which stacks with the row's own selected state. Here the tick and the row
                 tint are the answer to "is this one picked", and one answer is enough. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </local:SteamModalWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <!-- The source showing is blue, the other grey (set in code). -->
                <Button
                    x:Name="InstalledSourceButton"
                    Style="{StaticResource SteamModalBlueButton}"
                    MinWidth="150"
                    Margin="0"
                    HorizontalContentAlignment="Center"
                    Click="InstalledSource_Click" />

                <Button
                    x:Name="CatalogSourceButton"
                    Style="{StaticResource SteamModalGreyButton}"
                    MinWidth="150"
                    HorizontalContentAlignment="Center"
                    Click="CatalogSource_Click" />
            </StackPanel>

            <ui:TextBox
                x:Name="SearchBox"
                Margin="0,12,0,0"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{loc:Str ModListAdd_SearchPlaceholder}"
                TextChanged="SearchBox_TextChanged" />

            <TextBlock
                x:Name="SourceNote"
                TextWrapping="Wrap"
                Margin="2,10,0,0"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <TextBlock
                x:Name="CountNote"
                TextWrapping="Wrap"
                FontSize="12"
                Margin="2,6,0,0"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <!--
            Top, not the default. A ui:Card in a "*" row is laid out centred, so once the search
            narrows this picker to a handful of mods the card detaches from the panel above it and
            hangs in the middle of the window. Alignment only - the card is still measured against
            the cell, so a long result set stays constrained and still scrolls inside its own list.
        -->
        <ui:Card Grid.Row="2" Margin="0" Padding="4" VerticalAlignment="Top">
            <Grid>
                <TextBlock
                    x:Name="EmptyNote"
                    Margin="12"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top"
                    Visibility="Collapsed"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{loc:Str ModListAdd_NoMatches}" />

                <ListBox
                    x:Name="RowsBox"
                    BorderThickness="0"
                    Background="Transparent"
                    SelectionMode="Multiple"
                    ItemContainerStyle="{StaticResource ChoiceContainer}"
                    SelectionChanged="RowsBox_SelectionChanged"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ClickableRow}" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Shows the row's state; the whole row is the hit target,
                                         so the box itself takes no clicks of its own. -->
                                    <CheckBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        Focusable="False"
                                        IsHitTestVisible="False"
                                        IsChecked="{Binding IsChosen, Mode=OneWay}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            TextWrapping="Wrap"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding Name}" />

                                        <TextBlock
                                            TextWrapping="Wrap"
                                            FontSize="12"
                                            Margin="0,3,0,0"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Detail}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="ChosenNote"
                Grid.Column="0"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Margin="2,0,12,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{loc:Str ModListAdd_NothingPicked}" />

            <Button
                Style="{StaticResource SteamModalGreyButton}"
                Grid.Column="1"
                MinWidth="100"
                Margin="0"
                HorizontalContentAlignment="Center"
                Content="{loc:Str Common_Cancel}"
                Click="CancelButton_Click" />

            <Button
                x:Name="AddButton"
                Style="{StaticResource SteamModalGreenButton}"
                Grid.Column="2"
                MinWidth="130"
                HorizontalContentAlignment="Center"
                IsEnabled="False"
                Content="{loc:Str ModListAdd_Add}"
                Click="AddButton_Click" />
        </Grid>
    </Grid>
</local:SteamModalWindow>
