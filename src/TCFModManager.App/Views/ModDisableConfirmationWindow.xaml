<ui:FluentWindow
    x:Class="TCFModManager.App.Views.ModDisableConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Width="520"
    MaxHeight="640"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <!--
        Shown before a disable/enable that affects other mods, following the same plain modal
        FluentWindow pattern as ReadModPageConfirmationWindow - ShowDialog() from any call site,
        result read back through a static Confirm helper.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="WindowTitleBar"
            Grid.Row="0"
            Title="{loc:Str ModDisable_Title}" />

        <StackPanel
            Grid.Row="1"
            Margin="24,12,24,24">
            <TextBlock
                x:Name="SummaryText"
                TextWrapping="Wrap"
                Margin="0,0,0,4" />

            <TextBlock
                x:Name="TargetsText"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,16" />

            <TextBlock
                x:Name="ImpactHeading"
                TextWrapping="Wrap"
                FontWeight="SemiBold"
                Margin="0,0,0,8" />

            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                <ItemsControl Focusable="False" x:Name="ImpactList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Symbol="{Binding Glyph}"
                                    Foreground="{Binding Brush}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="{Binding Detail}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Margin="0,12,0,0"
                Text="{loc:Str ModDisable_Note}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button
                    Margin="0,0,8,0"
                    Content="{loc:Str Common_Cancel}"
                    Click="CancelButton_Click" />

                <ui:Button
                    x:Name="ProceedOnlyButton"
                    Margin="0,0,8,0"
                    Click="ProceedOnlyButton_Click" />

                <ui:Button
                    x:Name="CascadeButton"
                    Appearance="Primary"
                    Click="CascadeButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
