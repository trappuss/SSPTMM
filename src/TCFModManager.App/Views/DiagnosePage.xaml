<!-- Fork (SSPTMM): Diagnose logs - see DiagnoseViewModel. Own ScrollViewer, as DependenciesPage. -->
<Page
    x:Class="TCFModManager.App.Views.DiagnosePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    behaviors:Shortcuts.Refresh="{Binding RefreshCommand}"
    Title="{loc:Str Nav_Diagnose}"
    Loaded="DiagnosePage_Loaded"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
    </Page.Resources>

    <Grid Margin="24,16,24,16" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button
                    Margin="0,0,8,0"
                    Content="{loc:Str Diagnose_CopyReport}"
                    Icon="{ui:SymbolIcon Copy24}"
                    ToolTip="{loc:Str Diagnose_CopyReportToolTip}"
                    Command="{Binding CopyReportCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
                <ui:Button
                    Margin="0,0,8,0"
                    Content="{loc:Str Report_OpenIssue}"
                    Icon="{ui:SymbolIcon Bug24}"
                    ToolTip="{loc:Str Diagnose_ReportIssueToolTip}"
                    Command="{Binding ReportIssueCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
                <ui:Button
                    Content="{loc:Str Diagnose_Refresh}"
                    Icon="{ui:SymbolIcon ArrowSync24}"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
            </StackPanel>
            <TextBlock
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Text="{loc:Str Diagnose_Description}" />
        </DockPanel>

        <!-- Which logs were read, and the status line. -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding StatusMessage}" Margin="0,0,0,4" />
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ServerLine}" Visibility="{Binding ServerLine, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding GameLine}" Visibility="{Binding GameLine, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding GameErrorsLine}" Visibility="{Binding GameErrorsLine, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding LauncherNote}" Visibility="{Binding LauncherNote, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <ScrollViewer
            x:Name="FindingsScrollViewer"
            Grid.Row="2"
            FocusVisualStyle="{x:Null}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Fork (1.4.7): Find the broken mod - see BrokenModFinder. -->
                <ui:Card Margin="0,0,0,12" Padding="16,12" DataContext="{Binding Search}">
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon Margin="0,0,10,0" VerticalAlignment="Center" FontSize="18" Symbol="Search24" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button
                                    Appearance="Primary"
                                    Content="{loc:Str Search_Start}"
                                    Icon="{ui:SymbolIcon Play24}"
                                    Command="{Binding StartCommand}"
                                    Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button
                                    Content="{loc:Str Search_Stop}"
                                    Icon="{ui:SymbolIcon Dismiss24}"
                                    Command="{Binding StopCommand}"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Text="{loc:Str Search_Title}" />
                        </DockPanel>

                        <TextBlock
                            Margin="28,4,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{loc:Str Search_Description}" />

                        <!-- While it runs. -->
                        <StackPanel Margin="28,10,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Progress}" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding ProgressText}" />
                        </StackPanel>

                        <TextBlock
                            Margin="28,8,0,0"
                            TextWrapping="Wrap"
                            Text="{Binding StatusMessage}"
                            Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />

                        <!-- A search that was cut short, with its mods still off. -->
                        <StackPanel Margin="28,8,0,0" Visibility="{Binding IsInterrupted, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Text="{Binding InterruptedText}" />
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Appearance="Primary"
                                Content="{loc:Str Search_TurnBackOn}"
                                Icon="{ui:SymbolIcon ArrowUndo24}"
                                Command="{Binding TurnBackOnCommand}" />
                        </StackPanel>

                        <!-- How the last search ended. -->
                        <Border
                            Margin="28,12,0,0"
                            Padding="14,12"
                            CornerRadius="4"
                            BorderThickness="3,0,0,0"
                            BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Background="{DynamicResource ControlFillColorInputActiveBrush}"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Text="{Binding ResultTitle}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="14"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding ResultBody}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="14"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding ResultNext}"
                                Visibility="{Binding ResultNext, Converter={StaticResource NullToCollapsed}}" />
                            <Border
                                Margin="0,8,0,0"
                                Padding="8,6"
                                CornerRadius="3"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                Visibility="{Binding ResultLines, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding ResultLines}" />
                            </Border>
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding ResultNote}" />
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasResultDone, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    FontSize="14"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    Text="{Binding ResultDone}" />
                                <ui:Button
                                    Margin="0,6,0,0"
                                    Appearance="Primary"
                                    Content="{loc:Str Play_StartServer}"
                                    Icon="{ui:SymbolIcon Play24}"
                                    Command="{Binding StartServerCommand}" />
                            </StackPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <ItemsControl Focusable="False" ItemsSource="{Binding Found}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button
                                                    Margin="0,0,8,4"
                                                    Appearance="Primary"
                                                    Content="{Binding TurnOffText}"
                                                    Icon="{ui:SymbolIcon Power24}"
                                                    Visibility="{Binding CanTurnOff, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.TurnOffModCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}}"
                                                    CommandParameter="{Binding}" />
                                                <ui:Button
                                                    Margin="0,0,8,4"
                                                    Content="{Binding ShowText}"
                                                    Icon="{ui:SymbolIcon Apps24}"
                                                    Command="{Binding DataContext.ShowModCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}}"
                                                    CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button
                                    Appearance="Transparent"
                                    Content="{loc:Str Search_Dismiss}"
                                    Command="{Binding DismissCommand}" />
                            </WrapPanel>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <ItemsControl Focusable="False" ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <StackPanel>
                                    <DockPanel>
                                        <ui:SymbolIcon
                                            x:Name="SeverityIcon"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Symbol="{Binding Glyph}" />
                                        <TextBlock
                                            DockPanel.Dock="Right"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding CountText}"
                                            Visibility="{Binding CountText, Converter={StaticResource NullToCollapsed}}" />
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                                    </DockPanel>

                                    <TextBlock
                                        Margin="28,4,0,0"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Text="{Binding ModText}"
                                        Visibility="{Binding ModText, Converter={StaticResource NullToCollapsed}}" />

                                    <TextBlock
                                        Margin="28,4,0,0"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Body}" />

                                    <!-- The log line it was read from. -->
                                    <Border
                                        Margin="28,8,0,0"
                                        Padding="8,6"
                                        CornerRadius="3"
                                        Background="{DynamicResource ControlFillColorInputActiveBrush}">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding WhereText}" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding SampleText}" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock
                                        Margin="28,8,0,0"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ProfileFixNote}"
                                        Visibility="{Binding ProfileFixNote, Converter={StaticResource NullToCollapsed}}" />

                                    <WrapPanel Margin="28,8,0,0">
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Content="{loc:Str Diagnose_ProfileFix}"
                                            Icon="{ui:SymbolIcon Wrench24}"
                                            Visibility="{Binding CanTurnOnProfileFix, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.TurnOnProfileFixCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" />
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Appearance="Primary"
                                            Content="{loc:Str Search_Title}"
                                            Icon="{ui:SymbolIcon Search24}"
                                            Visibility="{Binding CanSearch, Converter={StaticResource BoolToVisibility}}"
                                            Click="FindBroken_Click" />
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Content="{loc:Str Diagnose_ShowMod}"
                                            Icon="{ui:SymbolIcon Apps24}"
                                            Visibility="{Binding HasMod, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.ShowModCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                            CommandParameter="{Binding}" />
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Content="{loc:Str Diagnose_OpenFolder}"
                                            Icon="{ui:SymbolIcon Folder24}"
                                            Visibility="{Binding HasMod, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.OpenModFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                            CommandParameter="{Binding}" />
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Content="{loc:Str Diagnose_GoToPlay}"
                                            Icon="{ui:SymbolIcon Play24}"
                                            Visibility="{Binding IsAboutPort, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.GoToPlayCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" />
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Content="{loc:Str Diagnose_ProfileBackups}"
                                            Icon="{ui:SymbolIcon History24}"
                                            Visibility="{Binding IsAboutProfile, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.OpenProfileBackupsCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" />
                                        <ui:Button
                                            Appearance="Transparent"
                                            Content="{loc:Str Diagnose_OpenLog}"
                                            Icon="{ui:SymbolIcon DocumentText24}"
                                            Command="{Binding DataContext.OpenLogCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                            CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </StackPanel>
                            </ui:Card>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Finding.Severity}" Value="Critical">
                                    <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Finding.Severity}" Value="Warning">
                                    <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Finding.Severity}" Value="Info">
                                    <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding OtherErrorsText}"
                    Visibility="{Binding OtherErrorsText, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
