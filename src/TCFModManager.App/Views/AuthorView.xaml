<!--
    An author's Workshop page (steamcommunity.com/id/<name>/myworkshopfiles), for an sp-mod.com
    member.

    Measured on Steam, 2026-09-26: the page #1B2838. The header rgba(58,62,71,.5), 14px above and
    below: the avatar 68x68 in its frame, the name about 25px white, then " » Workshop Items » <the
    game>" 18px #8F98A0. The section tabs as on an item page (14px, 3px #1A9FFF under the chosen
    one). Over the items a bar rgba(0,0,0,.2) 28px high, 2 10 2 6 inside: "Showing 1-9 of 77 entries"
    12px #61686D on the left, the page buttons 39x24 rgba(255,255,255,.125) radius 3 on the right.
    Items 201px apart: a 200x200 picture with a 2px 2px 10px black shadow, the stars, the title 14px
    bold white cut with an ellipsis, the game 12px #8F98A0. Collections as rows 648x120 on
    rgb(39,59,82), 10 inside, a 3px rgba(20,20,20,.75) shadow: a 100px picture, the title 17px light
    white, "Collection by X" 14px #8F98A0, the description 14px #8F98A0 10px under. The right column
    295px on rgba(0,0,0,.2), 16 10 inside: the follower count 42px light #67C1F5 with "Followers"
    18px light #8F98A0 beside it (20px over, 8px down), a 13px line on what following does, then
    Follow. "Per page: 9 18 30" under the items. An Addons tab, when they have addons, is this app's:
    Steam has no addons.

    What sp-mod.com has no equivalent for is left out: Steam's stars stand for a rating, and here -
    as on every Browse card - the place shows what sp-mod.com counts (endorsements, favourites,
    downloads). Their cover picture, from sp-mod.com, stands behind the header.
-->
<UserControl
    x:Class="TCFModManager.App.Views.AuthorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Focusable="True"
    FocusVisualStyle="{x:Null}"
    KeyDown="View_KeyDown">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:UpdateAvailableToVisibilityConverter x:Key="TrueToVisible" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <converters:EqualityConverter x:Key="IsSameValue" />
        <converters:PageSizeLabelConverter x:Key="PageSizeLabel" />

        <Style x:Key="Crumb" TargetType="Button" BasedOn="{StaticResource SteamLinkButton}">
            <Setter Property="Foreground" Value="{StaticResource SteamTextDim}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Steam's pagebtn: 39x24, rgba(255,255,255,.125), radius 3; dimmed with nowhere to go. -->
        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width" Value="39" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#66C0F4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A page number between them: 12px, the current one white and not a link. -->
        <Style x:Key="PageNumber" TargetType="Button">
            <Setter Property="Foreground" Value="#8F98A0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#66C0F4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- "9 18 30" after Per page: links, the one in use white. -->
        <Style x:Key="PageSizeLink" TargetType="Button" BasedOn="{StaticResource PageNumber}" />

        <!-- Steam's hover popup on an item square, measured on the live page (2026-09-26): #363C45,
             300px, no radius, border or shadow, 14 10 inside; the title 14px white 10px above the
             description 12px #B0AEAC; its top 1px above the square's, 3px to the right of it. The
             description here is sp-mod.com's teaser. The popup's DataContext is the square's. -->
        <Style x:Key="ItemHover" TargetType="ToolTip">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="MaxWidth" Value="Infinity" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Width="300" Padding="10,14" Background="#363C45" TextBlock.TextAlignment="Left">
                            <StackPanel>
                                <TextBlock FontSize="14" Foreground="White" TextWrapping="Wrap" Text="{Binding Name}" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="12"
                                    Foreground="#B0AEAC"
                                    TextWrapping="Wrap"
                                    Text="{Binding Teaser}"
                                    Visibility="{Binding Teaser, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Transparent: the Workshop's grid (or your own picture, Options) behind the window shows
         through, as on the other Workshop pages. MainWindow hides the page this was opened over. -->
    <Border Background="Transparent">
        <ScrollViewer x:Name="Scroll" FocusVisualStyle="{x:Null}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" ScrollChanged="Scroll_ScrollChanged">
            <StackPanel MaxWidth="950" Margin="24,20,24,40">

                <!-- Breadcrumbs: SPT > Workshop > <author>'s Workshop. -->
                <StackPanel Orientation="Horizontal" TextElement.FontSize="12" TextElement.Foreground="{StaticResource SteamTextDim}">
                    <Button Style="{StaticResource Crumb}" ToolTip="{loc:Str Item_CloseToolTip}" Click="Close_Click">
                        <TextBlock Text="{loc:Str Hub_Title}" />
                    </Button>
                    <Path Width="4" Height="7" Margin="6,1,6,0" VerticalAlignment="Center" Data="M0,0 L4,3.5 L0,7" Stretch="Fill" Stroke="{StaticResource SteamTextDim}" StrokeThickness="1" />
                    <Button Style="{StaticResource Crumb}" ToolTip="{loc:Str Item_CloseToolTip}" Click="Close_Click">
                        <TextBlock Text="{loc:Str Nav_Workshop}" />
                    </Button>
                    <Path Width="4" Height="7" Margin="6,1,6,0" VerticalAlignment="Center" Data="M0,0 L4,3.5 L0,7" Stretch="Fill" Stroke="{StaticResource SteamTextDim}" StrokeThickness="1" />
                    <TextBlock Text="{Binding Name, StringFormat={loc:Str Item_AuthorsWorkshopFormat}}" />
                </StackPanel>

                <!-- The header: their picture and name, over their sp-mod.com cover when they have one. -->
                <Grid Margin="0,14,0,0" ClipToBounds="True">
                    <!-- As tall as the bar over it, whatever the picture's own height. -->
                    <Image
                        Height="{Binding ActualHeight, ElementName=HeaderBar}"
                        Stretch="UniformToFill"
                        VerticalAlignment="Center"
                        Visibility="{Binding Cover, Converter={StaticResource NullToCollapsed}}"
                        behaviors:ThumbnailLoader.DecodeWidth="950"
                        behaviors:ThumbnailLoader.Source="{Binding Cover}" />
                    <!-- Their picture darkened, so the name over it reads on a light one too. -->
                    <Rectangle Fill="#73000000" Visibility="{Binding Cover, Converter={StaticResource NullToCollapsed}}" />
                    <Border x:Name="HeaderBar" Padding="14,14,14,14" Background="#803A3E47">
                        <DockPanel>
                            <!-- The avatar in Steam's frame: a 1px gradient edge. -->
                            <Border Width="72" Height="72" Padding="2" DockPanel.Dock="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0.05" Color="#6A6A6A" />
                                        <GradientStop Offset="0.95" Color="#555555" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Background="#2A2E33">
                                    <ui:SymbolIcon FontSize="36" Foreground="#6B7580" Symbol="Person24" />
                                    <Image Stretch="UniformToFill" behaviors:ThumbnailLoader.DecodeWidth="68" behaviors:ThumbnailLoader.Source="{Binding Avatar}" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontSize="25" Foreground="White" Text="{Binding Name, Mode=OneWay}" />
                                    <Run FontSize="18" FontFamily="{StaticResource SteamFontLight}" Foreground="#8F98A0" Text="»" />
                                    <Run FontSize="18" FontFamily="{StaticResource SteamFontLight}" Foreground="#8F98A0" Text="{loc:Str Author_WorkshopItems}" />
                                    <Run FontSize="18" FontFamily="{StaticResource SteamFontLight}" Foreground="#8F98A0" Text="»" />
                                    <Run FontSize="18" FontFamily="{StaticResource SteamFontLight}" Foreground="#8F98A0" Text="{loc:Str Hub_Title}" />
                                </TextBlock>
                                <!-- sp-mod.com's Staff badge. -->
                                <Border
                                    Margin="0,6,0,0"
                                    Padding="6,2"
                                    HorizontalAlignment="Left"
                                    Background="#5C1A9FFF"
                                    CornerRadius="2"
                                    Visibility="{Binding IsStaff, Converter={StaticResource TrueToVisible}}">
                                    <TextBlock FontSize="11" Foreground="White" Text="{loc:Str Author_Staff}" />
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Workshop Items | Collections. -->
                <StackPanel Margin="0,20,0,12" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource SteamSectionTab}" Command="{Binding ShowItemsCommand}" IsChecked="{Binding IsItemsTab, Mode=OneWay}">
                        <TextBlock Text="{loc:Str Author_WorkshopItems}" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource SteamSectionTab}" Command="{Binding ShowAddonsCommand}" IsChecked="{Binding IsAddonsTab, Mode=OneWay}" Visibility="{Binding HasAddons, Converter={StaticResource TrueToVisible}}">
                        <TextBlock Text="{loc:Str Author_TabAddons}" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource SteamSectionTab}" Command="{Binding ShowCollectionsCommand}" IsChecked="{Binding IsCollectionsTab, Mode=OneWay}" Visibility="{Binding HasId, Converter={StaticResource TrueToVisible}}">
                        <TextBlock Text="{loc:Str Author_TabCollections}" />
                    </ToggleButton>
                </StackPanel>

                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="13"
                    Foreground="{StaticResource SteamLegacyBlue}"
                    TextWrapping="Wrap"
                    Text="{Binding Message}"
                    Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="645*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="295*" />
                    </Grid.ColumnDefinitions>

                    <!-- ======================================================== Workshop Items -->
                    <StackPanel Grid.Column="0" Visibility="{Binding IsItemsTab, Converter={StaticResource TrueToVisible}}">
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            Foreground="{StaticResource SteamText}"
                            TextWrapping="Wrap"
                            Text="{Binding NoItemsText}"
                            Visibility="{Binding HasNoItems, Converter={StaticResource TrueToVisible}}" />

                        <StackPanel Visibility="{Binding HasItems, Converter={StaticResource TrueToVisible}}">
                            <!-- The paging bar. -->
                            <Border Height="28" Padding="6,2,10,2" Background="#33000000">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasPages, Converter={StaticResource TrueToVisible}}">
                                        <Button Style="{StaticResource PageButton}" Command="{Binding PreviousPageCommand}" ToolTip="{loc:Str Common_Previous}">
                                            <Path Width="6" Height="10" Data="M5,0 L0,5 L5,10" Stretch="Fill" Stroke="White" StrokeThickness="1.5" />
                                        </Button>
                                        <ItemsControl Focusable="False" Margin="6,0" VerticalAlignment="Center" ItemsSource="{Binding PageLinks}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Style="{StaticResource PageNumber}"
                                                        Command="{Binding DataContext.GoToPageNumberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Number}">
                                                        <TextBlock Text="{Binding Text}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource PageButton}" Command="{Binding NextPageCommand}" ToolTip="{loc:Str Common_Next}">
                                            <Path Width="6" Height="10" Data="M0,0 L5,5 L0,10" Stretch="Fill" Stroke="White" StrokeThickness="1.5" />
                                        </Button>
                                    </StackPanel>
                                    <!-- Fork: Per page up here too while the list is infinite, as the one under
                                         the items is only reached once every item has been added. -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsInfinite, Converter={StaticResource TrueToVisible}}">
                                        <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12" Foreground="#61686D" Text="{loc:Str Workshop_PerPage}" />
                                        <ItemsControl Focusable="False" VerticalAlignment="Center" ItemsSource="{Binding PageSizes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        x:Name="Size"
                                                        Style="{StaticResource PageSizeLink}"
                                                        Command="{Binding DataContext.SetPageSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding Converter={StaticResource PageSizeLabel}}" />
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource IsSameValue}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.PageSize" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="Size" Property="Foreground" Value="White" />
                                                            <Setter TargetName="Size" Property="IsHitTestVisible" Value="False" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#61686D" Text="{Binding ShowingText}" />
                                </DockPanel>
                            </Border>

                            <!-- The items, 201px apart. -->
                            <ItemsControl Margin="0,14,0,0" Focusable="False" ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="211" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            x:Name="Tile"
                                            Width="201"
                                            Margin="0,0,0,18"
                                            HorizontalAlignment="Left"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            behaviors:ModContextMenu.Mod="{Binding Mod}"
                                            ToolTipService.InitialShowDelay="150"
                                            ToolTipService.ShowDuration="60000"
                                            ToolTipService.Placement="Right"
                                            ToolTipService.HorizontalOffset="3"
                                            ToolTipService.VerticalOffset="-1"
                                            MouseLeftButtonUp="Item_Click">
                                            <StackPanel.ToolTip>
                                                <ToolTip Style="{StaticResource ItemHover}" />
                                            </StackPanel.ToolTip>
                                            <Border x:Name="Frame" Width="200" Height="200" HorizontalAlignment="Left" Background="Black" BorderBrush="Transparent" BorderThickness="1">
                                                <Border.CacheMode>
                                                    <BitmapCache />
                                                </Border.CacheMode>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="10" Direction="315" Opacity="1" ShadowDepth="2.8" Color="Black" />
                                                </Border.Effect>
                                                <Grid>
                                                    <Image Stretch="UniformToFill" behaviors:ThumbnailLoader.DecodeWidth="200" behaviors:ThumbnailLoader.Source="{Binding Thumbnail}" />
                                                    <!-- Subscribed: Steam's own mark on an item you have. -->
                                                    <Border
                                                        Margin="6"
                                                        Padding="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Background="#CC000000"
                                                        CornerRadius="2"
                                                        ToolTip="{loc:Str Author_SubscribedToolTip}"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource TrueToVisible}}">
                                                        <ui:SymbolIcon FontSize="14" Foreground="#66C0F4" Symbol="Checkmark16" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Where Steam's stars sit: what sp-mod.com counts. -->
                                            <StackPanel Height="16" Margin="0,8,0,0" Orientation="Horizontal">
                                                <StackPanel Margin="0,0,10,0" Orientation="Horizontal" Visibility="{Binding Endorsements, Converter={StaticResource NullToCollapsed}}">
                                                    <ui:SymbolIcon FontSize="14" Filled="True" Foreground="{StaticResource SteamBlue}" Symbol="ThumbLike16" />
                                                    <TextBlock Margin="3,0,0,0" FontSize="12" Foreground="{StaticResource SteamBlue}" Text="{Binding Endorsements, StringFormat=N0}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,0" Orientation="Horizontal" Visibility="{Binding Favourites, Converter={StaticResource NullToCollapsed}}">
                                                    <ui:SymbolIcon FontSize="14" Filled="True" Foreground="{StaticResource SteamBlue}" Symbol="Star16" />
                                                    <TextBlock Margin="3,0,0,0" FontSize="12" Foreground="{StaticResource SteamBlue}" Text="{Binding Favourites, StringFormat=N0}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon FontSize="14" Foreground="{StaticResource SteamBlue}" Symbol="ArrowDownload16" />
                                                    <TextBlock Margin="3,0,0,0" FontSize="12" Foreground="{StaticResource SteamBlue}" Text="{Binding Downloads, StringFormat=N0}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock
                                                x:Name="Title"
                                                Width="200"
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                TextTrimming="CharacterEllipsis"
                                                Text="{Binding Name}" />
                                            <TextBlock FontSize="12" Foreground="#8F98A0" Text="{loc:Str Hub_Title}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="#66C0F4" />
                                                <Setter TargetName="Title" Property="Foreground" Value="#66C0F4" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Under the items: the bar again, and Per page. -->
                            <Border Height="28" Padding="6,2,10,2" Background="#33000000">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12" Foreground="#61686D" Text="{loc:Str Workshop_PerPage}" />
                                        <ItemsControl Focusable="False" VerticalAlignment="Center" ItemsSource="{Binding PageSizes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        x:Name="Size"
                                                        Style="{StaticResource PageSizeLink}"
                                                        Command="{Binding DataContext.SetPageSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding Converter={StaticResource PageSizeLabel}}" />
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource IsSameValue}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.PageSize" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="Size" Property="Foreground" Value="White" />
                                                            <Setter TargetName="Size" Property="IsHitTestVisible" Value="False" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#61686D" Text="{Binding ShowingText}" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ================================================================ Addons -->
                    <!-- Squares like the items', the mod each is for under its name; a click opens that
                         mod's page, which lists its addons with Install. -->
                    <ItemsControl Grid.Column="0" Focusable="False" ItemsSource="{Binding Addons}" Visibility="{Binding IsAddonsTab, Converter={StaticResource TrueToVisible}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="211" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel
                                    x:Name="Tile"
                                    Width="201"
                                    Margin="0,0,0,18"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    ToolTipService.InitialShowDelay="150"
                                    ToolTipService.ShowDuration="60000"
                                    ToolTipService.Placement="Right"
                                    ToolTipService.HorizontalOffset="3"
                                    ToolTipService.VerticalOffset="-1"
                                    MouseLeftButtonUp="Addon_Click">
                                    <StackPanel.ToolTip>
                                        <ToolTip Style="{StaticResource ItemHover}" />
                                    </StackPanel.ToolTip>
                                    <Border x:Name="Frame" Width="200" Height="200" HorizontalAlignment="Left" Background="Black" BorderBrush="Transparent" BorderThickness="1">
                                        <Border.CacheMode>
                                            <BitmapCache />
                                        </Border.CacheMode>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" Direction="315" Opacity="1" ShadowDepth="2.8" Color="Black" />
                                        </Border.Effect>
                                        <Image Stretch="UniformToFill" behaviors:ThumbnailLoader.DecodeWidth="200" behaviors:ThumbnailLoader.Source="{Binding Thumbnail}" />
                                    </Border>
                                    <StackPanel Height="16" Margin="0,8,0,0" Orientation="Horizontal">
                                        <ui:SymbolIcon FontSize="14" Foreground="{StaticResource SteamBlue}" Symbol="ArrowDownload16" />
                                        <TextBlock Margin="3,0,0,0" FontSize="12" Foreground="{StaticResource SteamBlue}" Text="{Binding Downloads, StringFormat=N0}" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="Title"
                                        Width="200"
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Width="200"
                                        HorizontalAlignment="Left"
                                        FontSize="12"
                                        Foreground="#8F98A0"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding ForText}"
                                        Visibility="{Binding ForText, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="#66C0F4" />
                                        <Setter TargetName="Title" Property="Foreground" Value="#66C0F4" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ============================================================ Collections -->
                    <StackPanel Grid.Column="0" Visibility="{Binding IsCollectionsTab, Converter={StaticResource TrueToVisible}}">
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            Foreground="{StaticResource SteamTextDim}"
                            Text="{loc:Str Author_Reading}"
                            Visibility="{Binding IsLoadingProfile, Converter={StaticResource TrueToVisible}}" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            Foreground="{StaticResource SteamText}"
                            Text="{loc:Str Author_NoCollections}"
                            Visibility="{Binding ShowsNoCollections, Converter={StaticResource TrueToVisible}}" />

                        <ItemsControl Focusable="False" ItemsSource="{Binding Collections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="Row"
                                        Height="120"
                                        Margin="0,0,0,10"
                                        Padding="10"
                                        Background="#273B52"
                                        Cursor="Hand"
                                        behaviors:CollectionHover.Enabled="True"
                                        MouseLeftButtonUp="Collection_Click">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="3" Direction="0" Opacity="0.75" ShadowDepth="0" Color="#141414" />
                                        </Border.Effect>
                                        <DockPanel>
                                            <Border Width="100" Height="100" Margin="0,0,12,0" DockPanel.Dock="Left" Background="#070707">
                                                <Grid>
                                                    <ui:SymbolIcon FontSize="32" Foreground="#3D4450" Symbol="TextBulletListLtr24" />
                                                    <Image Stretch="UniformToFill" behaviors:ThumbnailLoader.DecodeWidth="100" behaviors:ThumbnailLoader.Source="{Binding Cover}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock
                                                    x:Name="Title"
                                                    FontFamily="{StaticResource SteamFontLight}"
                                                    FontWeight="Light"
                                                    FontSize="17"
                                                    Foreground="White"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{Binding Title}" />
                                                <TextBlock
                                                    FontSize="14"
                                                    Foreground="#8F98A0"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{Binding Summary.Author, StringFormat={loc:Str Author_CollectionByFormat}}"
                                                    Visibility="{Binding Summary.Author, Converter={StaticResource NullToCollapsed}}" />
                                                <TextBlock
                                                    Padding="0,10,0,0"
                                                    MaxHeight="50"
                                                    FontSize="14"
                                                    Foreground="#8F98A0"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap"
                                                    Text="{Binding Teaser}"
                                                    Visibility="{Binding Teaser, Converter={StaticResource NullToCollapsed}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Title" Property="Foreground" Value="#66C0F4" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ============================================================ right column -->
                    <Border Grid.Column="2" VerticalAlignment="Top" Padding="10,16,10,16" Background="#33000000">
                        <StackPanel>
                            <!-- Steam's followStatsBlock: 6px in, the count 42px light #67C1F5 and beside it,
                                 20px over and 8px down, "Followers" 18px light #8F98A0. -->
                            <StackPanel Margin="6,0,0,0" Orientation="Horizontal" Visibility="{Binding HasFollowers, Converter={StaticResource TrueToVisible}}">
                                <TextBlock
                                    FontFamily="{StaticResource SteamFontLight}"
                                    FontWeight="Light"
                                    FontSize="42"
                                    Foreground="#67C1F5"
                                    Text="{Binding Followers, StringFormat=N0}" />
                                <TextBlock
                                    Margin="20,8,0,0"
                                    VerticalAlignment="Top"
                                    FontFamily="{StaticResource SteamFontLight}"
                                    FontWeight="Light"
                                    FontSize="18"
                                    Foreground="#8F98A0"
                                    Text="{loc:Str Author_Followers}" />
                            </StackPanel>

                            <!-- Under it on Steam, 13px: what following does. Here it is what following
                                 does in this app - Steam's sentence names Guides and Collections. -->
                            <TextBlock
                                Margin="6,10,0,0"
                                FontSize="13"
                                Foreground="#8F98A0"
                                TextWrapping="Wrap"
                                Text="{loc:Str Author_FollowNote}"
                                Visibility="{Binding HasId, Converter={StaticResource TrueToVisible}}" />

                            <Button
                                Margin="6,12,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SteamFollowButton}"
                                ToolTip="{Binding FollowToolTip}"
                                Command="{Binding ToggleFollowCommand}"
                                Visibility="{Binding HasId, Converter={StaticResource TrueToVisible}}" />

                            <TextBlock
                                Margin="0,14,0,0"
                                FontSize="13"
                                Foreground="#8F98A0"
                                Text="{Binding MemberSinceText}"
                                Visibility="{Binding MemberSinceText, Converter={StaticResource NullToCollapsed}}" />

                            <!-- Their page could not be read: why, and Try again. -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasProfileFailed, Converter={StaticResource TrueToVisible}}">
                                <TextBlock FontSize="13" Foreground="{StaticResource SteamText}" TextWrapping="Wrap" Text="{Binding ProfileFailed}" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource SteamButton}" Command="{Binding RetryCommand}">
                                    <TextBlock Text="{loc:Str Collection_TryAgain}" />
                                </Button>
                            </StackPanel>

                            <!-- No sp-mod.com id for this name: their items only. -->
                            <TextBlock
                                Margin="0,14,0,0"
                                FontSize="13"
                                Foreground="#8F98A0"
                                TextWrapping="Wrap"
                                Text="{loc:Str Author_NoPage}"
                                Visibility="{Binding HasId, Converter={StaticResource FalseToVisible}}" />

                            <Rectangle Height="1" Margin="0,16,0,10" Fill="#35465E" />

                            <Button HorizontalAlignment="Left" Style="{StaticResource SteamLinkButton}" Command="{Binding SearchInBrowseCommand}" ToolTip="{loc:Str Author_SearchInBrowseToolTip}">
                                <TextBlock FontSize="13" Text="{loc:Str Author_SearchInBrowse}" />
                            </Button>
                            <Button
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SteamLinkButton}"
                                Command="{Binding OpenOnSiteCommand}"
                                ToolTip="{loc:Str Author_ViewOnSiteToolTip}"
                                Visibility="{Binding HasId, Converter={StaticResource TrueToVisible}}">
                                <TextBlock FontSize="13" Text="{loc:Str Collection_ViewOnSite}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
