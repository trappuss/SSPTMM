<!--
    Steam Workshop look: brushes and keyed styles for the pages rebuilt after steamcommunity.com.

    Every value here was read off the live site on 2026-09-24 (computed styles and pixel samples of
    the Workshop browse page, the Workshop home page and a Workshop item page) - see
    docs/steam-workshop-ui.md for the measurements and the handful of values that could not be
    measured and are marked as such there.

    Nothing in this file is an implicit style. WPF-UI declares its real control styles in a theme
    dictionary merged at runtime, and an implicit Style for one of its controls replaces that style
    outright (see the notes in AppTheme.cs), so everything below is opted into by key. The Button
    templates are complete templates on the plain WPF Button, which has no WPF-UI style to lose.

    Colours used in more than one place are brushes with an x:Key; one-off colours stay inline next
    to the element they belong to, which is how the rest of this app's XAML is written.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization">

    <!--  ============================================================ Fonts  -->
    <!--
        Steam's own face is Motiva Sans, which Valve licenses and does not allow anyone else to use
        (the licence text sits at the top of steamcommunity.com's motiva_sans.css). Noto Sans is the
        next family in Steam's own font stack, and it is SIL OFL, so it ships here with its licence
        (Themes/Fonts/OFL.txt). Light and Medium carry both a family name of their own and "Noto Sans"; see the
        note on SteamFontLight below.
    -->
    <!--  Segoe UI after it, so a character Noto Sans does not have (an emoji in a mod description,
          CJK in a mod name) falls back to what Windows always has rather than to nothing.  -->
    <FontFamily x:Key="SteamFont">pack://application:,,,/Themes/Fonts/#Noto Sans, Segoe UI</FontFamily>
    <!--  Light and Medium name their own family first and fall back to "Noto Sans": font engines
          disagree on whether those two files are families of their own (their legacy names) or
          weights of Noto Sans (their typographic names). Every use also asks for the weight, so
          whichever grouping wins, the right face is picked.  -->
    <FontFamily x:Key="SteamFontLight">pack://application:,,,/Themes/Fonts/#Noto Sans Light, pack://application:,,,/Themes/Fonts/#Noto Sans, Segoe UI</FontFamily>
    <FontFamily x:Key="SteamFontMedium">pack://application:,,,/Themes/Fonts/#Noto Sans Medium, pack://application:,,,/Themes/Fonts/#Noto Sans, Segoe UI</FontFamily>

    <!-- WPF UI's own control styles (text boxes, rich text, combo boxes) take their face from this
         key rather than inheriting it, so without it they stayed in Segoe UI beside Noto Sans text. -->
    <!-- Code in descriptions: Windows 11's code face, then the older ones. -->
    <FontFamily x:Key="SteamMonospace">Cascadia Mono, Consolas, Courier New</FontFamily>

    <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Themes/Fonts/#Noto Sans, Segoe UI</FontFamily>

    <!--  Steam rounds its buttons, fields and dropdowns by 2px and its popups barely at all. Both
          keys are read by WPF-UI's templates through DynamicResource, so this reaches every control.  -->
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="PopupCornerRadius">2</CornerRadius>

    <!--  ============================================================ Brushes  -->
    <SolidColorBrush x:Key="SteamBlue" Color="#1A9FFF" />
    <SolidColorBrush x:Key="SteamBlueHover" Color="#56ABFF" />
    <SolidColorBrush x:Key="SteamLegacyBlue" Color="#66C0F4" />
    <SolidColorBrush x:Key="SteamGray" Color="#3D4450" />
    <SolidColorBrush x:Key="SteamGrayHover" Color="#67707B" />
    <SolidColorBrush x:Key="SteamGlobalHeader" Color="#171D25" />
    <SolidColorBrush x:Key="SteamWorkshopBackground" Color="#262B34" />
    <SolidColorBrush x:Key="SteamLegacyBackground" Color="#1B2838" />
    <SolidColorBrush x:Key="SteamWhite" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SteamText" Color="#ACB2B8" />
    <SolidColorBrush x:Key="SteamTextBright" Color="#F1F2F3" />
    <SolidColorBrush x:Key="SteamTextDim" Color="#8F98A0" />
    <SolidColorBrush x:Key="SteamTextMinor" Color="#61686D" />
    <SolidColorBrush x:Key="SteamHubTabText" Color="#C0C5CB" />
    <SolidColorBrush x:Key="SteamSubNavStrip" Color="#5E000000" />
    <SolidColorBrush x:Key="SteamBanner" Color="#3D000000" />
    <SolidColorBrush x:Key="SteamSortBox" Color="#5E000000" />
    <SolidColorBrush x:Key="SteamAuthorText" Color="#A2FFFFFF" />
    <SolidColorBrush x:Key="SteamPreviewBackground" Color="#070707" />
    <SolidColorBrush x:Key="SteamPopupBackground" Color="#344352" />
    <SolidColorBrush x:Key="SteamChipFill" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="SteamLabelBlue" Color="#5C8699" />
    <SolidColorBrush x:Key="SteamValueText" Color="#EBEBEB" />
    <SolidColorBrush x:Key="SteamStatNumber" Color="#6088BB" />
    <SolidColorBrush x:Key="SteamStatLabel" Color="#939393" />
    <SolidColorBrush x:Key="SteamDescriptionHeader" Color="#61696D" />
    <SolidColorBrush x:Key="SteamRequiredItem" Color="#335485B7" />
    <SolidColorBrush x:Key="SteamSubscribeBox" Color="#5C151515" />
    <SolidColorBrush x:Key="SteamSubscribeBoxBorder" Color="#35465E" />
    <SolidColorBrush x:Key="SteamCommentsBar" Color="#223349" />
    <SolidColorBrush x:Key="SteamTagInclude" Color="#5DB7C7" />
    <SolidColorBrush x:Key="SteamTagExclude" Color="#D3AC42" />
    <SolidColorBrush x:Key="SteamTagRest" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="SteamTagHover" Color="#3B3D40" />
    <SolidColorBrush x:Key="SteamDivider" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="SteamOutlineHover" Color="#331A9FFF" />

    <!--  The Workshop browse page: #262B34 under a 2px grid every 80px and a 1px grid every 16px,
          both white at 6%. Drawn as one 80x80 tile.  -->
    <DrawingBrush
        x:Key="SteamWorkshopGrid"
        TileMode="Tile"
        Viewport="0,0,80,80"
        ViewportUnits="Absolute"
        Viewbox="0,0,80,80"
        ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#262B34">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,80,80" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0FFFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,80,2" />
                            <RectangleGeometry Rect="0,2,2,78" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0FFFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="16,2,1,78" />
                            <RectangleGeometry Rect="32,2,1,78" />
                            <RectangleGeometry Rect="48,2,1,78" />
                            <RectangleGeometry Rect="64,2,1,78" />
                            <RectangleGeometry Rect="2,16,14,1" />
                            <RectangleGeometry Rect="17,16,15,1" />
                            <RectangleGeometry Rect="33,16,15,1" />
                            <RectangleGeometry Rect="49,16,15,1" />
                            <RectangleGeometry Rect="65,16,15,1" />
                            <RectangleGeometry Rect="2,32,14,1" />
                            <RectangleGeometry Rect="17,32,15,1" />
                            <RectangleGeometry Rect="33,32,15,1" />
                            <RectangleGeometry Rect="49,32,15,1" />
                            <RectangleGeometry Rect="65,32,15,1" />
                            <RectangleGeometry Rect="2,48,14,1" />
                            <RectangleGeometry Rect="17,48,15,1" />
                            <RectangleGeometry Rect="33,48,15,1" />
                            <RectangleGeometry Rect="49,48,15,1" />
                            <RectangleGeometry Rect="65,48,15,1" />
                            <RectangleGeometry Rect="2,64,14,1" />
                            <RectangleGeometry Rect="17,64,15,1" />
                            <RectangleGeometry Rect="33,64,15,1" />
                            <RectangleGeometry Rect="49,64,15,1" />
                            <RectangleGeometry Rect="65,64,15,1" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!--  The hub art glow. Steam's comes from the game's own community-hub image; this app has
          no such image, so the colour it leaves behind (#27405B at the centre, measured) is drawn
          as a soft radial instead.  -->
    <RadialGradientBrush x:Key="SteamHubGlow" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.55" RadiusY="1.4">
        <GradientStop Offset="0" Color="#9927405B" />
        <GradientStop Offset="1" Color="#0027405B" />
    </RadialGradientBrush>

    <!--  Browse card: radial-gradient(62% 99% at 17% 35%, #3C4149, #1B1D21).  -->
    <RadialGradientBrush x:Key="SteamCardBackground" Center="0.17,0.35" GradientOrigin="0.17,0.35" RadiusX="0.62" RadiusY="0.99">
        <GradientStop Offset="0" Color="#3C4149" />
        <GradientStop Offset="1" Color="#1B1D21" />
    </RadialGradientBrush>

    <!--  Filter sidebar: radial-gradient(85.9% 84.18% at 34.28% 100%, rgba(41,50,61,.443) 27.5%, rgba(28,30,36,.396) 67.94%).  -->
    <RadialGradientBrush x:Key="SteamSidebarBackground" Center="0.3428,1" GradientOrigin="0.3428,1" RadiusX="0.859" RadiusY="0.8418">
        <GradientStop Offset="0.275" Color="#7129323D" />
        <GradientStop Offset="0.6794" Color="#651C1E24" />
    </RadialGradientBrush>

    <!--  Item page header: linear-gradient(rgba(64,128,183,.4) 5%, rgba(64,128,183,.2) 95%).  -->
    <LinearGradientBrush x:Key="SteamItemHeaderBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.05" Color="#664080B7" />
        <GradientStop Offset="0.95" Color="#334080B7" />
    </LinearGradientBrush>

    <!--  Item page right-hand panels: linear-gradient(to right, rgba(0,0,0,.2), rgba(0,0,0,.5)).  -->
    <LinearGradientBrush x:Key="SteamRightPanelBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#33000000" />
        <GradientStop Offset="1" Color="#80000000" />
    </LinearGradientBrush>

    <!--  btn_green_white_innerfade, from Steam's buttons.css.  -->
    <LinearGradientBrush x:Key="SteamGreenOuter" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.05" Color="#A4D007" />
        <GradientStop Offset="0.95" Color="#536904" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SteamGreenInner" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.05" Color="#799905" />
        <GradientStop Offset="0.95" Color="#536904" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SteamGreenOuterHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.05" Color="#B6D908" />
        <GradientStop Offset="0.95" Color="#80A006" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SteamGreenInnerHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.05" Color="#A1BF07" />
        <GradientStop Offset="0.95" Color="#80A006" />
    </LinearGradientBrush>

    <!--  ============================================================ Buttons  -->
    <!--
        Flat Steam button. Background, hover background and foreground come from the style that
        uses this template; Tag carries the hover background so one template serves every colour.
    -->
    <ControlTemplate x:Key="SteamFlatButtonTemplate" TargetType="Button">
        <Border
            x:Name="Chrome"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="2"
            SnapsToDevicePixels="True">
            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#2A2F38" />
                <Setter Property="Foreground" Value="{StaticResource SteamTextMinor}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  Gray (#3D4450 -> #67707B): "Filter by Date", the search gear, dropdown faces.  -->
    <Style x:Key="SteamButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource SteamFlatButtonTemplate}" />
        <Setter Property="Background" Value="{StaticResource SteamGray}" />
        <Setter Property="Tag" Value="{StaticResource SteamGrayHover}" />
        <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!--  Blue (#1A9FFF -> #56ABFF): "Store Page", the pager arrows.  -->
    <Style x:Key="SteamBlueButton" TargetType="Button" BasedOn="{StaticResource SteamButton}">
        <Setter Property="Background" Value="{StaticResource SteamBlue}" />
        <Setter Property="Tag" Value="{StaticResource SteamBlueHover}" />
    </Style>

    <!--  Outlined blue: "View All" on the Workshop home rows. Hover fill is not measured (HUNCH).  -->
    <Style x:Key="SteamOutlineButton" TargetType="Button" BasedOn="{StaticResource SteamButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Tag" Value="{StaticResource SteamOutlineHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource SteamBlue}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource SteamBlue}" />
    </Style>

    <!--  general_btn on the item page: rgba(0,0,0,.4), #939393, hover text #AAAAAA, radius 3, h30.  -->
    <Style x:Key="SteamGeneralButton" TargetType="Button">
        <Setter Property="Foreground" Value="#939393" />
        <Setter Property="Background" Value="#66000000" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#AAAAAA" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#555555" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The Subscribe button - btn_green_white_innerfade. Two nested gradients (a 1px outer frame
        and the inner face), #D2E885 text, white text and brighter gradients on hover.
    -->
    <Style x:Key="SteamGreenButton" TargetType="Button">
        <Setter Property="Foreground" Value="#D2E885" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outer" Padding="1" Background="{StaticResource SteamGreenOuter}" CornerRadius="2" SnapsToDevicePixels="True">
                        <Border x:Name="Inner" Padding="{TemplateBinding Padding}" Background="{StaticResource SteamGreenInner}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="{StaticResource SteamGreenOuterHover}" />
                            <Setter TargetName="Inner" Property="Background" Value="{StaticResource SteamGreenInnerHover}" />
                            <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Outer" Property="Background" Value="#3A4A10" />
                            <Setter TargetName="Inner" Property="Background" Value="#3A4A10" />
                            <Setter Property="Foreground" Value="#7E8C55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Steam's modal dialog buttons (newmodal) - see SteamDialog.xaml for the measurements.
    -->
    <!-- The modal's three button faces. One template: the face brush and its hover come from the
         style, the text colour turns white on hover as Steam's do. -->
    <ControlTemplate x:Key="SteamModalButtonTemplate" TargetType="Button">
        <Border
            x:Name="Face"
            MinHeight="32"
            Padding="15,0"
            Background="{TemplateBinding Background}"
            CornerRadius="2"
            SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <!-- btn_disabled: the face at 45%, no hand. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Steam's :focus-visible ring - 2px white, inside the edge. A FocusVisualStyle, which WPF
         shows for keyboard focus only, as focus-visible does; a click leaves no ring. -->
    <Style x:Key="SteamModalFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="White" BorderThickness="2" CornerRadius="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SteamModalButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource SteamModalButtonTemplate}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SteamModalFocusRing}" />
    </Style>

    <!-- Green: #75B022 -> #588A1B left to right, #D2EFA9 text; hover #8ED629 -> #6AA621 top to bottom. -->
    <Style x:Key="SteamModalGreenButton" TargetType="Button" BasedOn="{StaticResource SteamModalButton}">
        <Setter Property="Foreground" Value="#D2EFA9" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.05" Color="#75B022" />
                    <GradientStop Offset="0.95" Color="#588A1B" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Tag">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.05" Color="#8ED629" />
                    <GradientStop Offset="0.95" Color="#6AA621" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Blue: Steam draws #47BFFF -> #1A44C2 at 330% width and shows a slice of it, the slice
         moving on hover. These are the colours of those two slices, worked out from the
         gradient: #3DA3F1 -> #245FD0 at rest, #47BFFF -> #3286E3 on hover. #C3E1F8 text. -->
    <Style x:Key="SteamModalBlueButton" TargetType="Button" BasedOn="{StaticResource SteamModalButton}">
        <Setter Property="Foreground" Value="#C3E1F8" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#3DA3F1" />
                    <GradientStop Offset="1" Color="#245FD0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Tag">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.165" Color="#47BFFF" />
                    <GradientStop Offset="1" Color="#3286E3" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Grey: #32363F, #DFE3E6 text; hover #464D58. -->
    <Style x:Key="SteamModalGreyButton" TargetType="Button" BasedOn="{StaticResource SteamModalButton}">
        <Setter Property="Foreground" Value="#DFE3E6" />
        <Setter Property="Background" Value="#32363F" />
        <Setter Property="Tag" Value="#464D58" />
    </Style>

    <!--
        A required item listed in a Steam modal (the "Additional Required Items" dialog): the
        item page's requiredItem row - rgba(84,133,183,.2), lighter under the pointer.
    -->
    <Style x:Key="SteamModalRow" TargetType="Button">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="{StaticResource SteamRequiredItem}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#555485B7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A filter chip on Browse's count line: 24px, rgba(0,0,0,.3), radius 2, 12px white; #67707B
        under the pointer. Padding 1 12 for a text chip; a tag chip's box sits 2px in from the left.
    -->
    <Style x:Key="SteamFilterChip" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
        <Setter Property="Background" Value="#4D000000" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="2">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="#67707B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  A bare text link: Steam blue, lighter on hover.  -->
    <Style x:Key="SteamLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SteamLegacyBlue}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================ Navigation  -->
    <!--
        App hub tabs ("All  Discussions  ...  Workshop  ..."): 15px/500, #C0C5CB at rest, white on
        hover and when current, and a 3px #1A9FFF bar under the current one.
    -->
    <Style x:Key="SteamHubTab" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource SteamHubTabText}" />
        <Setter Property="FontFamily" Value="{StaticResource SteamFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,0,20,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Margin="0,0,0,4" />
                        <Border x:Name="Bar" Grid.Row="1" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource SteamBlue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The Options gear at the right of the hub header, beside "sp-mod.com": the same grey face as
        Steam's grey buttons (#3D4450, #67707B under the pointer) at the blue button's 36px height,
        square. Blue (#1A9FFF) while Options is the page on screen. HUNCH: Steam has no gear in this
        spot - its settings live in the client's own menu - so the size and the lit state are this
        app's choice, matched to the button beside it.
    -->
    <Style x:Key="SteamHubGear" TargetType="ToggleButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
        <Setter Property="Background" Value="{StaticResource SteamGray}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="2">
                        <ui:SymbolIcon FontSize="18" Foreground="{TemplateBinding Foreground}" Symbol="Settings24" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SteamGrayHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SteamBlue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Workshop sub-navigation ("Home  Browse ▾  Your Items ▾  Discussions  About"): 15px white,
        0 10px padding, 47px strip, a 2px white bar under the current one.
    -->
    <Style x:Key="SteamSubNavItem" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="#DCDEDF" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource SteamWhite}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The item page's own tabs (Description / Change Notes): 14px/500 white, 3px blue bar.  -->
    <Style x:Key="SteamSectionTab" TargetType="ToggleButton" BasedOn="{StaticResource SteamHubTab}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
        <Setter Property="Margin" Value="0,0,18,0" />
    </Style>


    <!--  The small filled triangle after "Browse" and "Your Items" in the sub-navigation.  -->
    <Style x:Key="SteamDropTriangle" TargetType="Path">
        <Setter Property="Data" Value="M0,0 L12,0 L6,8 Z" />
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="12,1,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        The sort order panel. Measured on Browse: radial-gradient(85.9% 84.18% at 34.28% 100%,
        #29323D 27.5%, #1C1E24 67.94%), shadow 1px 1px 10px #000, padding 20. (Steam also blurs
        what is behind it, which a WPF popup cannot.)
    -->
    <Style x:Key="SteamMenuPanel" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <RadialGradientBrush Center="0.3428,1" GradientOrigin="0.3428,1" RadiusX="0.859" RadiusY="0.8418">
                    <GradientStop Offset="0.275" Color="#29323D" />
                    <GradientStop Offset="0.6794" Color="#1C1E24" />
                </RadialGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" Direction="315" Opacity="1" ShadowDepth="1.4" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The Your Items menu under the Workshop strip. Measured: radial-gradient(85.9% 84.18% at
        34.28% 100%, rgba(63,83,109,.88) 27.5%, rgba(25,35,48,.92) 67.94%), shadow 0 0 10px
        rgba(0,0,0,.75), padding 20; its header 14px light, upper case, white at 66%; its entries
        13px white, 8px apart, underlined under the pointer rather than recoloured.
    -->
    <Style x:Key="SteamYourItemsPanel" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <RadialGradientBrush Center="0.3428,1" GradientOrigin="0.3428,1" RadiusX="0.859" RadiusY="0.8418">
                    <GradientStop Offset="0.275" Color="#E03F536D" />
                    <GradientStop Offset="0.6794" Color="#EB192330" />
                </RadialGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" Opacity="0.75" ShadowDepth="0" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SteamYourItemsHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SteamFontLight}" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#A9FFFFFF" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SteamYourItemsEntry" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <TextBlock x:Name="Label" LineHeight="19.5" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  "SORT ORDER", "YOUR ITEMS" over a dropdown panel's list.  -->
    <Style x:Key="SteamMenuHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!--  One entry in a dropdown panel: 13px #ACB2B8, white on hover.  -->
    <Style x:Key="SteamMenuItem" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SteamText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The search field: #1C2025 inside an 8px #3D4450 frame, 13px italic #ACB2B8 hint. The hint text rides in Tag.  -->
    <Style x:Key="SteamSearchField" TargetType="TextBox">
        <Setter Property="Foreground" Value="#DFE3E6" />
        <Setter Property="CaretBrush" Value="#DFE3E6" />
        <Setter Property="SelectionBrush" Value="{StaticResource SteamBlue}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="#1C2025" Padding="10,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="Hint"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontStyle="Italic"
                                Foreground="{StaticResource SteamText}"
                                IsHitTestVisible="False"
                                TextTrimming="CharacterEllipsis"
                                Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />

                            <!-- Steam's "Clear search": a 10px white x in a 26px hit area, while
                                 there is text to clear. -->
                            <Button
                                x:Name="ClearButton"
                                Grid.Column="1"
                                Width="26"
                                Cursor="Hand"
                                Focusable="False"
                                Command="{x:Static behaviors:TextBoxCommands.Clear}"
                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                ToolTip="{loc:Str Workshop_ClearSearch}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Path
                                                Width="10"
                                                Height="10"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M0,0 L10,10 M10,0 L0,10"
                                                Stretch="Fill"
                                                Stroke="White"
                                                StrokeThickness="1.5" />
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================ Filter sidebar  -->
    <!--  "SPECIAL FILTERS:", "CONTENT TYPE" - 13px, upper case, white.  -->
    <Style x:Key="SteamSidebarHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <!--
        The [+] and [-] boxes in front of each tag: 20x20, white 20% at rest, #3B3D40 under the
        pointer, #5DB7C7 (include) or #D3AC42 (exclude) with a black symbol when on. A box whose
        direction this app cannot filter on is drawn disabled rather than left out, so every row
        keeps Steam's two-box shape.
    -->
    <Style x:Key="SteamTagBoxBase" TargetType="CheckBox">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource SteamTagRest}" />
        <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
    </Style>

    <Style x:Key="SteamTagIncludeBox" TargetType="CheckBox" BasedOn="{StaticResource SteamTagBoxBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="2">
                        <Path
                            x:Name="Symbol"
                            Width="8"
                            Height="8"
                            Data="M3.5,0 L4.5,0 L4.5,3.5 L8,3.5 L8,4.5 L4.5,4.5 L4.5,8 L3.5,8 L3.5,4.5 L0,4.5 L0,3.5 L3.5,3.5 Z"
                            Fill="{TemplateBinding Foreground}"
                            Stretch="Fill" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SteamTagHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SteamTagInclude}" />
                            <Setter TargetName="Symbol" Property="Fill" Value="Black" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="#12FFFFFF" />
                            <Setter TargetName="Symbol" Property="Fill" Value="#3AFFFFFF" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SteamTagExcludeBox" TargetType="CheckBox" BasedOn="{StaticResource SteamTagBoxBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="2">
                        <Rectangle x:Name="Symbol" Width="8" Height="1" Fill="{TemplateBinding Foreground}" SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SteamTagHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SteamTagExclude}" />
                            <Setter TargetName="Symbol" Property="Fill" Value="Black" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="#12FFFFFF" />
                            <Setter TargetName="Symbol" Property="Fill" Value="#3AFFFFFF" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The tag's own label: 13px #ACB2B8, white while the row is under the pointer.  -->
    <Style x:Key="SteamTagLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource SteamText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Panel}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  ============================================================ Sort panel radio  -->
    <!--  The sort popup's radio rows: #3D4450 dot at rest, #1A9FFF when chosen, 13px label.  -->
    <Style x:Key="SteamRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SteamText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Ellipse x:Name="Dot" Width="11" Height="11" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{StaticResource SteamGray}" />
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SteamWhite}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SteamBlue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================ Card hover buttons  -->
    <!--  Steam's Quick View magnifier on a card under the pointer: 30x30, rgba(255,255,255,.1),
          radius 3, a 24px glass; rgba(255,255,255,.2) under the pointer. Collapsed until the card's
          hover trigger shows it.  -->
    <Style x:Key="SteamQuickViewButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!--  A binding, not {loc:Str}: in a Setter that would be the text of the moment, and the
              tip would keep its language after a switch.  -->
        <Setter Property="ToolTip">
            <Setter.Value>
                <Binding Mode="OneWay" Path="[Menu_QuickView]" Source="{x:Static loc:LocalizationService.Instance}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="#1AFFFFFF" CornerRadius="3">
                        <ui:SymbolIcon FontSize="20" Foreground="White" Symbol="Search20" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Not Steam's: subscribe straight from a card, beside the magnifier, for a mod that is not
          installed yet. Collapsed until the card's hover trigger shows it.  -->
    <Style x:Key="SteamQuickSubscribeButton" TargetType="Button" BasedOn="{StaticResource SteamButton}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Visibility" Value="Collapsed" />
        <!--  A template, not the icon as Content: one icon cannot sit in every card's button at
              once. The Content is only there for the template to be used.  -->
        <Setter Property="Content" Value="+" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ui:SymbolIcon FontSize="16" Foreground="{StaticResource SteamWhite}" Symbol="Add16" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================ Pieces  -->
    <!--  Tag chip in the hover popup: rgba(255,255,255,.09), white 12px, 4 8 padding.  -->
    <Style x:Key="SteamChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SteamChipFill}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,4,4" />
    </Style>

    <!--  Item page right-hand panel.  -->
    <Style x:Key="SteamRightPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SteamRightPanelBackground}" />
        <Setter Property="Padding" Value="11,10,10,10" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!--  "REQUIRED ITEMS", "CREATED BY": 11px upper case #8F98A0.  -->
    <Style x:Key="SteamRightPanelTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SteamTextDim}" />
        <Setter Property="Margin" Value="0,5,0,2" />
    </Style>

    <!--  "DESCRIPTION" over the item's description: 11px upper case #61696D, rule above.  -->
    <Style x:Key="SteamDescriptionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource SteamDescriptionHeader}" />
        <Setter Property="Margin" Value="0,3,0,16" />
    </Style>

    <!--  ============================================================ Popup menu  -->
    <!--
        Steam's popup menu (popup_block_new / popup_menu), measured from shared_global.css
        (2026-09-25): the body #3D4450 with a 1px border of the same and a 0 0 12px black shadow, no
        padding; each item 12px #DCDEDF, 5px 12px padding, no wrapping, and under the pointer (or
        keyboard focus) #171D25 on #DCDEDF; a rule 1px #82807C, 10px above and 12px in from the sides.
        Steam's own menus have no icons or check marks, and neither do these.
    -->
    <Style x:Key="SteamPopupMenu" TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource SteamFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#DCDEDF" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- Room around the body for the 12px shadow. -->
                    <Border Padding="12" Background="Transparent">
                        <Border MinWidth="150" Background="#3D4450" BorderBrush="#3D4450" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Opacity="1" ShadowDepth="0" Color="Black" />
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SteamPopupMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="#DCDEDF" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Face" Padding="12,5" Background="Transparent">
                        <ContentPresenter
                            ContentSource="Header"
                            RecognizesAccessKey="False"
                            TextBlock.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="MaxWidth" Value="320" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#DCDEDF" />
                            <Setter Property="Foreground" Value="#171D25" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#7A7E83" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SteamPopupMenuSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="12,10,12,0" Background="#82807C" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================ Search options panel  -->
    <!--
        The panel under Browse's gear, measured (2026-09-25): 500 wide, 20px padding,
        radial-gradient(85.9% 84.18% at 34.28% 100%, #29323D 27.5%, #1C1E24 67.94%), a 1px 1px 10px
        black shadow. The prompt 15px #ACB2B8 on 20px lines; each option a 12px #3D4450 circle -
        #1A9FFF once chosen - and 13px #ACB2B8 text 8px over, rows 25px apart.
    -->
    <RadialGradientBrush x:Key="SteamOptionsPanelBackground" Center="0.3428,1" GradientOrigin="0.3428,1" RadiusX="0.859" RadiusY="0.8418">
        <GradientStop Offset="0.275" Color="#29323D" />
        <GradientStop Offset="0.6794" Color="#1C1E24" />
    </RadialGradientBrush>

    <Style x:Key="SteamOptionRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#ACB2B8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Ellipse x:Name="Dot" Width="12" Height="12" Margin="0,2,8,0" VerticalAlignment="Top" Fill="#3D4450" />
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="#1A9FFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================ Follow  -->
    <!--
        Steam's Follow on an author's Workshop: btn_darkblue_white_innerfade (measured from
        buttons.css) - a 1px #2F89BC-to-#17435C frame round a #21658A-to-#17435C face, #A4D7F5
        text; under the pointer #66C0F4-to-#2F89BC and white. Once following it is btn_active: a
        white frame, a #989B9E-to-#AEB1B5 face, #323B49 text. Here at btn_small's size (12px text on
        20px lines, 15px either side). The words - "+ Follow", "Following", and "Unfollow" under the
        pointer while following - are Steam's as remembered, not measured (HUNCH): its page only
        draws the button for someone signed in.
        The DataContext is the author (IsFollowing).
    -->
    <LinearGradientBrush x:Key="SteamDarkBlueOuter" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.05" Color="#2F89BC" />
        <GradientStop Offset="0.95" Color="#17435C" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SteamDarkBlueInner" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.05" Color="#21658A" />
        <GradientStop Offset="0.95" Color="#17435C" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SteamDarkBlueHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.05" Color="#66C0F4" />
        <GradientStop Offset="0.95" Color="#2F89BC" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SteamActiveInner" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.05" Color="#989B9E" />
        <GradientStop Offset="0.95" Color="#AEB1B5" />
    </LinearGradientBrush>

    <Style x:Key="SteamFollowButton" TargetType="Button">
        <Setter Property="Foreground" Value="#A4D7F5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outer" Padding="1" Background="{StaticResource SteamDarkBlueOuter}" CornerRadius="2">
                        <Border x:Name="Inner" Height="20" Padding="15,0" Background="{StaticResource SteamDarkBlueInner}" CornerRadius="2">
                            <Grid VerticalAlignment="Center">
                                <TextBlock x:Name="Add" Text="{loc:Str Workshop_Follow}" />
                                <TextBlock x:Name="Following" Text="{loc:Str Workshop_Following}" Visibility="Collapsed" />
                                <TextBlock x:Name="Remove" Text="{loc:Str Workshop_Unfollow}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="{StaticResource SteamDarkBlueHover}" />
                            <Setter TargetName="Inner" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsFollowing}" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="White" />
                            <Setter TargetName="Inner" Property="Background" Value="{StaticResource SteamActiveInner}" />
                            <Setter Property="Foreground" Value="#323B49" />
                            <Setter TargetName="Add" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Following" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFollowing}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Following" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Fork (SSPTMM 1.3.0): Steam's modal dialog as a window style, for the dialogs with more in
        them than SteamDialog's text and buttons - SteamModalWindow puts it on. The same measurements
        as SteamDialog.xaml: #25282E with the glow from the top left, the #00CCFF -> #3366FF line
        along the top, the 22px bold white title (the window's Title), the close X, and 14px #ACB2B8
        text in the body. The buttons inside use SteamModalGreenButton / Blue / Grey.
    -->
    <Style x:Key="SteamModalWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="#25282E" />
        <!-- The window's own text colour, so nothing inside inherits Windows' black. -->
        <Setter Property="Foreground" Value="#ACB2B8" />
        <Setter Property="FontFamily" Value="{StaticResource SteamFont}" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.RowSpan="3" IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="1.414" RadiusY="1.414">
                                        <GradientStop Offset="0" Color="#664A515C" />
                                        <GradientStop Offset="0.6" Color="#004B515C" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>

                            <Rectangle Grid.Row="0" Height="1">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00CCFF" />
                                        <GradientStop Offset="1" Color="#3366FF" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- The title doubles as the handle the dialog is dragged by. -->
                            <TextBlock
                                x:Name="PART_Title"
                                Grid.Row="1"
                                Margin="24,24,48,0"
                                Background="Transparent"
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{TemplateBinding Title}"
                                TextWrapping="Wrap" />

                            <Button
                                x:Name="PART_Close"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Width="16"
                                Height="16"
                                Margin="9"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid x:Name="Glyph" Background="Transparent" Opacity="0.7">
                                            <ui:SymbolIcon FontSize="16" Foreground="White" Symbol="Dismiss16" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <AdornerDecorator Grid.Row="2">
                                <ContentPresenter
                                    Margin="24,16,24,24"
                                    TextElement.FontSize="14"
                                    TextElement.Foreground="#ACB2B8" />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
