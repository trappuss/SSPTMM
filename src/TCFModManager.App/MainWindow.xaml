<ui:FluentWindow
    x:Class="TCFModManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:views="clr-namespace:TCFModManager.App.Views"
    xmlns:app="clr-namespace:TCFModManager.App"
    Title="{Binding WindowTitle, Source={x:Static app:AppServices.SptEnvironment}}"
    Icon="pack://application:,,,/Assets/AppIcon.ico"
    Height="980"
    Width="1720"
    MinHeight="480"
    MinWidth="720"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <!-- Small UI text, drawn on whole pixels. WPF's default TextFormattingMode is Ideal, which
         positions glyphs at fractional pixel offsets - correct for print-like scaling and slightly
         soft for 11-14px chrome on a scaled display. Display snaps them to the pixel grid, and
         ClearType asks for subpixel antialiasing rather than the greyscale fallback.

         Set on every window because these are inherited properties and a separate window is a
         separate tree - MainWindow cannot hand them to a dialog.

         The other half of this was element Opacity: any value below 1 renders the subtree into an
         intermediate surface and DISABLES ClearType outright, which is what made de-emphasised
         lines read as blurry on a light background. Every one of those is now a Secondary or
         Tertiary brush instead - see the theme notes, where that was already the rule. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- The whole window sits on the Workshop browse page's background - #262B34 under Steam's two
         faint grids - so every page reads as part of one Steam site. The item page draws the
         legacy blue over it, as Steam's own item pages do. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- Steam's downloads bar along the bottom of the window. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The grid background as a layer of its own, drawn once into a bitmap and reused: every
             frame of a scroll repaints what is behind the page, and a tiled drawing redrawn over the
             whole window each frame was a large part of what made scrolling stutter. -->
        <Border Grid.RowSpan="6" Background="{StaticResource SteamWorkshopGrid}" IsHitTestVisible="False">
            <Border.CacheMode>
                <BitmapCache />
            </Border.CacheMode>
        </Border>

        <!-- A picture of the user's own in place of the grid (Options > Tabs and background),
             darkened by the amount chosen there so the text over it stays readable. -->
        <Grid
            Grid.RowSpan="6"
            DataContext="{x:Static app:AppServices.Appearance}"
            IsHitTestVisible="False"
            Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVis}}">
            <Grid.CacheMode>
                <BitmapCache />
            </Grid.CacheMode>
            <Rectangle Fill="#1B2838" />
            <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Rectangle Fill="Black" Opacity="{Binding BackgroundDarkness}" />
        </Grid>

        <!-- Both titles come from SptEnvironmentViewModel.WindowTitle. The version half is read
             from the assembly (see AppVersion) rather than typed here: they used to be two
             hardcoded strings, which had already drifted a release behind what dist\ was shipping,
             and a stale version number is exactly what would make a self-updater either never fire
             or offer an update the user already has. The rest names the SPT install this window is
             pointed at, so two windows open on two installs can be told apart without opening the
             Options page in each. -->
        <!-- ShowHelp is WPF-UI's own caption "?" beside minimise (Help R2), rather than a button of
             ours in TrailingContent: it sits in the caption button row the window's hit-testing
             already knows about, so it clicks like the other three instead of dragging the window. -->
        <ui:TitleBar
            x:Name="RootTitleBar"
            Grid.Row="0"
            Background="{StaticResource SteamGlobalHeader}"
            ShowHelp="True"
            HelpClicked="RootTitleBar_HelpClicked"
            Title="{Binding WindowTitle, Source={x:Static app:AppServices.SptEnvironment}}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/AppIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Both banners live in the same row, stacked, so raising one never overlaps the other. -->
        <StackPanel Grid.Row="1">

            <!-- Warning banner shown when no SPT install path is set, with a way to the setup steps
                 beside it (Help R9) - beside rather than inside, as the update banner below does.
                 The button follows the bar's own IsOpen, so closing the bar takes it too. -->
            <Grid Margin="12,8,12,0" DataContext="{x:Static app:AppServices.SptEnvironment}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:InfoBar
                    x:Name="NoInstallBar"
                    Grid.Column="0"
                    IsClosable="True"
                    Severity="Warning"
                    Title="{loc:Str MainWindow_NoInstallTitle}"
                    Message="{loc:Str MainWindow_NoInstallMessage}"
                    IsOpen="{Binding IsInstallPathMissing}" />
                <ui:Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Content="{loc:Str MainWindow_HowToSetUp}"
                    Icon="{ui:SymbolIcon BookQuestionMark24}"
                    ToolTip="{loc:Str MainWindow_HowToSetUpToolTip}"
                    Visibility="{Binding IsOpen, ElementName=NoInstallBar, Converter={StaticResource BoolToVis}}"
                    Click="HowToSetUp_Click" />
            </Grid>

            <!-- New version of this app published on sp-mod.com. The action button sits beside the
                 InfoBar rather than inside it: InfoBar's own template button is the close button. -->
            <Grid
                Margin="12,8,12,0"
                DataContext="{x:Static app:AppServices.AppUpdate}"
                Visibility="{Binding IsBannerOpen, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:InfoBar
                    Grid.Column="0"
                    IsClosable="True"
                    Severity="{Binding BannerSeverity}"
                    Title="{Binding BannerTitle}"
                    Message="{Binding ChangeSummary}"
                    IsOpen="{Binding IsBannerOpen, Mode=TwoWay}" />

                <ui:Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Appearance="Primary"
                    Content="{loc:Str MainWindow_SeeWhatsNew}"
                    Icon="{ui:SymbolIcon ArrowCircleUp24}"
                    Click="AppUpdateBanner_Click" />
            </Grid>
        </StackPanel>

        <!--
            The app hub header, where Steam shows a game's name, its "Store Page" button and the
            All / Discussions / ... / Workshop tabs. Measured: 22px #F1F2F3 title, a #1A9FFF button
            36px high, 15px/500 tabs at #C0C5CB with a 3px #1A9FFF bar under the current one.

            The tabs are the app's pages. Workshop stands for all of Home, Browse, Subscribed items
            and Collections - those are reached from the Workshop's own strip under it, as on Steam.
            Which tab is lit follows AppNavigation, so it is right however the page was changed.
        -->
        <Grid Grid.Row="2" Background="{StaticResource SteamHubGlow}">
            <Grid Margin="24,24,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <!-- Options, as Steam's own settings are: a gear at the right, not a tab. Lit
                         while Options is on screen (SyncHeader). -->
                    <ToggleButton
                        x:Name="OptionsGear"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SteamHubGear}"
                        Tag="{x:Type views:OptionsPage}"
                        ToolTip="{loc:Str Nav_Options}"
                        Click="HubTab_Click" />
                    <Button
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource SteamBlueButton}"
                        ToolTip="{loc:Str Hub_ModSiteToolTip}"
                        Click="ModSite_Click">
                        <TextBlock Text="{loc:Str Hub_ModSite}" />
                    </Button>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="22"
                        Foreground="{StaticResource SteamTextBright}"
                        Text="{loc:Str Hub_Title}" />
                </DockPanel>

                <StackPanel x:Name="HubTabs" Grid.Row="1" Margin="0,18,0,0" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource SteamHubTab}" Tag="{x:Type views:PlayPage}" Click="HubTab_Click">
                        <TextBlock Text="{loc:Str Nav_Play}" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource SteamHubTab}" Tag="{x:Type views:WorkshopHomePage}" Click="HubTab_Click">
                        <TextBlock Text="{loc:Str Nav_Workshop}" />
                    </ToggleButton>
                    <!-- Straight to your mods and your collections, without going through Workshop >
                         Your Items. Either can be switched off in Options. -->
                    <ToggleButton
                        Style="{StaticResource SteamHubTab}"
                        Tag="{x:Type views:InstalledPage}"
                        Click="HubTab_Click"
                        DataContext="{x:Static app:AppServices.Appearance}"
                        Visibility="{Binding ShowSubscribedItemsTab, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Str Workshop_SubscribedItems}" />
                    </ToggleButton>
                    <ToggleButton
                        Style="{StaticResource SteamHubTab}"
                        Tag="{x:Type views:YourCollectionsPage}"
                        Click="HubTab_Click"
                        DataContext="{x:Static app:AppServices.Appearance}"
                        Visibility="{Binding ShowCollectionsTab, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Str Nav_ModLists}" />
                    </ToggleButton>
                    <!--
                        Tools and Help: a tab each with a menu under it, opened by the pointer as
                        the Workshop strip's Browse and Your Items are (see HubMenu_MouseEnter). A
                        click on the tab opens it too. The tab is lit while any page in its menu is
                        on screen.
                    -->
                    <ToggleButton
                        x:Name="ToolsTab"
                        Style="{StaticResource SteamHubTab}"
                        Click="HubMenuTab_Click"
                        MouseEnter="HubMenu_MouseEnter"
                        MouseLeave="HubMenu_MouseLeave">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Str Nav_Tools}" />
                            <Path Style="{StaticResource SteamDropTriangle}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup
                        x:Name="ToolsPopup"
                        AllowsTransparency="True"
                        HorizontalOffset="-10"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=ToolsTab}"
                        StaysOpen="True"
                        Closed="HubMenu_Closed">
                        <Border x:Name="ToolsPanel" Background="Transparent" MouseLeave="HubMenu_MouseLeave">
                            <Border Margin="10,0,10,10" MinWidth="220" Style="{StaticResource SteamYourItemsPanel}">
                                <StackPanel>
                                    <Button Style="{StaticResource SteamYourItemsEntry}" Content="{loc:Str Nav_Configs}" Tag="{x:Type views:ConfigsPage}" Click="HubMenuEntry_Click" />
                                    <Button Style="{StaticResource SteamYourItemsEntry}" Content="{loc:Str Nav_Dependencies}" Tag="{x:Type views:DependenciesPage}" Click="HubMenuEntry_Click" />
                                    <!-- Each only while switched on in Options - see FootprintGate and ServerMapGateViewModel. -->
                                    <Button
                                        Style="{StaticResource SteamYourItemsEntry}"
                                        Content="{loc:Str Nav_Footprint}"
                                        Tag="{x:Type views:FootprintPage}"
                                        Click="HubMenuEntry_Click"
                                        DataContext="{x:Static app:AppServices.FootprintGate}"
                                        Visibility="{Binding IsPageEnabled, Converter={StaticResource BoolToVis}}" />
                                    <Button
                                        Style="{StaticResource SteamYourItemsEntry}"
                                        Content="{loc:Str Nav_ServerMap}"
                                        Tag="{x:Type views:ServerMapPage}"
                                        Click="HubMenuEntry_Click"
                                        DataContext="{x:Static app:AppServices.ServerMap}"
                                        Visibility="{Binding IsPageEnabled, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </Popup>

                    <!-- The dot only appears when the Server Map mod is behind (caution) - on the tab,
                         and beside About in its menu, where it is said. -->
                    <ToggleButton
                        x:Name="HelpTab"
                        Style="{StaticResource SteamHubTab}"
                        Click="HubMenuTab_Click"
                        MouseEnter="HubMenu_MouseEnter"
                        MouseLeave="HubMenu_MouseLeave">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Str Nav_Help}" />
                            <ui:InfoBadge
                                Width="8"
                                Height="8"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                DataContext="{x:Static app:AppServices.AppUpdate}"
                                Severity="{Binding BadgeSeverity}"
                                Visibility="{Binding ShowUpdateBadge, Converter={StaticResource BoolToVis}}" />
                            <Path Style="{StaticResource SteamDropTriangle}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup
                        x:Name="HelpPopup"
                        AllowsTransparency="True"
                        HorizontalOffset="-10"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=HelpTab}"
                        StaysOpen="True"
                        Closed="HubMenu_Closed">
                        <Border x:Name="HelpPanel" Background="Transparent" MouseLeave="HubMenu_MouseLeave">
                            <Border Margin="10,0,10,10" MinWidth="180" Style="{StaticResource SteamYourItemsPanel}">
                                <StackPanel>
                                    <Button Style="{StaticResource SteamYourItemsEntry}" Content="{loc:Str Nav_Help}" Tag="{x:Type views:HelpPage}" Click="HubMenuEntry_Click" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Margin="0" Style="{StaticResource SteamYourItemsEntry}" Content="{loc:Str Nav_About}" Tag="{x:Type views:AppUpdatePage}" Click="HubMenuEntry_Click" />
                                        <ui:InfoBadge
                                            Width="8"
                                            Height="8"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            DataContext="{x:Static app:AppServices.AppUpdate}"
                                            Severity="{Binding BadgeSeverity}"
                                            Visibility="{Binding ShowUpdateBadge, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- The Workshop strip for Subscribed items and Collections. Home and Browse carry their own,
             under the banner inside their scrolling content, which is where Steam puts it. -->
        <views:WorkshopSubNav
            x:Name="WorkshopStrip"
            Grid.Row="3"
            Margin="24,16,24,0"
            Visibility="Collapsed" />

        <!--
            NavigationView still hosts every page - it owns the page cache (NavigationCacheMode) and
            the scroll wrapper each page opts in or out of - but its sidebar is gone: navigation is
            the hub tabs above. The template below is the minimum NavigationView's code asks for
            (the two menu ItemsControls and the content presenter; OnApplyTemplate throws without
            them), with the menus collapsed. The menu items stay declared because they are what
            maps each page type to its cache mode.
        -->
        <ui:NavigationView
            x:Name="RootNavigationView"
            Grid.Row="4"
            IsPaneOpen="False">
            <ui:NavigationView.Template>
                <ControlTemplate TargetType="ui:NavigationView">
                    <Grid>
                        <ItemsControl Focusable="False" x:Name="PART_MenuItemsItemsControl" Visibility="Collapsed" />
                        <ItemsControl Focusable="False" x:Name="PART_FooterMenuItemsItemsControl" Visibility="Collapsed" />
                        <ui:NavigationViewContentPresenter
                            x:Name="PART_NavigationViewContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            Transition="{TemplateBinding Transition}"
                            TransitionDuration="{TemplateBinding TransitionDuration}" />
                        <ContentPresenter Content="{TemplateBinding ContentOverlay}" />
                    </Grid>
                </ControlTemplate>
            </ui:NavigationView.Template>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:PlayPage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:WorkshopHomePage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:BrowsePage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:CollectionsBrowsePage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:InstalledPage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:ModListsPage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:YourCollectionsPage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:FollowedAuthorsPage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:FavoriteCollectionsPage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:ConfigsPage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:DependenciesPage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:FootprintPage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:ServerMapPage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:DownloadsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:AppUpdatePage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:HelpPage}" />
                <ui:NavigationViewItem NavigationCacheMode="Required" TargetPageType="{x:Type views:OptionsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Steam's downloads bar: what is downloading or installing now, and a way to Downloads. -->
        <views:DownloadsBar Grid.Row="5" />

        <!-- The Workshop item page, over the page area and under the hub header - on Steam an item
             page keeps the app hub's tabs above it. Collapsed until a mod is opened. -->
        <!-- A collection's Workshop page, the same way. One of these three is on screen at a time -
             see MainWindow.Cover. -->
        <views:WorkshopCollectionView
            x:Name="CollectionPage"
            Grid.Row="3"
            Grid.RowSpan="2"
            Visibility="Collapsed" />

        <!-- An author's Workshop page, the same way. -->
        <views:AuthorView
            x:Name="AuthorPage"
            Grid.Row="3"
            Grid.RowSpan="2"
            Visibility="Collapsed" />

        <views:WorkshopItemView
            x:Name="ItemPage"
            Grid.Row="3"
            Grid.RowSpan="2"
            Visibility="Collapsed" />

        <!-- Loading overlay shown during the first mod catalog fetch. The scrim stays a
             literal rather than a theme brush on purpose: its job is to dim whatever is
             behind it, which a translucent black does correctly in either theme. -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="6"
            Background="#AA000000"
            DataContext="{x:Static app:AppServices.ModCache}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ui:Card
                MinWidth="360"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ApplicationBackgroundBrush}">
                <StackPanel>
                    <TextBlock
                        Text="{loc:Str MainWindow_LoadingCatalog}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,4" />
                    <TextBlock
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Margin="0,0,0,12"
                        Text="{loc:Str MainWindow_LoadingCatalogNote}" />
                    <ProgressBar
                        Height="6"
                        Minimum="0"
                        Maximum="{Binding TotalCount}"
                        Value="{Binding LoadedCount, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding LoadedCount, StringFormat={loc:Str MainWindow_ModsLoadedFormat}}" />
                </StackPanel>
            </ui:Card>
        </Border>

        <!-- Steam's Quick View, over the pages and under the title bar; the update dialog and the
             picture viewer it can open go over it. -->
        <views:QuickViewOverlay
            x:Name="QuickView"
            Grid.Row="1"
            Grid.RowSpan="4"
            Visibility="Collapsed" />

        <!-- A collection's Quick View, the same way. -->
        <views:CollectionQuickViewOverlay
            x:Name="CollectionQuickView"
            Grid.Row="1"
            Grid.RowSpan="4"
            Visibility="Collapsed" />

        <!-- Host presenter for content dialogs, over everything but the picture viewer. -->
        <ContentPresenter
            x:Name="RootContentDialogPresenter"
            Grid.Row="0"
            Grid.RowSpan="6" />

        <!-- Full-size pictures and videos, over everything but the title bar - the update dialog
             too, since a picture in the changelog it shows opens here. -->
        <views:MediaViewerOverlay Grid.Row="1" Grid.RowSpan="4" />

        <!-- Steam's backdrop behind its modal dialogs: the page at 80% black while a SteamDialog is
             open over it. -->
        <Border
            x:Name="ModalDim"
            Grid.Row="0"
            Grid.RowSpan="6"
            Background="#CC000000"
            Visibility="Collapsed" />
    </Grid>
</ui:FluentWindow>
