<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The WebView2 package's API docs are for the IDE, not for the folder people run the app from. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!--
      The Windows 10 1809 TFM, not plain net9.0-windows, for the WinRT projection that update
      notifications' toasts go through (Microsoft.Toolkit.Uwp.Notifications). Measured 2026-09-27:
      +24.8 MB on the single-file exe, nearly all of it Microsoft.Windows.SDK.NET.dll, and the
      published host still reads CET-compat 0 with CetCompat=false below. 1809 is also the floor the
      toolkit's unpackaged-app activation needs.

      The output folder follows the TFM: bin\<config>\net9.0-windows10.0.17763.0\.
    -->
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TCFModManager.App</RootNamespace>
    <AssemblyName>SSPTMM</AssemblyName>
    <!-- The exe's file description: what Windows calls the app in the taskbar, Task Manager and its
         notification settings. -->
    <AssemblyTitle>Steamified SPT Mod Manager</AssemblyTitle>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <!--
      Trims size out of the self-contained single-file publish (SSPTMM-build-and-run.bat, the release script) by dropping
      non-English satellite resource assemblies WPF/WPF-UI/CommunityToolkit ship by default.

      It does NOT touch this app's own translations. The property filters satellites arriving from
      package references; the ones a project generates from its own EmbeddedResource items are
      built and published regardless - verified on 9.0.318, including a single-file publish, which
      is byte-for-byte the same size with and without it and carries the satellites inside the
      bundle either way. Leave it as it is.

      InvariantGlobalization was tried alongside this and reverted: WPF's XAML binding pipeline
      calls CultureInfo.GetCultureInfo("en-US") internally (XamlLanguage.GetSpecificCulture, hit on
      startup via any binding with Visibility/etc.), and invariant mode throws
      "Cannot find non-neutral culture related to 'en-us'" because it only supports the invariant
      culture, not a real one - confirmed by the crash on first launch after adding it. WPF apps
      can't use InvariantGlobalization; SatelliteResourceLanguages is unaffected by this and safe.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      Opts the published host (apphost/singlefilehost) out of Intel CET / "Hardware-enforced Stack
      Protection", which .NET 9 turns on by default (breaking change, .NET 9 Preview 6).

      With it on, the process is killed the instant the host tries to set thread context anywhere
      the shadow stack doesn't already allow - reported as exception 0xc0000602 in KERNELBASE.dll,
      with no window, no dialog and no Data\logs entry, because it happens before any of our
      managed code runs. Two things trigger it in the wild: older Windows 10 servicing levels with
      the known shadow-stack bug (GitHub issue #1 - Windows 10 20H2, KERNELBASE 10.0.19041.1706,
      i.e. May 2022), and anything that injects into every process and uses SetThreadContext -
      overlays like RTSS/Afterburner/Discord, some AV. Both are common on the machines this app is
      for, and neither is something a user can be expected to diagnose.

      The protection only ever applied on CET-capable hardware, and this app is a mod browser with
      no attack surface worth the trade. Remove this if the ecosystem catches up.
    -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Apache-2.0. Plays animated GIFs in descriptions frame by frame instead of decoding them whole. -->
    <PackageReference Include="XamlAnimatedGif" Version="2.3.2" />
    <!-- Microsoft's WebView2 SDK (BSD-style licence). The sp-mod.com comments, the in-app mod page and
         video playback; everything that uses it falls back to the browser when the runtime is absent. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon and the banner art are both made from the mascot (assets\ssptmm-mascot.png) by
         build\branding\make_branding.py - change the mascot there and run it, not these files. -->
    <Resource Include="Assets\AppIcon.ico" />

    <!-- The mascot, in the spot where Steam's Workshop banner shows the game's art. -->
    <Resource Include="Assets\WorkshopBanner.png" />

    <!-- Noto Sans, the next face in Steam's own font stack after Valve's licensed Motiva Sans.
         SIL Open Font License 1.1; the licence travels with the build next to the exe. -->
    <Resource Include="Themes\Fonts\*.ttf" />
    <None Include="Themes\Fonts\OFL.txt" Link="Licenses\NotoSans-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The licences of the libraries and runtime the exe carries, shipped beside it as they ask,
         with the list of what each file covers. -->
    <None Include="..\..\build\steam-ui\licenses\*.txt" Link="Licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="Licenses\THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- SSPTMM's own licence (MIT, with TCF Mod Manager's notice), beside the exe. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Generates the Strings accessor from Localization\Strings.resx before anything is compiled, so a
    C# call site reads Strings.Common_Rescan and the compiler catches a key that no longer exists.

    Hand-rolled rather than the SDK's own StronglyTypedFileName metadata, which cannot work in a WPF
    project: the SDK generates during PrepareResources, and PrepareResources depends on
    MarkupCompilePass1 - which builds a temporary project out of every C# file in this one. The
    accessor therefore does not exist yet the first time the code using it is compiled. Verified on
    9.0.318: the SDK route fails with "The name 'Strings' does not exist in the current context" in
    the _wpftmp project, whichever folder it is told to generate into.

    Both generated files are written with LF endings explicitly, because the rest of the repo is LF
    and a generator using the platform's newline writes CRLF on Windows and LF everywhere else. The
    file then flips every time it is regenerated on the other machine - 1,302 lines changed, none of
    them meaningfully - and shows up in git status after an ordinary build.

    Strings.Designer.cs is committed for a related reason. MSBuild settles which files it is
    compiling before any target runs, so a clone with nothing on disk fails its first build even
    though this target would have written the file a moment later. It is rewritten only when the
    resx changes, which means it appears in git status exactly when a key is added or removed.

    A translation needs nothing here: Strings.<tag>.resx is picked up by the SDK's own glob and
    compiled into a satellite assembly, which is what keeps adding a language a data change.
  -->
  <PropertyGroup>
    <StringsResx>$(MSBuildProjectDirectory)\Localization\Strings.resx</StringsResx>
    <StringsAccessor>$(MSBuildProjectDirectory)\Localization\Strings.Designer.cs</StringsAccessor>
  </PropertyGroup>

  <!--
    Writes Localization\Strings.Designer.cs from Strings.resx.

    An ordinary key becomes a property that reads it. A plural family - the keys sharing a base and
    ending _zero/_one/_two/_few/_many/_other - collapses into ONE method taking the count, so a call
    site never names a form and a language with four of them needs no call-site change. Both shapes
    are compile-checked, which a raw string key would not be.

    Hand-rolled rather than the SDK's StronglyTypedFileName because PrepareResources runs after
    MarkupCompilePass1, so the SDK's version does not exist yet when the XAML that uses it compiles.
  -->
  <UsingTask TaskName="WriteStringsAccessor" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var categories = new[] { "_zero", "_one", "_two", "_few", "_many", "_other" };

        var keys = XDocument.Load(Source).Root.Elements("data")
            .Select(d => (string)d.Attribute("name"))
            .Where(n => !string.IsNullOrEmpty(n))
            .ToList();

        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated>");
        sb.AppendLine("//     Generated from Localization\\Strings.resx by GenerateStringsAccessor in");
        sb.AppendLine("//     TCFModManager.App.csproj. Edits are overwritten by the next build.");
        sb.AppendLine("// </auto-generated>");
        sb.AppendLine("#nullable enable");
        sb.AppendLine("namespace TCFModManager.App.Localization;");
        sb.AppendLine("internal static class Strings");
        sb.AppendLine("{");
        sb.AppendLine("    internal static System.Resources.ResourceManager ResourceManager { get; } = new(");
        sb.AppendLine("        \"TCFModManager.App.Localization.Strings\", typeof(Strings).Assembly);");

        var families = new List<string>();

        foreach (var key in keys)
        {
            var suffix = categories.FirstOrDefault(c => key.EndsWith(c, StringComparison.Ordinal));

            if (suffix == null)
            {
                sb.AppendLine("    internal static string " + key + " => LocalizationService.Get(\"" + key + "\");");
                continue;
            }

            var family = key.Substring(0, key.Length - suffix.Length);
            if (families.Contains(family)) continue;

            families.Add(family);
            sb.AppendLine("    internal static string " + family + "(int count, params object?[] values) =>");
            sb.AppendLine("        LocalizationService.Plural(\"" + family + "\", count, values);");
        }

        sb.AppendLine("}");

        // AppendLine writes the platform's newline, and this file is committed.
        var text = sb.ToString().Replace("\r\n", "\n");

        if (!System.IO.File.Exists(Destination) || System.IO.File.ReadAllText(Destination) != text)
            System.IO.File.WriteAllText(Destination, text);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateStringsAccessor"
          BeforeTargets="MarkupCompilePass1;BeforeCompile"
          Inputs="$(StringsResx)"
          Outputs="$(StringsAccessor)">
    <WriteStringsAccessor Source="$(StringsResx)" Destination="$(StringsAccessor)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\TCFModManager.Core\TCFModManager.Core.csproj" />
  </ItemGroup>

  <!--
    How complete each shipped translation is, printed on every build.

    The failure mode of a volunteer translation is not the first translator, it is the release after
    them: forty keys are added, fifteen reworded, and the language is quietly 88% translated with
    nothing anywhere saying so. A missing key renders its English value, so nothing breaks and
    nothing complains - which is exactly why it has to be counted out loud.

    Nothing here fails a build. English is complete by construction and a release is never held up
    by a translation; a language that has fallen behind ships as a partly-English app, which is the
    resource fallback working as intended.

    Silent when there is nothing to say. Today the app ships English and the pseudo-locale, so this
    prints nothing at all - the neutral file is the baseline it would be measured against, and the
    pseudo-locale is generated from that same file every build and has its own test.
  -->
  <UsingTask TaskName="ReportLanguageCoverage" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Func<string, HashSet<string>> read = path => new HashSet<string>(
            XDocument.Load(path).Root.Elements("data")
                .Select(d => (string)d.Attribute("name"))
                .Where(n => !string.IsNullOrEmpty(n)),
            StringComparer.Ordinal);

        var categories = new[] { "_zero", "_one", "_two", "_few", "_many", "_other" };

        //
        // A plural family is ONE thing to translate, not one per form, and which forms a language
        // needs is a property of that language: English writes two, Russian three, Chinese one.
        // Counting raw key names reads Russian's _few and _many as junk and its absent _other as a
        // gap - 70 missing and 140 unused for a translation that is in fact complete.
        //
        Func<string, string> baseOf = key =>
        {
            foreach (var c in categories)
                if (key.EndsWith(c, StringComparison.Ordinal)) return key.Substring(0, key.Length - c.Length);
            return key;
        };

        Func<string, HashSet<string>> units = path => new HashSet<string>(read(path).Select(baseOf), StringComparer.Ordinal);

        var english = units(Source);

        // Which languages ship is answered by the neutral file alone, so a translation never holds
        // a copy of it and its absence is not a gap.
        english.Remove("Meta_ShippedLanguages");

        var folder = Path.GetDirectoryName(Source);

        foreach (var path in Directory.GetFiles(folder, "Strings.*.resx").OrderBy(p => p, StringComparer.Ordinal))
        {
            var tag = Path.GetFileNameWithoutExtension(path).Substring("Strings.".Length);

            // Generated from Strings.resx on every build, so counting it would only ever say 100%.
            if (tag == "qps-ploc") continue;

            var keys = read(path);
            var translated = new HashSet<string>(keys.Select(baseOf), StringComparer.Ordinal);

            var missing = english.Count(k => !translated.Contains(k));
            var dead = translated.Count(k => !english.Contains(k));

            //
            // A family with a single form is the mistake worth naming separately. A missing form is
            // worse than a missing key: Plural() falls back to _other and then to the base key,
            // neither of which a translation holds, so it renders the key name rather than English.
            //
            var lonely = keys.Where(k => baseOf(k) != k)
                .GroupBy(baseOf)
                .Count(g => g.Count() == 1);

            var line = tag + ": " + (english.Count - missing) + "/" + english.Count;
            if (missing > 0) line += ", " + missing + " missing";
            if (dead > 0) line += ", " + dead + " no longer used";
            if (missing == 0 && dead == 0) line += ", complete";
            if (lonely > 0) line += " (" + lonely + " plural families have only one form)";

            Log.LogMessage(MessageImportance.High, line);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ReportLanguageCoverage" AfterTargets="Build">
    <ReportLanguageCoverage Source="$(StringsResx)" />
  </Target>

  <!--
    The pseudo-locale. Generated on demand, never on an ordinary build:

        dotnet build src\TCFModManager.App -p:PseudoLocale=true

    Every English value comes back accented, padded and wrapped in brackets, so running the app in
    it answers three questions at once with nobody translating anything: a string still in plain
    English was missed by the sweep, a missing closing bracket is a control too narrow for a longer
    language, and a date or a number that does not move is a culture assumption.

    Strings.qps-ploc.resx is removed from the default glob and added back only under that property,
    so a copy left lying around from a test run cannot reach a release build - verified: a normal
    build after a pseudo one deletes the satellite again, and a self-contained single-file publish
    carries none of it. It is gitignored as well.

    The target has to run before AssignTargetPaths. Resources are split by culture before
    PrepareResources, so an item added any later is written but never becomes a satellite.
  -->
  <ItemGroup>
    <EmbeddedResource Remove="Localization\Strings.qps-ploc.resx" />
  </ItemGroup>

  <UsingTask TaskName="WritePseudoLocale" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        const string Plain = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const string Fancy = "\u00e0\u0180\u00e7\u00f0\u00e9\u0192\u011d\u0125\u0129\u0135\u0137\u0142\u0271\u00f1\u0151\u01a5\u024b\u0155\u0161\u0163\u0169\u1e7d\u0175\u1e8b\u00fd\u017e"
                           + "\u00c0\u0181\u00c7\u00d0\u00c9\u0191\u011c\u0124\u0128\u0134\u0136\u0141\u1e42\u00d1\u0150\u01a4\u024a\u0154\u0160\u0162\u0168\u1e7c\u0174\u1e8a\u00dd\u017d";

        var doc = XDocument.Load(Source);

        foreach (var data in doc.Root.Elements("data").ToList())
        {
            var name = (string)data.Attribute("name");
            var valueElement = data.Element("value");
            if (name == null || valueElement == null) continue;

            // Translator notes are for translators. Nobody translates this file.
            foreach (var comment in data.Elements("comment").ToList()) comment.Remove();

            if (name == "Meta_LanguageName") { valueElement.Value = "Pseudo (qps-ploc)"; continue; }

            // Which languages ship is read from the neutral file by design, so a copy here would
            // only be a second answer to the same question. Every other Meta_ key is ordinary text
            // and is mangled with the rest - the translation credit included, which is how a pseudo
            // build shows that the credit line under the dropdown appears at all.
            if (name == "Meta_ShippedLanguages") { data.Remove(); continue; }

            var source = valueElement.Value;
            var builder = new StringBuilder(source.Length * 2);
            builder.Append('[');

            var inPlaceholder = false;
            foreach (var c in source)
            {
                if (c == '{') inPlaceholder = true;
                if (c == '}') { inPlaceholder = false; builder.Append(c); continue; }

                // A placeholder is machinery, not words - accenting {0:N0} would break the format
                // and take the thousands separator with it.
                if (inPlaceholder) { builder.Append(c); continue; }

                var index = Plain.IndexOf(c);
                builder.Append(index < 0 ? c : Fancy[index]);
            }

            // Roughly what German and Russian add. A control sized to fit English and nothing more
            // loses its closing bracket here rather than in somebody's bug report.
            builder.Append(' ').Append(new string('\u2014', Math.Max(3, source.Length * 2 / 5))).Append(']');

            valueElement.Value = builder.ToString();
        }

        // Same reason as the accessor: LF whatever platform generated it. This file is gitignored,
        // but it is compared against Strings.resx by a test and by hand often enough that it should
        // not differ from itself between machines either.
        var settings = new System.Xml.XmlWriterSettings();
        settings.Indent = true;
        settings.NewLineChars = "\n";
        settings.Encoding = new System.Text.UTF8Encoding(false);

        using (var writer = System.Xml.XmlWriter.Create(Destination, settings)) doc.Save(writer);

        Log.LogMessage(MessageImportance.High, "Pseudo-locale written to " + Destination);
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Written on EVERY build, embedded only under the property.

    Generating it always is what keeps it honest: the file is a pure function of Strings.resx, so a
    build regenerates it the moment a key is added, and D7's test can assert it has a form for every
    key without anyone having had to remember the flag. Embedding is the part that must stay behind
    the flag, because a shipped pseudo-locale would show up in the Options dropdown.
  -->
  <Target Name="GeneratePseudoLocale"
          BeforeTargets="AssignTargetPaths"
          Inputs="$(StringsResx)"
          Outputs="$(MSBuildProjectDirectory)\Localization\Strings.qps-ploc.resx">
    <WritePseudoLocale Source="$(StringsResx)" Destination="$(MSBuildProjectDirectory)\Localization\Strings.qps-ploc.resx" />
  </Target>

  <Target Name="EmbedPseudoLocale" BeforeTargets="AssignTargetPaths" DependsOnTargets="GeneratePseudoLocale" Condition="'$(PseudoLocale)' == 'true'">
    <ItemGroup>
      <EmbeddedResource Include="$(MSBuildProjectDirectory)\Localization\Strings.qps-ploc.resx" />
    </ItemGroup>
  </Target>

  <!--
    A build without the property takes the pseudo-locale back out of the output.

    Without this it simply stays where the last pseudo build left it, and the app runs against
    whatever text that build had: every key added since falls back to English, which looks exactly
    like a half-keyed app rather than a stale one. That cost a round of screenshots on 2026-09-21.
  -->
  <Target Name="RemovePseudoLocaleSatellite" AfterTargets="Build" Condition="'$(PseudoLocale)' != 'true'">
    <RemoveDir Directories="$(OutDir)qps-ploc" ContinueOnError="true" />
  </Target>

</Project>
