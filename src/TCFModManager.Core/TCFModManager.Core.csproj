<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>TCFModManager.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <!-- MIT. Reads the HTML sp-mod.com renders its markdown to - see Markup/SpModMarkup.cs. -->
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
    <!-- MIT. Applies SPT's game patches (SPT_Data\Launcher\Patches\*.delta, HDiffPatch) for
         starting the game without SPT's launcher - the same library and version that launcher
         uses (SptDirectLaunch). Brings ZstdSharp.Port (MIT) and Hi3Helper.ZstdNet (BSD-3). -->
    <PackageReference Include="SharpHDiffPatch.Core" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      So ServerMapClient can expose a handler-injecting factory to tests without making it part of
      the public surface, where it would be a way to turn certificate pinning off.
    -->
    <InternalsVisibleTo Include="TCFModManager.Core.Tests" />
  </ItemGroup>

</Project>
